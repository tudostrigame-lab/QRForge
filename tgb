function nexusCreateChat(
  title = "Новый чат"
): NexusChat {
  const timestamp = nexusDate();

  return {
    id: nexusId("chat"),
    title:
      title.trim() || "Новый чат",
    messages: [],
    createdAt: timestamp,
    updatedAt: timestamp,
  };
}

function nexusCreateMessage(
  role: NexusRole,
  content: string
): NexusMessage {
  return {
    id: nexusId("message"),
    role,
    content: content.trim(),
    createdAt: nexusDate(),
  };
}

function nexusGenerateChatTitle(
  text: string
): string {
  const clean =
    text.trim().replace(
      /\s+/g,
      " "
    );

  if (!clean) {
    return "Новый чат";
  }

  const words =
    clean.split(" ");

  const title =
    words
      .slice(0, 7)
      .join(" ");

  return title.length > 45
    ? `${title.slice(0, 45)}…`
    : title;
}

function nexusAddMessageToChat(
  chats: NexusChat[],
  chatId: string,
  message: NexusMessage
): NexusChat[] {
  return chats.map(
    (chat) => {
      if (chat.id !== chatId) {
        return chat;
      }

      const messages = [
        ...chat.messages,
        message,
      ];

      return {
        ...chat,
        messages:
          nexusLimitArray(
            messages,
            NEXUS_DATA_LIMITS
              .messagesPerChat
          ),
        updatedAt:
          message.createdAt,
      };
    }
  );
}

function nexusRenameChat(
  chats: NexusChat[],
  chatId: string,
  title: string
): NexusChat[] {
  const clean =
    title.trim();

  if (!clean) {
    return chats;
  }

  return chats.map(
    (chat) =>
      chat.id === chatId
        ? {
            ...chat,
            title:
              clean.slice(
                0,
                80
              ),
            updatedAt:
              nexusDate(),
          }
        : chat
  );
}

function nexusDeleteChat(
  chats: NexusChat[],
  chatId: string
): NexusChat[] {
  return chats.filter(
    (chat) =>
      chat.id !== chatId
  );
}

function nexusClearChat(
  chats: NexusChat[],
  chatId: string
): NexusChat[] {
  return chats.map(
    (chat) =>
      chat.id === chatId
        ? {
            ...chat,
            messages: [],
            updatedAt:
              nexusDate(),
          }
        : chat
  );
}

function nexusDuplicateChat(
  chats: NexusChat[],
  chatId: string
): NexusChat[] {
  const source =
    chats.find(
      (chat) =>
        chat.id === chatId
    );

  if (!source) {
    return chats;
  }

  const copy: NexusChat = {
    ...nexusClone(source),
    id: nexusId("chat"),
    title:
      `${source.title} (копия)`,
    createdAt:
      nexusDate(),
    updatedAt:
      nexusDate(),
    messages:
      source.messages.map(
        (message) => ({
          ...message,
          id: nexusId(
            "message"
          ),
        })
      ),
  };

  return [
    copy,
    ...chats,
  ];
}

function nexusGetChatById(
  chats: NexusChat[],
  chatId: string
): NexusChat | null {
  return (
    chats.find(
      (chat) =>
        chat.id === chatId
    ) || null
  );
}

function nexusGetLastMessage(
  chat: NexusChat
): NexusMessage | null {
  if (
    chat.messages.length ===
    0
  ) {
    return null;
  }

  return (
    chat.messages[
      chat.messages.length - 1
    ] || null
  );
}

function nexusGetLastUserMessage(
  chat: NexusChat
): NexusMessage | null {
  for (
    let index =
      chat.messages.length - 1;
    index >= 0;
    index--
  ) {
    if (
      chat.messages[index]
        .role === "user"
    ) {
      return chat.messages[index];
    }
  }

  return null;
}

function nexusGetLastAssistantMessage(
  chat: NexusChat
): NexusMessage | null {
  for (
    let index =
      chat.messages.length - 1;
    index >= 0;
    index--
  ) {
    if (
      chat.messages[index]
        .role === "assistant"
    ) {
      return chat.messages[index];
    }
  }

  return null;
}

function nexusGetConversationStats(
  chat: NexusChat | null
): NexusConversationStats {
  if (!chat) {
    return {
      messages: 0,
      userMessages: 0,
      assistantMessages: 0,
      characters: 0,
      createdAt: null,
      updatedAt: null,
    };
  }

  let userMessages = 0;
  let assistantMessages = 0;
  let characters = 0;

  for (const message of chat.messages) {
    characters +=
      message.content.length;

    if (
      message.role === "user"
    ) {
      userMessages++;
    } else {
      assistantMessages++;
    }
  }

  return {
    messages:
      chat.messages.length,
    userMessages,
    assistantMessages,
    characters,
    createdAt:
      chat.createdAt,
    updatedAt:
      chat.updatedAt,
  };
}

function nexusSearchMessages(
  chats: NexusChat[],
  query: string
): NexusMessageSearchResult[] {
  const cleanQuery =
    nexusSearchText(query);

  if (!cleanQuery) {
    return [];
  }

  const results:
    NexusMessageSearchResult[] =
    [];

  for (const chat of chats) {
    for (const message of chat.messages) {
      if (
        nexusContains(
          message.content,
          cleanQuery
        )
      ) {
        results.push({
          chatId: chat.id,
          chatTitle: chat.title,
          message,
        });
      }
    }
  }

  return results;
}

function nexusGetRecentMessages(
  chat: NexusChat | null,
  limit = 20
): NexusMessage[] {
  if (!chat) {
    return [];
  }

  const safeLimit =
    Math.max(
      1,
      Math.min(
        limit,
        NEXUS_DATA_LIMITS
          .messagesPerChat
      )
    );

  return chat.messages.slice(
    -safeLimit
  );
}

function nexusFormatMessagesForAI(
  messages: NexusMessage[]
): string {
  return messages
    .map(
      (message) =>
        `${message.role}: ${message.content}`
    )
    .join("\n");
}

function nexusBuildConversationContext(
  chat: NexusChat | null,
  limit = 20
): {
  chatId: string | null;
  title: string;
  messages: NexusMessage[];
  text: string;
} {
  const messages =
    nexusGetRecentMessages(
      chat,
      limit
    );

  return {
    chatId:
      chat?.id || null,
    title:
      chat?.title ||
      "Новый чат",
    messages,
    text:
      nexusFormatMessagesForAI(
        messages
      ),
  };
}

function nexusShouldGenerateTitle(
  chat: NexusChat
): boolean {
  return (
    chat.title ===
      "Новый чат" &&
    chat.messages.filter(
      (message) =>
        message.role === "user"
    ).length === 1
  );
}

function nexusPrepareUserMessage(
  content: string
): NexusMessage | null {
  const clean =
    content.trim();

  if (!clean) {
    return null;
  }

  return nexusCreateMessage(
    "user",
    clean
  );
}

function nexusPrepareAssistantMessage(
  content: string
): NexusMessage | null {
  const clean =
    content.trim();

  if (!clean) {
    return null;
  }

  return nexusCreateMessage(
    "assistant",
    clean
  );
}

function nexusAddUserMessage(
  chats: NexusChat[],
  chatId: string,
  content: string
): NexusChat[] {
  const message =
    nexusPrepareUserMessage(
      content
    );

  if (!message) {
    return chats;
  }

  const updated =
    nexusAddMessageToChat(
      chats,
      chatId,
      message
    );

  return updated.map(
    (chat) => {
      if (
        chat.id === chatId &&
        nexusShouldGenerateTitle(
          chat
        )
      ) {
        return {
          ...chat,
          title:
            nexusGenerateChatTitle(
              content
            ),
        };
      }

      return chat;
    }
  );
}

function nexusAddAssistantMessage(
  chats: NexusChat[],
  chatId: string,
  content: string
): NexusChat[] {
  const message =
    nexusPrepareAssistantMessage(
      content
    );

  if (!message) {
    return chats;
  }

  return nexusAddMessageToChat(
    chats,
    chatId,
    message
  );
}

function nexusCreateChatWithMessage(
  content: string
): NexusChat {
  const chat =
    nexusCreateChat(
      nexusGenerateChatTitle(
        content
      )
    );

  const message =
    nexusPrepareUserMessage(
      content
    );

  if (!message) {
    return chat;
  }

  return {
    ...chat,
    messages: [message],
    updatedAt:
      message.createdAt,
  };
}

function nexusSortChats(
  chats: NexusChat[]
): NexusChat[] {
  return [...chats].sort(
    (a, b) =>
      new Date(
        b.updatedAt
      ).getTime() -
      new Date(
        a.updatedAt
      ).getTime()
  );
}

function nexusGetChatPreview(
  chat: NexusChat
): string {
  const message =
    nexusGetLastMessage(
      chat
    );

  if (!message) {
    return "Пустой чат";
  }

  const text =
    message.content
      .replace(
        /\s+/g,
        " "
      )
      .trim();

  if (text.length <= 90) {
    return text;
  }

  return `${text.slice(
    0,
    90
  )}…`;
}

