function nexusBuildAIContext(
  data: {
    message: string;
    chat: NexusChat | null;
    memory: NexusMemoryItem[];
    notes: NexusNote[];
    tasks: NexusTask[];
    events: NexusCalendarEvent[];
    timers: NexusTimer[];
    files: NexusFile[];
    settings: NexusSettings;
    currentDate?: Date;
  },
  options?: NexusAIContextOptions
): NexusAIContext {
  const limits =
    nexusGetContextOptions(
      options
    );

  const currentDate =
    data.currentDate ||
    new Date();

  const messages =
    nexusGetRecentMessages(
      data.chat,
      limits.messageLimit
    );

  const memoryItems =
    data.settings.memoryEnabled
      ? nexusGetRecentMemories(
          data.memory,
          limits.memoryLimit
        )
      : [];

  const recentNotes =
    nexusGetRecentNotes(
      data.notes,
      limits.notesLimit
    );

  const recentTasks =
    nexusGetRecentTasks(
      data.tasks,
      limits.tasksLimit
    );

  const recentEvents =
    nexusGetRecentEvents(
      data.events,
      limits.eventsLimit
    );

  const recentTimers =
    nexusGetRecentTimers(
      data.timers,
      limits.timersLimit
    );

  const recentFiles =
    nexusGetRecentFiles(
      data.files,
      limits.filesLimit
    );

  return {
    version:
      NEXUS_VERSION,

    current: {
      date:
        nexusDateKey(
          currentDate
        ),
      time:
        nexusTime(
          currentDate
        ),
      timestamp:
        currentDate.toISOString(),
    },

    application: {
      name: "NEXUS",
      language:
        data.settings.language,
    },

    conversation: {
      chatId:
        data.chat?.id || null,

      title:
        data.chat?.title ||
        "Новый чат",

      messages,
    },

    memory: {
      enabled:
        data.settings
          .memoryEnabled,

      items:
        memoryItems,
    },

    notes:
      recentNotes,

    tasks:
      recentTasks,

    calendar:
      recentEvents,

    timers:
      recentTimers,

    files:
      recentFiles,
  };
}

