type NexusResponseMode =
  | "direct"
  | "contextual"
  | "action"
  | "clarification"
  | "fallback";

type NexusResponseProfile = {
  mode: NexusResponseMode;
  language: string;
  concise: boolean;
  useContext: boolean;
  useMemory: boolean;
};

type NexusResponseResult = {
  text: string;
  mode: NexusResponseMode;
  intent: NexusIntent;
  action?: NexusAction;
};

type NexusConversationContext = {
  currentMessage: string;
  previousMessages: NexusMessage[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  files: NexusFile[];
  settings?: NexusSettings;
};

const nexusDetectLanguage = (
  text: string
): string => {
  const value =
    text.toLowerCase();

  const spanish =
    /[áéíóúñ¿¡]/i.test(text) ||
    /\b(hola|gracias|quiero|puedo|como|para|qué|que|donde|dónde)\b/i.test(
      value
    );

  const french =
    /[àâçéèêëîïôûùüÿœ]/i.test(text) ||
    /\b(bonjour|merci|avec|pour|quoi|comment|je|vous)\b/i.test(
      value
    );

  const japanese =
    /[\u3040-\u30ff\u3400-\u9fff]/.test(
      text
    );

  if (japanese) {
    return "ja";
  }

  if (spanish) {
    return "es";
  }

  if (french) {
    return "fr";
  }

  return "ru";
};

const nexusResponseProfile = (
  text: string,
  settings?: NexusSettings
): NexusResponseProfile => {
  const language =
    settings?.language ||
    nexusDetectLanguage(text);

  return {
    mode: "direct",
    language,
    concise: text.length < 120,
    useContext: true,
    useMemory: true,
  };
};

const nexusConversationLastMessage = (
  messages: NexusMessage[]
): NexusMessage | null => {
  if (messages.length === 0) {
    return null;
  }

  return messages[messages.length - 1];
};

const nexusConversationRecent = (
  messages: NexusMessage[],
  limit = 12
): NexusMessage[] => {
  return messages
    .slice(-Math.max(1, limit))
    .map((message) => ({
      ...message,
    }));
};

const nexusConversationTopic = (
  messages: NexusMessage[]
): string => {
  const recent =
    nexusConversationRecent(
      messages,
      6
    );

  if (recent.length === 0) {
    return "";
  }

  const words =
    recent
      .map(
        (message) =>
          message.content
      )
      .join(" ")
      .split(/\s+/)
      .map((word) =>
        word
          .toLowerCase()
          .replace(
            /[^a-zа-яё0-9]/gi,
            ""
          )
      )
      .filter(
        (word) =>
          word.length >= 5
      );

  const counts =
    new Map<string, number>();

  for (const word of words) {
    counts.set(
      word,
      (counts.get(word) || 0) + 1
    );
  }

  return (
    [...counts.entries()]
      .sort(
        (a, b) =>
          b[1] - a[1]
      )[0]?.[0] || ""
  );
};

const nexusConversationContext = (
  context: NexusConversationContext
): NexusAIContext => {
  return nexusAIContextBuild(
    context.currentMessage,
    {
      messages:
        context.previousMessages,
      memory:
        context.memory,
      notes:
        context.notes,
      tasks:
        context.tasks,
      events:
        context.events,
      timers:
        context.timers,
      files:
        context.files,
      settings:
        context.settings,
    }
  );
};

