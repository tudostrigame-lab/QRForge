      return "メモリーから必要な情報を検索できます。";
    }

    return "Я могу найти нужную информацию в памяти.";
  }

  return null;
};

const nexusResponseNeedsClarification = (
  intent: NexusIntent
): boolean => {
  if (
    intent.type === "remember" ||
    intent.type === "forget"
  ) {
    return (
      !intent.parameters.content ||
      intent.parameters.content.trim()
        .length === 0
    );
  }

  if (
    intent.type === "note_create" ||
    intent.type === "task_create" ||
    intent.type === "calendar_create"
  ) {
    return (
      !intent.parameters.title &&
      !intent.parameters.content
    );
  }

  if (
    intent.type === "timer_create"
  ) {
    const minutes =
      Number(
        intent.parameters.minutes || 0
      );

    const seconds =
      Number(
        intent.parameters.seconds || 0
      );

    return (
      minutes <= 0 &&
      seconds <= 0
    );
  }

  return false;
};

const nexusResponseClarification = (
