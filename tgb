const nexusExecuteAction = (
  action: NexusAction,
  context: NexusActionExecutionContext
): NexusActionExecutionResult => {
  if (
    !nexusIntentCanExecute(
      action.intent
    )
  ) {
    const ignored =
      nexusActionIgnored(
        action,
        "Уверенность NEXUS в команде слишком низкая."
      );

    nexusSaveActionHistory(
      ignored
    );

    return {
      ok: false,
      action: ignored,
      message:
        "Уверенность NEXUS в команде слишком низкая.",
    };
  }

  if (
    nexusIntentNeedsConfirmation(
      action.intent.type
    )
  ) {
    const confirmation =
      nexusActionIgnored(
        action,
        "Действие требует подтверждения пользователя."
      );

    nexusSaveActionHistory(
      confirmation
    );

    return {
      ok: false,
      action: confirmation,
      message:
        "Действие требует подтверждения пользователя.",
    };
  }

  const handler =
    NEXUS_ACTION_HANDLERS[
      action.intent.type
    ];

  if (!handler) {
    const failed =
      nexusActionFailed(
        action,
        "Для этой команды ещё нет обработчика."
      );

    nexusSaveActionHistory(
      failed
    );

    return {
      ok: false,
      action: failed,
      message:
        "Для этой команды ещё нет обработчика.",
    };
  }

  try {
    const result =
      handler(
        action,
        context
      );

    nexusSaveActionHistory(
      result.action
    );

    return result;
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Ошибка выполнения действия.";

    const failed =
      nexusActionFailed(
        action,
        message
      );

    nexusSaveActionHistory(
      failed
    );

    return {
      ok: false,
      action: failed,
      message,
    };
  }
};

