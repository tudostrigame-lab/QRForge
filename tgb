type NexusMemoryOperation =
  | "add"
  | "update"
  | "delete"
  | "clear";

type NexusMemoryEvent = {
  id: string;
  operation: NexusMemoryOperation;
  memoryId: string | null;
  timestamp: string;
};

type NexusMemoryStats = {
  total: number;
  facts: number;
  preferences: number;
  goals: number;
  projects: number;
  important: number;
};

type NexusMemorySearchResult = {
  item: NexusMemoryItem;
  score: number;
};

function nexusCreateMemory(
  text: string,
  category: NexusMemoryCategory = "fact"
): NexusMemoryItem {
  const timestamp = nexusDate();

  return {
    id: nexusId("memory"),
    text: text.trim(),
    category,
    createdAt: timestamp,
    updatedAt: timestamp,
  };
}

function nexusNormalizeMemoryText(
  text: string
): string {
  return text
    .trim()
    .replace(/\s+/g, " ");
}

function nexusMemoryKey(
  text: string
): string {
  return nexusNormalizeMemoryText(
    text
  ).toLowerCase();
}

function nexusMemoryExists(
  memory: NexusMemoryItem[],
  text: string
): boolean {
  const key =
    nexusMemoryKey(text);

  return memory.some(
    (item) =>
      nexusMemoryKey(
        item.text
      ) === key
  );
}

function nexusAddMemory(
  memory: NexusMemoryItem[],
  text: string,
  category: NexusMemoryCategory = "fact"
): NexusMemoryItem[] {
  const clean =
    nexusNormalizeMemoryText(
      text
    );

  if (!clean) {
    return memory;
  }

  if (
    nexusMemoryExists(
      memory,
      clean
    )
  ) {
    return memory;
  }

  const item =
    nexusCreateMemory(
      clean,
      category
    );

  return [
    ...memory,
    item,
  ].slice(
    -NEXUS_DATA_LIMITS.memory
  );
}

function nexusUpdateMemory(
  memory: NexusMemoryItem[],
  memoryId: string,
  text: string,
  category?: NexusMemoryCategory
): NexusMemoryItem[] {
  const clean =
    nexusNormalizeMemoryText(
      text
    );

  if (!clean) {
    return memory;
  }

  return memory.map(
    (item) =>
      item.id === memoryId
        ? {
            ...item,
            text: clean,
            category:
              category ||
              item.category,
            updatedAt:
              nexusDate(),
          }
        : item
  );
}

function nexusDeleteMemory(
  memory: NexusMemoryItem[],
  memoryId: string
): NexusMemoryItem[] {
  return memory.filter(
    (item) =>
      item.id !== memoryId
  );
}

function nexusClearMemory(
  memory: NexusMemoryItem[]
): NexusMemoryItem[] {
  return memory.length === 0
    ? memory
    : [];
}

function nexusGetMemory(
