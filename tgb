type NexusCommandType =
  | "remember"
  | "forget"
  | "note"
  | "task"
  | "calendar"
  | "timer"
  | "file"
  | "memory"
  | "help"
  | "chat";

type NexusParsedCommand = {
  type: NexusCommandType;
  raw: string;
  value: string;
  title: string;
  date: string;
  time: string;
  minutes: number;
  seconds: number;
  confidence: number;
};

const nexusCommandEmpty = (
  raw: string
): NexusParsedCommand => ({
  type: "chat",
  raw,
  value: "",
  title: "",
  date: "",
  time: "",
  minutes: 0,
  seconds: 0,
  confidence: 0,
});

const nexusCommandClean = (
  value: string
): string => {
  return value
    .replace(/\s+/g, " ")
    .trim();
};

const nexusCommandExtractAfter = (
  text: string,
  patterns: RegExp[]
): string => {
  for (const pattern of patterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      return nexusCommandClean(
        match[1]
      );
    }
  }

  return "";
};

const nexusCommandParseDuration = (
  text: string
): {
  minutes: number;
  seconds: number;
} => {
  const normalized =
    nexusCommandClean(
      text.toLowerCase()
    );

  let minutes = 0;
  let seconds = 0;

  const minuteMatch =
    normalized.match(
      /(\d+)\s*(?:минут(?:а|ы)?|мин\.?|m|minutes?|min)/
    );

  const secondMatch =
    normalized.match(
      /(\d+)\s*(?:секунд(?:а|ы)?|сек\.?|s|seconds?|sec)/
    );

  if (minuteMatch?.[1]) {
    minutes =
      Number(minuteMatch[1]);
  }

  if (secondMatch?.[1]) {
    seconds =
      Number(secondMatch[1]);
  }

  if (
    minutes === 0 &&
    seconds === 0
  ) {
    const number =
      normalized.match(
        /\b(\d+)\b/
      );

    if (number?.[1]) {
      minutes =
        Number(number[1]);
    }
  }

  return {
    minutes,
    seconds,
  };
};

const nexusCommandExtractTime = (
  text: string
): string => {
  const match =
    text.match(
      /\b([01]?\d|2[0-3])[:.][0-5]\d\b/
    );

  if (!match) {
    return "";
  }

  return match[0]
    .replace(".", ":")
    .padStart(5, "0");
};

const nexusCommandExtractDate = (
  text: string
): string => {
  const direct =
    text.match(
      /\b(20\d{2})[-/.](\d{1,2})[-/.](\d{1,2})\b/
    );

  if (direct) {
    return `${direct[1]}-${direct[2].padStart(
      2,
      "0"
    )}-${direct[3].padStart(2, "0")}`;
  }

  const short =
    text.match(
      /\b(\d{1,2})[-/.](\d{1,2})\b/
    );

  if (short) {
    const year =
      new Date().getFullYear();

    return `${year}-${short[2].padStart(
      2,
      "0"
    )}-${short[1].padStart(2, "0")}`;
  }

  const today =
    new Date();

  const lower =
    text.toLowerCase();

  if (
    lower.includes("сегодня") ||
    lower.includes("today")
  ) {
    return nexusDateKey(today);
  }

  if (
    lower.includes("завтра") ||
    lower.includes("tomorrow")
  ) {
    const tomorrow =
      new Date(today);

    tomorrow.setDate(
      tomorrow.getDate() + 1
    );

    return nexusDateKey(
      tomorrow
    );
  }

  return "";
};

