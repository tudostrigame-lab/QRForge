const nexusResponseForIntent = (
  intent: NexusIntent,
  language: string
): string | null => {
  if (
    intent.type === "help"
  ) {
    return nexusResponseHelp(
      language
    );
  }

  if (
    intent.type === "memory_search"
  ) {
    if (language === "es") {
      return "Puedo buscar нужную информацию в памяти.";
    }

    if (language === "fr") {
      return "Je peux rechercher les informations dans ma mémoire.";
    }

