function nexusDetectMemoryCategory(
  text: string
): NexusMemoryCategory {
  const value =
    text.toLowerCase();

  if (
    value.includes(
      "нравится"
    ) ||
    value.includes(
      "люблю"
    ) ||
    value.includes(
      "предпочитаю"
    ) ||
    value.includes(
      "не люблю"
    ) ||
    value.includes(
      "хочу чтобы"
    )
  ) {
    return "preference";
  }

  if (
    value.includes(
      "моя цель"
    ) ||
    value.includes(
      "цель:"
    ) ||
    value.includes(
      "хочу достичь"
    ) ||
    value.includes(
      "планирую"
    )
  ) {
    return "goal";
  }

  if (
    value.includes(
      "проект"
    ) ||
    value.includes(
      "разрабатываю"
    ) ||
    value.includes(
      "разработка"
    ) ||
    value.includes(
      "бот"
    )
  ) {
    return "project";
  }

  if (
    value.includes(
      "важно"
    ) ||
    value.includes(
      "запомни обязательно"
    ) ||
    value.includes(
      "не забудь"
    )
  ) {
    return "important";
  }

  return "fact";
}

function nexusExtractMemoryCandidate(
  message: string
): {
  text: string;
  category: NexusMemoryCategory;
} | null {
  const clean =
    message.trim();

  if (!clean) {
    return null;
  }

  const patterns = [
    /^запомни\s*[:\-]?\s*(.+)$/i,
    /^запомни,\s*(.+)$/i,
    /^помни\s*[:\-]?\s*(.+)$/i,
    /^запиши в память\s*[:\-]?\s*(.+)$/i,
    /^remember\s*[:\-]?\s*(.+)$/i,
  ];

  for (const pattern of patterns) {
    const match =
      clean.match(pattern);

    if (match?.[1]) {
      const text =
        nexusNormalizeMemoryText(
          match[1]
        );

      return {
        text,
        category:
          nexusDetectMemoryCategory(
            text
          ),
      };
    }
  }

  return null;
}

function nexusDetectAutomaticMemory(
  message: string
): {
  text: string;
  category: NexusMemoryCategory;
} | null {
  const clean =
    nexusNormalizeMemoryText(
      message
    );

  if (!clean) {
    return null;
  }

  const patterns = [
    /^я люблю (.+)$/i,
    /^мне нравится (.+)$/i,
    /^я предпочитаю (.+)$/i,
    /^моя цель\s*[:\-]?\s*(.+)$/i,
    /^я планирую\s+(.+)$/i,
    /^мой проект\s*[:\-]?\s*(.+)$/i,
  ];

  for (const pattern of patterns) {
    const match =
      clean.match(pattern);

    if (!match?.[1]) {
      continue;
    }

    const text =
      clean;

    return {
      text,
      category:
        nexusDetectMemoryCategory(
          text
        ),
    };
  }

  return null;
}

function nexusProcessMemoryCommand(
  memory: NexusMemoryItem[],
  message: string
): {
  memory: NexusMemoryItem[];
  handled: boolean;
  response: string | null;
} {
  const candidate =
    nexusExtractMemoryCandidate(
      message
    );

  if (!candidate) {
    return {
      memory,
      handled: false,
      response: null,
    };
  }

  if (
    nexusMemoryExists(
      memory,
      candidate.text
    )
  ) {
    return {
      memory,
      handled: true,
      response:
        "Я уже помнил это.",
    };
  }

  const updated =
    nexusAddMemory(
      memory,
      candidate.text,
      candidate.category
    );

  return {
    memory: updated,
    handled: true,
    response:
      "Запомнил. Я буду учитывать это в следующих разговорах.",
  };
}

function nexusForgetMemoryByText(
  memory: NexusMemoryItem[],
  query: string
): NexusMemoryItem[] {
  const normalized =
    nexusMemoryKey(query);

  if (!normalized) {
    return memory;
  }

  return memory.filter(
    (item) =>
      !nexusMemoryKey(
        item.text
      ).includes(normalized)
  );
}

