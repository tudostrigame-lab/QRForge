const nexusIntentNormalize = (
  text: string
): string => {
  return text
    .toLowerCase()
    .replace(/[!?.,;:()[\]{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
};

const nexusIntentContains = (
  text: string,
  value: string
): boolean => {
  return text.includes(
    nexusIntentNormalize(value)
  );
};

const nexusIntentScoreRule = (
  text: string,
  rule: NexusIntentRule
): number => {
  let score = 0;

  const normalized =
    nexusIntentNormalize(text);

  for (const phrase of rule.phrases ?? []) {
    if (
      nexusIntentContains(
        normalized,
        phrase
      )
    ) {
      score += 20;
    }
  }

  for (const keyword of rule.keywords) {
    if (
      nexusIntentContains(
        normalized,
        keyword
      )
    ) {
      score += 5;
    }
  }

  score += rule.priority / 100;

  return score;
};

const nexusIntentParameters = (
  text: string,
  type: NexusIntentType
): Record<string, string> => {
  const normalized =
    nexusIntentNormalize(text);

  const parameters: Record<
    string,
    string
  > = {};

  if (
    type === "remember" ||
    type === "forget"
  ) {
    const patterns = [
      /^запомни\s+(.+)$/i,
      /^запомни\s+что\s+(.+)$/i,
      /^помни\s+(.+)$/i,
      /^забудь\s+(.+)$/i,
      /^забыть\s+(.+)$/i,
      /^remember\s+(.+)$/i,
      /^forget\s+(.+)$/i,
    ];

    for (const pattern of patterns) {
      const match =
        text.trim().match(pattern);

      if (match?.[1]) {
        parameters.content =
          match[1].trim();
        break;
      }
    }

    if (!parameters.content) {
      parameters.content = text.trim();
    }
  }

  if (
    type === "note_create"
  ) {
    const patterns = [
      /^заметка\s*:?\s*(.+)$/i,
      /^заметку\s*:?\s*(.+)$/i,
      /^запиши\s*:?\s*(.+)$/i,
      /^создай заметку\s*:?\s*(.+)$/i,
      /^добавь заметку\s*:?\s*(.+)$/i,
      /^note\s*:?\s*(.+)$/i,
      /^create a note\s*:?\s*(.+)$/i,
    ];

    for (const pattern of patterns) {
      const match =
        text.trim().match(pattern);

      if (match?.[1]) {
        parameters.content =
          match[1].trim();
        break;
      }
    }

    if (!parameters.content) {
      parameters.content =
        text.trim();
    }
  }

  if (
    type === "task_create"
  ) {
    const patterns = [
      /^задача\s*:?\s*(.+)$/i,
      /^задачу\s*:?\s*(.+)$/i,
      /^создай задачу\s*:?\s*(.+)$/i,
      /^добавь задачу\s*:?\s*(.+)$/i,
      /^поставь задачу\s*:?\s*(.+)$/i,
      /^task\s*:?\s*(.+)$/i,
      /^create a task\s*:?\s*(.+)$/i,
    ];

    for (const pattern of patterns) {
      const match =
        text.trim().match(pattern);

      if (match?.[1]) {
        parameters.title =
          match[1].trim();
        break;
      }
    }

    if (!parameters.title) {
      parameters.title =
        text.trim();
    }
  }

  if (
    type === "calendar_create"
  ) {
    const patterns = [
      /^событие\s*:?\s*(.+)$/i,
      /^создай событие\s*:?\s*(.+)$/i,
      /^добавь событие\s*:?\s*(.+)$/i,
      /^запланируй\s*:?\s*(.+)$/i,
      /^event\s*:?\s*(.+)$/i,
      /^create event\s*:?\s*(.+)$/i,
    ];

    for (const pattern of patterns) {
      const match =
        text.trim().match(pattern);

      if (match?.[1]) {
        parameters.title =
          match[1].trim();
        break;
      }
    }

    if (!parameters.title) {
      parameters.title =
        text.trim();
    }
  }

  if (
    type === "timer_create"
  ) {
    const minuteMatch =
      normalized.match(
        /(\d+)\s*(?:мин|мину|минут|minute|minutes)/
      );

    const secondMatch =
      normalized.match(
        /(\d+)\s*(?:сек|секунд|second|seconds)/
      );

    if (minuteMatch?.[1]) {
      parameters.minutes =
        minuteMatch[1];
    }

    if (secondMatch?.[1]) {
      parameters.seconds =
        secondMatch[1];
    }

    if (!parameters.minutes &&
        !parameters.seconds) {
      const numberMatch =
        normalized.match(
          /(\d+)/
        );

      if (numberMatch?.[1]) {
        parameters.minutes =
          numberMatch[1];
      }
    }

    parameters.name =
      text
        .replace(
          /поставь таймер|запусти таймер|создай таймер|таймер|set a timer|start a timer/gi,
          ""
        )
        .trim();
  }

  if (
    type === "file_search" ||
    type === "note_search" ||
    type === "task_search"
  ) {
    parameters.query =
      text
        .replace(
          /найди|найти|покажи|поиск|search|show/gi,
          ""
        )
        .replace(
          /файл|файлы|документ|заметку|заметки|задачу|задачи|notes|tasks|files/gi,
          ""
        )
        .trim();
  }

  return parameters;
};

const nexusDetectIntent = (
  text: string
): NexusIntent => {
  const normalized =
    nexusIntentNormalize(text);

  if (!normalized) {
    return {
      type: "unknown",
      confidence: 0,
      text,
      parameters: {},
    };
  }

  let bestType:
    NexusIntentType = "chat";

  let bestScore = 0;

  for (const rule of NEXUS_INTENT_RULES) {
    const score =
      nexusIntentScoreRule(
        normalized,
        rule
      );

    if (score > bestScore) {
      bestScore = score;
      bestType = rule.type;
    }
  }

  if (
    bestScore < 5
  ) {
    bestType = "chat";
  }

  const confidence =
    Math.min(
      1,
      bestScore / 30
    );

  return {
    type: bestType,
    confidence,
    text,
    parameters:
      nexusIntentParameters(
        text,
        bestType
      ),
  };
};

