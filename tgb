function nexusSearchText(
  value: unknown
): string {
  if (
    typeof value !==
    "string"
  ) {
    return "";
  }

  return value
    .trim()
    .toLowerCase();
}

function nexusContains(
  source: unknown,
  query: string
): boolean {
  const normalizedQuery =
    nexusSearchText(
      query
    );

  if (!normalizedQuery) {
    return true;
  }

  return nexusSearchText(
    source
  ).includes(
    normalizedQuery
  );
}

function nexusSearchChats(
  chats: NexusChat[],
  query: string
): NexusChat[] {
  return chats.filter(
    (chat) =>
      nexusContains(
        chat.title,
        query
      ) ||
      chat.messages.some(
        (message) =>
          nexusContains(
            message.content,
            query
          )
      )
  );
}

