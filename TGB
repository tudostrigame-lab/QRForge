type NexusAIActionStatus =
  | "pending"
  | "running"
  | "completed"
  | "failed"
  | "cancelled";

type NexusAIActionExecution = {
  id: string;
  actionId: string;
  type: string;
  status: NexusAIActionStatus;
  input: Record<string, unknown>;
  output: unknown;
  error: string | null;
  createdAt: number;
  startedAt: number | null;
  completedAt: number | null;
};

type NexusAIActionDefinition = {
  id: string;
  name: string;
  description: string;
  aliases: string[];
  requiresConfirmation: boolean;
  handler: (
    input: Record<string, unknown>
  ) =>
    | unknown
    | Promise<unknown>;
};

type NexusAIActionRequest = {
  actionId: string;
  input: Record<string, unknown>;
  confirmationToken?: string;
};

type NexusAIActionResult = {
  success: boolean;
  execution: NexusAIActionExecution;
  message: string;
};

const nexusAIActionDefinitions =
  new Map<
    string,
    NexusAIActionDefinition
  >();

const nexusAIActionExecutions:
  NexusAIActionExecution[] = [];

const nexusAIActionHistoryLimit = 200;

const nexusCreateAIActionId =
  (): string =>
    `ai_action_${Date.now()}_${Math.random()
      .toString(36)
      .slice(2, 10)}`;

const nexusCreateExecutionId =
  (): string =>
    `exec_${Date.now()}_${Math.random()
      .toString(36)
      .slice(2, 10)}`;

/* -------------------------
   ACTION REGISTRATION
   ------------------------- */

const nexusRegisterAIAction = (
  definition: NexusAIActionDefinition
): boolean => {
  if (
    !definition.id ||
    !definition.name ||
    typeof definition.handler !==
      "function"
  ) {
    return false;
  }

  nexusAIActionDefinitions.set(
    definition.id,
    {
      ...definition,
      aliases:
        definition.aliases ?? []
    }
  );

  return true;
};

const nexusGetAIAction =
  (
    actionId: string
  ): NexusAIActionDefinition | null =>
    nexusAIActionDefinitions.get(
      actionId
    ) ?? null;

const nexusFindAIActionByText = (
  text: string
): NexusAIActionDefinition | null => {
  const normalized =
    text
      .toLowerCase()
      .trim();

  for (
    const action of
    nexusAIActionDefinitions.values()
  ) {
    if (
      normalized ===
      action.id.toLowerCase()
    ) {
      return action;
    }

    if (
      normalized ===
      action.name.toLowerCase()
    ) {
      return action;
    }

    if (
      action.aliases.some(
        (alias) =>
          normalized ===
          alias.toLowerCase()
      )
    ) {
      return action;
    }
  }

  return null;
};

/* -------------------------
   EXECUTION STORAGE
   ------------------------- */

const nexusStoreExecution = (
  execution: NexusAIActionExecution
) => {
  nexusAIActionExecutions.push(
    execution
  );

  if (
    nexusAIActionExecutions.length >
    nexusAIActionHistoryLimit
  ) {
    nexusAIActionExecutions.shift();
  }
};

const nexusGetAIActionExecutions =
  (): NexusAIActionExecution[] =>
    [
      ...nexusAIActionExecutions
    ].reverse();

const nexusGetAIActionExecution = (
  id: string
): NexusAIActionExecution | null =>
  nexusAIActionExecutions.find(
    (execution) =>
      execution.id === id
  ) ?? null;

/* -------------------------
   CONFIRMATION
   ------------------------- */

const nexusCreateConfirmationToken =
  (
    actionId: string
  ): string =>
    `${actionId}:${Date.now()}:${Math.random()
      .toString(36)
      .slice(2, 12)}`;

const nexusIsConfirmationValid = (
  token: string | undefined,
  actionId: string
): boolean => {
  if (!token) {
    return false;
  }

  return token.startsWith(
    `${actionId}:`
  );
};

/* -------------------------
   ACTION EXECUTION
   ------------------------- */

const nexusExecuteAIAction = async (
  request: NexusAIActionRequest
): Promise<NexusAIActionResult> => {
  const definition =
    nexusGetAIAction(
      request.actionId
    );

  const execution: NexusAIActionExecution =
    {
      id: nexusCreateExecutionId(),
      actionId:
        request.actionId,
      type:
        request.actionId,
      status: "pending",
      input:
        nexusClone(
          request.input
        ),
      output: null,
      error: null,
      createdAt: Date.now(),
      startedAt: null,
      completedAt: null
    };

  nexusStoreExecution(
    execution
  );

  if (!definition) {
    execution.status =
      "failed";

    execution.error =
      "AI action not found.";

    execution.completedAt =
      Date.now();

    return {
      success: false,
      execution,
      message:
        "Действие не найдено."
    };
  }

  if (
    definition.requiresConfirmation &&
    !nexusIsConfirmationValid(
      request.confirmationToken,
      definition.id
    )
  ) {
    execution.status =
      "cancelled";

    execution.completedAt =
      Date.now();

    return {
      success: false,
      execution,
      message:
        "Для этого действия требуется подтверждение."
    };
  }

  execution.status =
    "running";

  execution.startedAt =
    Date.now();

  nexusAIRequestEvent({
    actionId:
      definition.id,
    executionId:
      execution.id,
    input:
      execution.input
  });

  try {
    const output =
      await definition.handler(
        request.input
      );

    execution.output =
      nexusClone(output);

    execution.status =
      "completed";

    execution.completedAt =
      Date.now();

    nexusEmitEvent(
      "ai.action",
      {
        actionId:
          definition.id,
        executionId:
          execution.id,
        status:
          "completed",
        output:
          execution.output
      },
      "ai-action-coordinator"
    );

    return {
      success: true,
      execution,
      message:
        "Действие выполнено."
    };
  } catch (error) {
    const errorMessage =
      error instanceof Error
        ? error.message
        : String(error);

    execution.status =
      "failed";

    execution.error =
      errorMessage;

    execution.completedAt =
      Date.now();

    nexusEmitEvent(
      "system.error",
      {
        actionId:
          definition.id,
        executionId:
          execution.id,
        error:
          errorMessage
      },
      "ai-action-coordinator"
    );

    return {
      success: false,
      execution,
      message:
        "Не удалось выполнить действие."
    };
  }
};

