   ------------------------- */

const nexusNotificationBuildAISummary = (
  notifications: NexusNotification[]
): string => {
  const unread =
    nexusNotificationUnread(
      notifications
    );

  if (unread.length === 0) {
    return "Новых уведомлений нет.";
  }

  return nexusNotificationSort(
    unread
  )
    .slice(0, 15)
    .map(
      (notification) =>
        `- [${notification.type}] ${notification.title}: ${notification.message}`
    )
    .join("\n");
};

