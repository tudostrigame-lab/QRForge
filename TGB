const nexusParseAIActionCommand =
  (
    text: string
  ): NexusAIActionRequest | null => {
    const normalized =
      text
        .trim()
        .toLowerCase();

    if (
      normalized.startsWith(
        "создай заметку "
      )
    ) {
      return {
        actionId:
          "create_note",
        input: {
          title:
            text
              .trim()
              .slice(
                "создай заметку ".length
              )
        }
      };
    }

    if (
      normalized.startsWith(
        "создай задачу "
      )
    ) {
      return {
        actionId:
          "create_task",
        input: {
          title:
            text
              .trim()
              .slice(
                "создай задачу ".length
              )
        }
      };
    }

    if (
      normalized.startsWith(
        "запомни "
      )
    ) {
      return {
        actionId:
          "remember",
        input: {
          text:
            text
              .trim()
              .slice(
                "запомни ".length
              )
        }
      };
    }

    if (
      normalized.startsWith(
        "поставь таймер "
      )
    ) {
      const value =
        Number(
          normalized
            .replace(
              "поставь таймер ",
              ""
            )
            .replace(
              " секунд",
              ""
            )
            .trim()
        );

      if (
        Number.isFinite(
          value
        )
      ) {
        return {
          actionId:
            "start_timer",
          input: {
            seconds:
              value
          }
        };
      }
    }

    return null;
  };

