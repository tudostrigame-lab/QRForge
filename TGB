const nexusProductivityCreateNote = (
  title: string,
  content = ""
): NexusNote => {
  const note: NexusNote = {
    id: nexusId(),
    title: title.trim() || "Новая заметка",
    content,
    createdAt: Date.now(),
    updatedAt: Date.now()
  };

  nexusProductivityRecord("create-note", note.id);

  return note;
};

const nexusProductivityUpdateNote = (
  note: NexusNote,
  patch: Partial<NexusNote>
): NexusNote => {
  const updated: NexusNote = {
    ...note,
    ...patch,
    updatedAt: Date.now()
  };

  nexusProductivityRecord("update-note", updated.id);

  return updated;
};

const nexusProductivityDeleteNote = (
  notes: NexusNote[],
  noteId: string
): NexusNote[] => {
  const exists = notes.some((note) => note.id === noteId);

  if (exists) {
    nexusProductivityRecord("delete-note", noteId);
  }

  return notes.filter((note) => note.id !== noteId);
};

const nexusProductivitySearchNotes = (
  notes: NexusNote[],
  query: string
): NexusNote[] => {
  const normalized = query.trim().toLowerCase();

  if (!normalized) {
    return [...notes];
  }

  return notes
    .filter((note) =>
      `${note.title} ${note.content}`
        .toLowerCase()
        .includes(normalized)
    )
    .sort((a, b) => b.updatedAt - a.updatedAt);
};

const nexusProductivitySortNotes = (
  notes: NexusNote[]
): NexusNote[] => {
  return [...notes].sort(
    (a, b) => b.updatedAt - a.updatedAt
  );
};

const nexusProductivityRecentNotes = (
  notes: NexusNote[],
  limit = 10
): NexusNote[] => {
  return nexusProductivitySortNotes(notes).slice(0, limit);
};

