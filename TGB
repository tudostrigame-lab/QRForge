    | ((
        files: NexusFile[]
      ) => NexusFile[])
) => {
  nexusPushUndo(
    "Обновление файлов"
  );

  const next =
    typeof updater ===
    "function"
      ? updater(
          nexusCentralState.files
        )
      : updater;

  nexusCentralState = {
    ...nexusCentralState,
    files: nexusClone(next),
    savedAt: Date.now()
  };
};

/* -------------------------
   SAVE / LOAD
   ------------------------- */

const nexusStateSave = (): boolean => {
  if (
    typeof window ===
    "undefined"
  ) {
    return false;
  }

  try {
    localStorage.setItem(
      nexusStateStorageKey,
      JSON.stringify(
        nexusCentralState
      )
    );

    return true;
  } catch {
    return false;
  }
};

const nexusStateLoad = (): boolean => {
  if (
    typeof window ===
    "undefined"
  ) {
    return false;
  }

  try {
    const raw =
      localStorage.getItem(
        nexusStateStorageKey
      );

    if (!raw) {
      return false;
    }

    const parsed: unknown =
      JSON.parse(raw);

    if (
      !parsed ||
      typeof parsed !==
        "object"
    ) {
      return false;
    }

    const state =
      parsed as NexusAppSnapshot;

    nexusCentralState =
      nexusClone({
        ...nexusCreateEmptySnapshot(),
        ...state,
        savedAt: Date.now()
      });

    return true;
  } catch {
    return false;
  }
};

const nexusStateClearStorage =
  (): boolean => {
    if (
      typeof window ===
      "undefined"
    ) {
      return false;
    }

    try {
      localStorage.removeItem(
        nexusStateStorageKey
      );

      return true;
    } catch {
      return false;
    }
  };

