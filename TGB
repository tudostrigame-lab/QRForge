const nexusProductivityDeleteTask = (
  tasks: NexusTask[],
  taskId: string
): NexusTask[] => {
  const exists = tasks.some((task) => task.id === taskId);

  if (exists) {
    nexusProductivityRecord("delete-task", taskId);
  }

  return tasks.filter((task) => task.id !== taskId);
};

const nexusProductivitySearchTasks = (
  tasks: NexusTask[],
  query: string
): NexusTask[] => {
  const normalized = query.trim().toLowerCase();

  if (!normalized) {
    return [...tasks];
  }

  return tasks.filter((task) =>
    `${task.title} ${task.description} ${task.dueDate} ${task.dueTime}`
      .toLowerCase()
      .includes(normalized)
  );
};

const nexusProductivityPendingTasks = (
  tasks: NexusTask[]
): NexusTask[] => {
  return tasks.filter((task) => !task.completed);
};

const nexusProductivityCompletedTasks = (
  tasks: NexusTask[]
): NexusTask[] => {
  return tasks.filter((task) => task.completed);
};

const nexusProductivityOverdueTasks = (
  tasks: NexusTask[],
  currentDate = nexusDateKey(new Date())
): NexusTask[] => {
  return tasks.filter((task) => {
    if (task.completed || !task.dueDate) {
      return false;
    }

    return task.dueDate < currentDate;
  });
};

const nexusProductivityTodayTasks = (
  tasks: NexusTask[],
  currentDate = nexusDateKey(new Date())
): NexusTask[] => {
  return tasks.filter(
    (task) =>
      !task.completed &&
      task.dueDate === currentDate
  );
};

const nexusProductivitySortTasks = (
  tasks: NexusTask[]
): NexusTask[] => {
  return [...tasks].sort((a, b) => {
    if (!a.dueDate && !b.dueDate) {
      return b.createdAt - a.createdAt;
    }

    if (!a.dueDate) {
      return 1;
    }

    if (!b.dueDate) {
      return -1;
    }

    const aValue = `${a.dueDate} ${a.dueTime || "23:59"}`;
    const bValue = `${b.dueDate} ${b.dueTime || "23:59"}`;

    return aValue.localeCompare(bValue);
  });
};

