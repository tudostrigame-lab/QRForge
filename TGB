    return data.text.trim();
  }

  if (
    typeof data.message === "string"
  ) {
    return data.message.trim();
  }

  if (
    typeof data.response === "string"
  ) {
    return data.response.trim();
  }

  if (
    Array.isArray(data.output)
  ) {
    const parts: string[] = [];

    for (const item of data.output) {
      if (
        typeof item?.text === "string"
      ) {
        parts.push(item.text);
      }

      if (
        Array.isArray(item?.content)
      ) {
        for (const content of item.content) {
          if (
            typeof content?.text === "string"
          ) {
            parts.push(content.text);
          }
        }
      }
    }

    if (parts.length > 0) {
      return parts.join("\n").trim();
    }
  }

  if (
    Array.isArray(data.choices)
  ) {
    const choice = data.choices[0];

    if (
      typeof choice?.text === "string"
    ) {
      return choice.text.trim();
    }

    if (
      typeof choice?.message?.content ===
      "string"
    ) {
      return choice.message.content.trim();
    }

    if (
      Array.isArray(choice?.message?.content)
    ) {
      return choice.message.content
        .map((item: any) =>
          typeof item?.text === "string"
            ? item.text
            : ""
        )
        .filter(Boolean)
        .join("\n")
        .trim();
    }
  }

  return "";
};

const nexusAIRequestPayload = (
  request: NexusAIRequest
) => {
  return {
    model:
      request.context
        ? undefined
        : undefined,
    message: request.message,
    context: request.context ?? null,
    systemPrompt:
      request.systemPrompt ?? "",
    userPrompt:
      request.userPrompt ??
      request.message,
    temperature:
      request.temperature ??
      NEXUS_AI_DEFAULT_CONFIG.temperature,
    maxOutputTokens:
      request.maxOutputTokens ??
      NEXUS_AI_DEFAULT_CONFIG.maxOutputTokens,
  };
};

const nexusAIAbortAfter = (
  timeoutMs: number,
  externalSignal?: AbortSignal
) => {
  const controller =
    new AbortController();

  const timer = setTimeout(() => {
    controller.abort();
  }, timeoutMs);

  if (externalSignal) {
    if (externalSignal.aborted) {
      controller.abort();
    } else {
      externalSignal.addEventListener(
        "abort",
        () => controller.abort(),
        { once: true }
      );
    }
  }

  return {
    signal: controller.signal,
    cleanup: () => clearTimeout(timer),
  };
};

const nexusAICallBackend = async (
  request: NexusAIRequest,
  config: NexusAIConfig
): Promise<NexusAIResponse> => {
  const endpoint =
    request.endpoint ||
    config.endpoint;

  if (!endpoint) {
    return {
      ok: false,
      text: "",
      provider: request.provider,
      error:
        "NEXUS AI endpoint is not configured.",
    };
  }

  const timeout =
    nexusAIAbortAfter(
      config.timeoutMs,
      request.signal
    );

  nexusAIRecordEvent({
    type: "request",
    provider: request.provider,
    message: request.message,
  });

  try {
    const response = await fetch(
      endpoint,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/json",
        },
        body: JSON.stringify(
          nexusAIRequestPayload(request)
        ),
        signal: timeout.signal,
      }
    );

    const raw =
      await response.json().catch(
        () => null
      );

    if (!response.ok) {
      const error =
        typeof raw?.error === "string"
          ? raw.error
          : `AI request failed with status ${response.status}.`;

      nexusAIRecordEvent({
        type: "error",
        provider: request.provider,
        message: request.message,
        error,
      });

      return {
        ok: false,
        text: "",
        provider: request.provider,
        error,
        raw,
      };
    }

    const text =
      nexusAIExtractText(raw);

    if (!text) {
      const error =
        "AI returned an empty response.";

      nexusAIRecordEvent({
        type: "error",
        provider: request.provider,
        message: request.message,
        error,
      });

      return {
        ok: false,
        text: "",
        provider: request.provider,
        error,
        raw,
      };
    }

    nexusAIRecordEvent({
      type: "response",
      provider: request.provider,
      message: request.message,
      response: text,
    });

    return {
      ok: true,
      text,
      provider: request.provider,
      model: config.model,
      raw,
    };
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Unknown AI request error.";

    nexusAIRecordEvent({
      type: "error",
      provider: request.provider,
      message: request.message,
      error: message,
    });

    return {
      ok: false,
      text: "",
      provider: request.provider,
      error: message,
    };
  } finally {
    timeout.cleanup();
  }
};

const nexusAILocalResponse = (
  message: string,
  context?: NexusAIContext | null
): string => {
  const text =
    message.trim().toLowerCase();

  if (!text) {
    return "Напиши мне что-нибудь.";
  }

  if (
    text.includes("привет") ||
    text.includes("здравствуй") ||
    text === "хай" ||
    text === "hello" ||
    text === "hi"
  ) {
    return "Привет! Я NEXUS. Чем могу помочь?";
  }

  if (
    text.includes("как дела") ||
    text.includes("как ты")
  ) {
    return "Всё хорошо. Я готов работать.";
  }

  if (
    text.includes("кто ты") ||
    text.includes("ты кто")
  ) {
    return "Я NEXUS — персональный AI-помощник.";
  }

  if (
    text.includes("что ты умеешь") ||
    text.includes("что умеешь")
  ) {
    return [
      "Я могу помогать с задачами, заметками,",
      "планами, календарём, файлами и общением.",
    ].join(" ");
  }

  if (
    text.includes("время") &&
    context
  ) {
    return `Сейчас ${nexusTime(
      new Date()
    )}.`;
  }

  if (
    text.includes("дата") &&
    context
  ) {
    return `Сегодня ${nexusDate(
      new Date()
    )}.`;
  }

  if (
    text.includes("задач") &&
    context
  ) {
    const count =
      context.tasks?.length ?? 0;

    if (count === 0) {
      return "У тебя сейчас нет сохранённых задач.";
    }

    return `У тебя сохранено задач: ${count}.`;
  }

  if (
    text.includes("заметк") &&
    context
  ) {
    const count =
      context.notes?.length ?? 0;

    if (count === 0) {
      return "У тебя пока нет заметок.";
    }

    return `У тебя сохранено заметок: ${count}.`;
  }

  if (
    text.includes("памят") &&
    context
  ) {
    const count =
      context.memory?.length ?? 0;

    return `В памяти NEXUS сейчас ${count} записей.`;
  }

  return [
    "Я пока работаю в локальном режиме.",
    "Когда AI-сервер подключён,",
    "я смогу дать полноценный ответ.",
  ].join(" ");
};

const nexusAIFallback = (
  message: string,
  context?: NexusAIContext | null
): NexusAIResponse => {
  const text =
    nexusAILocalResponse(
      message,
      context
    );

  nexusAIRecordEvent({
    type: "fallback",
    provider: "local",
    message,
    response: text,
  });

  return {
    ok: true,
    text,
    provider: "local",
    model: "nexus-local",
  };
};

const nexusAIRequest = async (
  message: string,
  context?: NexusAIContext | null,
  customConfig?: Partial<NexusAIConfig>
): Promise<NexusAIResponse> => {
  const config =
    nexusAICloneConfig({
      ...NEXUS_AI_DEFAULT_CONFIG,
      ...(customConfig || {}),
    });

  if (!config.enabled) {
    return nexusAIFallback(
      message,
      context
    );
  }

  if (
    config.provider === "local"
  ) {
    return nexusAIFallback(
      message,
      context
    );
  }

  const systemPrompt =
    nexusAIContextSystemPrompt(
      context
    );

  const userPrompt =
    nexusAIContextUserPrompt(
      message,
      context
    );

  const result =
    await nexusAICallBackend(
      {
        provider: config.provider,
        message,
        context,
        systemPrompt,
        userPrompt,
        temperature:
          config.temperature,
        maxOutputTokens:
          config.maxOutputTokens,
        endpoint:
          config.endpoint,
      },
      config
    );

  if (result.ok) {
    return result;
  }

  return nexusAIFallback(
    message,
    context
  );
};

const nexusAIGetEvents = (
  limit = 50
) => {
  return NEXUS_AI_EVENTS
    .slice(-Math.max(1, limit))
    .map((item) => ({
      ...item,
    }));
};

const nexusAIClearEvents = () => {
  NEXUS_AI_EVENTS.length = 0;
};

const nexusAIStats = () => {
  const requests =
    NEXUS_AI_EVENTS.filter(
      (event) =>
        event.type === "request"
    ).length;

  const responses =
    NEXUS_AI_EVENTS.filter(
      (event) =>
        event.type === "response"
    ).length;

  const errors =
    NEXUS_AI_EVENTS.filter(
      (event) =>
        event.type === "error"
    ).length;

  const fallbacks =
    NEXUS_AI_EVENTS.filter(
      (event) =>
        event.type === "fallback"
    ).length;

  return {
    total:
      NEXUS_AI_EVENTS.length,
    requests,
    responses,
    errors,
    fallbacks,
    successRate:
      requests > 0
        ? Math.round(
            (responses / requests) *
              100
          )
        : 0,
  };
};

