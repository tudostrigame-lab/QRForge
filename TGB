type NexusProfileField =
  | "name"
  | "language"
  | "location"
  | "occupation"
  | "education"
  | "interests"
  | "goals"
  | "preferences"
  | "projects"
  | "communication";

type NexusProfileValue = {
  id: string;
  field: NexusProfileField;
  value: string;
  confidence: number;
  source: "user" | "inference" | "system";
  createdAt: string;
  updatedAt: string;
};

type NexusLearningSignal =
  | "explicit"
  | "repeated"
  | "correction"
  | "preference"
  | "goal"
  | "project"
  | "communication";

type NexusLearningItem = {
  id: string;
  text: string;
  signal: NexusLearningSignal;
  confidence: number;
  occurrences: number;
  createdAt: string;
  updatedAt: string;
};

type NexusUserProfile = {
  version: number;
  fields: NexusProfileValue[];
  learning: NexusLearningItem[];
};

const NEXUS_PROFILE_VERSION = 1;

const NEXUS_PROFILE_DEFAULT: NexusUserProfile = {
  version:
    NEXUS_PROFILE_VERSION,
  fields: [],
  learning: [],
};

const nexusProfileNormalize = (
  value: string
): string => {
  return value
    .replace(/\s+/g, " ")
    .trim();
};

const nexusProfileFindField = (
  profile: NexusUserProfile,
  field: NexusProfileField
): NexusProfileValue | null => {
  return (
    profile.fields.find(
      (item) =>
        item.field === field
    ) || null
  );
};

const nexusProfileSetField = (
  profile: NexusUserProfile,
  field: NexusProfileField,
  value: string,
  confidence = 1,
  source:
    | "user"
    | "inference"
    | "system" = "user"
): NexusUserProfile => {
  const normalized =
    nexusProfileNormalize(
      value
    );

  if (!normalized) {
    return profile;
  }

  const existing =
    nexusProfileFindField(
      profile,
      field
    );

  const now =
    new Date().toISOString();

  if (existing) {
    existing.value =
      normalized;

    existing.confidence =
      Math.max(
        existing.confidence,
        confidence
      );

    existing.source =
      source;

    existing.updatedAt =
      now;

    return profile;
  }

  profile.fields.push({
    id: nexusId("profile"),
    field,
    value: normalized,
    confidence,
    source,
    createdAt: now,
    updatedAt: now,
  });

  return profile;
};

const nexusProfileRemoveField = (
  profile: NexusUserProfile,
  field: NexusProfileField
): NexusUserProfile => {
  profile.fields =
    profile.fields.filter(
      (item) =>
        item.field !== field
    );

  return profile;
};

const nexusProfileAddLearning = (
  profile: NexusUserProfile,
  text: string,
  signal: NexusLearningSignal,
  confidence = 0.7
): NexusLearningItem => {
  const normalized =
    nexusProfileNormalize(
      text
    );

  const existing =
    profile.learning.find(
      (item) =>
        item.text.toLowerCase() ===
        normalized.toLowerCase()
    );

  const now =
    new Date().toISOString();

  if (existing) {
    existing.occurrences += 1;

    existing.confidence =
      Math.min(
        1,
        Math.max(
          existing.confidence,
          confidence
        ) + 0.05
      );

    existing.updatedAt =
      now;

    return existing;
  }

  const item: NexusLearningItem = {
    id: nexusId("learning"),
    text: normalized,
    signal,
    confidence,
    occurrences: 1,
    createdAt: now,
    updatedAt: now,
  };

  profile.learning.push(
    item
  );

  if (
    profile.learning.length >
    200
  ) {
    profile.learning =
      profile.learning
        .sort(
          (a, b) =>
            b.confidence -
            a.confidence
        )
        .slice(0, 200);
  }

  return item;
};

const nexusProfileLearnFromMessage = (
  profile: NexusUserProfile,
  message: string
): NexusUserProfile => {
  const text =
    nexusProfileNormalize(
      message
    );

  if (!text) {
    return profile;
  }

  const lower =
    text.toLowerCase();

  const namePatterns = [
    /(?:меня зовут|моё имя|мое имя|я зовусь)\s+([а-яёa-z-]+)/i,
    /(?:my name is|i am|i'm)\s+([a-z-]+)/i,
  ];

  for (const pattern of namePatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileSetField(
        profile,
        "name",
        match[1],
        1,
        "user"
      );
    }
  }

  const goalPatterns = [
    /(?:моя цель|цель|хочу)\s+(.+)/i,
    /(?:my goal is|i want to)\s+(.+)/i,
  ];

  for (const pattern of goalPatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileAddLearning(
        profile,
        match[1],
        "goal",
        0.85
      );
    }
  }

  const projectPatterns = [
    /(?:мой проект|моя программа|делаю проект)\s+(.+)/i,
    /(?:my project|i'm building)\s+(.+)/i,
  ];

  for (const pattern of projectPatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileAddLearning(
        profile,
        match[1],
        "project",
        0.9
      );
    }
  }

  const preferencePatterns = [
    /(?:я люблю|мне нравится|мне не нравится|я предпочитаю)\s+(.+)/i,
    /(?:i like|i don't like|i prefer)\s+(.+)/i,
  ];

  for (const pattern of preferencePatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileAddLearning(
        profile,
        match[1],
        "preference",
        0.85
      );
    }
  }

  const correctionPatterns = [
    /(?:нет,|не так,|исправь,|правильно:)\s*(.+)/i,
    /(?:no,|not exactly,|correct:)\s*(.+)/i,
  ];

  for (const pattern of correctionPatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileAddLearning(
        profile,
        match[1],
        "correction",
        0.95
      );
    }
  }

  const communicationPatterns = [
    /(?:отвечай|пиши|говори)\s+(.+)/i,
    /(?:answer|write|speak)\s+(.+)/i,
  ];

  for (const pattern of communicationPatterns) {
    const match =
      text.match(pattern);

    if (match?.[1]) {
      nexusProfileAddLearning(
        profile,
        match[1],
        "communication",
        0.9
      );
    }
  }

  if (
    lower.includes("короче") ||
    lower.includes("кратко") ||
    lower.includes("без объяснений")
  ) {
    nexusProfileAddLearning(
      profile,
      "Пользователь предпочитает краткие ответы.",
      "communication",
      0.85
    );
  }

  return profile;
};

