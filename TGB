  history: () => NexusStateHistoryItem[];
};

const nexusClone = <T,>(
  value: T
): T => {
  try {
    return JSON.parse(
      JSON.stringify(value)
    ) as T;
  } catch {
    return value;
  }
};

const nexusCreateEmptySnapshot =
  (): NexusAppSnapshot => ({
    chats: [],
    memory: [],
    notes: [],
    tasks: [],
    events: [],
    timers: [],
    files: [],
    settings: {},
    analytics: [],
    savedAt: Date.now()
  });

const nexusStateStorageKey =
  "nexus_central_state_v1";

let nexusCentralState =
  nexusCreateEmptySnapshot();

let nexusUndoStack:
  NexusStateHistoryItem[] = [];

let nexusRedoStack:
  NexusStateHistoryItem[] = [];

const nexusStateHistoryLimit = 50;

const nexusCreateHistoryItem = (
  label: string,
  state: NexusAppSnapshot
): NexusStateHistoryItem => ({
  id: `state_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 9)}`,
  timestamp: Date.now(),
  label,
  state: nexusClone(state)
});

const nexusPushUndo = (
  label: string
) => {
  nexusUndoStack.push(
    nexusCreateHistoryItem(
      label,
      nexusCentralState
    )
  );

  if (
    nexusUndoStack.length >
    nexusStateHistoryLimit
  ) {
    nexusUndoStack.shift();
  }

  nexusRedoStack = [];
};

const nexusStateGet =
  (): NexusAppSnapshot =>
    nexusClone(
      nexusCentralState
    );

const nexusStateSet = (
  state: NexusAppSnapshot
) => {
  nexusPushUndo("Изменение состояния");

  nexusCentralState =
    nexusClone({
      ...state,
      savedAt: Date.now()
    });
};

const nexusStatePatch = (
  patch: NexusStatePatch
) => {
  nexusPushUndo("Обновление состояния");

  nexusCentralState =
    nexusClone({
      ...nexusCentralState,
      ...patch,
      savedAt: Date.now()
    });
};

const nexusStateSaveSnapshot = (
  label: string
) => {
  nexusPushUndo(label);
};

const nexusStateUndo = (): boolean => {
  const previous =
    nexusUndoStack.pop();

  if (!previous) {
    return false;
  }

  nexusRedoStack.push(
    nexusCreateHistoryItem(
      "Отмена изменения",
      nexusCentralState
    )
  );

  nexusCentralState =
    nexusClone(
      previous.state
    );

  return true;
};

const nexusStateRedo = (): boolean => {
  const next =
    nexusRedoStack.pop();

  if (!next) {
    return false;
  }

  nexusUndoStack.push(
    nexusCreateHistoryItem(
      "Повтор изменения",
      nexusCentralState
    )
  );

  nexusCentralState =
    nexusClone(
      next.state
    );

  return true;
};

const nexusStateReset = () => {
  nexusPushUndo(
    "Сброс состояния"
  );

  nexusCentralState =
    nexusCreateEmptySnapshot();

  nexusRedoStack = [];
};

const nexusStateHistory =
  (): NexusStateHistoryItem[] => [
    ...nexusUndoStack
  ].reverse();

const nexusStateRedoHistory =
  (): NexusStateHistoryItem[] => [
    ...nexusRedoStack
  ].reverse();

const nexusStateCanUndo =
  (): boolean =>
    nexusUndoStack.length > 0;

const nexusStateCanRedo =
  (): boolean =>
