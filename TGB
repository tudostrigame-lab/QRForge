const nexusProfileGetTopLearning = (
  profile: NexusUserProfile,
  limit = 20
): NexusLearningItem[] => {
  return profile.learning
    .slice()
    .sort(
      (a, b) => {
        const scoreA =
          a.confidence *
          Math.min(
            a.occurrences,
            10
          );

        const scoreB =
          b.confidence *
          Math.min(
            b.occurrences,
            10
          );

        return scoreB - scoreA;
      }
    )
    .slice(
      0,
      Math.max(1, limit)
    );
};

const nexusProfileSearchLearning = (
  profile: NexusUserProfile,
  query: string
