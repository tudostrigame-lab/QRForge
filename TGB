const nexusRecommendationId = (
  type: NexusRecommendationType
): string =>
  `recommendation_${type}_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 9)}`;

const nexusRecommendation = (
  type: NexusRecommendationType,
  priority: NexusRecommendationPriority,
  title: string,
  description: string,
  options?: {
    action?: string;
    entityId?: string;
    expiresAt?: number;
  }
): NexusRecommendation => ({
  id: nexusRecommendationId(type),
  type,
