type NexusAnalyticsAction =
  | "message"
  | "memory"
  | "note"
  | "task"
  | "calendar"
  | "timer"
  | "alarm"
  | "file"
  | "search"
  | "settings"
  | "command"
  | "system";

type NexusAnalyticsEvent = {
  id: string;
  action: NexusAnalyticsAction;
  timestamp: number;
  success: boolean;
  metadata?: Record<string, string | number | boolean>;
};

type NexusAnalyticsSummary = {
  totalEvents: number;
  successfulEvents: number;
  failedEvents: number;
  messages: number;
  memories: number;
  notes: number;
  tasks: number;
  calendarEvents: number;
  timers: number;
  alarms: number;
  files: number;
  searches: number;
  commands: number;
  firstActivity: number | null;
  lastActivity: number | null;
  activeDays: number;
};

const nexusAnalyticsCreateEvent = (
  action: NexusAnalyticsAction,
  success = true,
  metadata?: Record<string, string | number | boolean>
): NexusAnalyticsEvent => ({
  id: `analytics_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 10)}`,
  action,
  timestamp: Date.now(),
  success,
  metadata,
});

const nexusAnalyticsRecord = (
  events: NexusAnalyticsEvent[],
  action: NexusAnalyticsAction,
  success = true,
  metadata?: Record<string, string | number | boolean>
): NexusAnalyticsEvent[] => [
  ...events,
  nexusAnalyticsCreateEvent(
    action,
    success,
    metadata
  ),
];

const nexusAnalyticsCount = (
  events: NexusAnalyticsEvent[],
  action: NexusAnalyticsAction
): number =>
  events.filter(
    (event) => event.action === action
  ).length;

const nexusAnalyticsActiveDays = (
  events: NexusAnalyticsEvent[]
): number => {
  const days = new Set<string>();

  for (const event of events) {
    const date = new Date(event.timestamp);

    days.add(
      `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`
    );
  }

  return days.size;
};

const nexusAnalyticsSummary = (
  events: NexusAnalyticsEvent[]
): NexusAnalyticsSummary => {
  const sorted = [...events].sort(
    (a, b) => a.timestamp - b.timestamp
  );

  return {
    totalEvents: events.length,

    successfulEvents: events.filter(
      (event) => event.success
    ).length,

    failedEvents: events.filter(
      (event) => !event.success
    ).length,

    messages: nexusAnalyticsCount(
      events,
      "message"
    ),

    memories: nexusAnalyticsCount(
      events,
      "memory"
    ),

    notes: nexusAnalyticsCount(
      events,
      "note"
    ),

    tasks: nexusAnalyticsCount(
      events,
      "task"
    ),

    calendarEvents: nexusAnalyticsCount(
      events,
      "calendar"
    ),

    timers: nexusAnalyticsCount(
      events,
      "timer"
    ),

    alarms: nexusAnalyticsCount(
      events,
      "alarm"
    ),

    files: nexusAnalyticsCount(
      events,
      "file"
    ),

    searches: nexusAnalyticsCount(
      events,
      "search"
    ),

    commands: nexusAnalyticsCount(
      events,
      "command"
    ),

    firstActivity:
      sorted.length > 0
        ? sorted[0].timestamp
        : null,

    lastActivity:
      sorted.length > 0
        ? sorted[sorted.length - 1].timestamp
        : null,

    activeDays:
      nexusAnalyticsActiveDays(events),
  };
};

const nexusAnalyticsRecent = (
  events: NexusAnalyticsEvent[],
  limit = 20
): NexusAnalyticsEvent[] =>
  [...events]
    .sort(
      (a, b) =>
        b.timestamp - a.timestamp
    )
    .slice(0, Math.max(0, limit));

const nexusAnalyticsToday = (
  events: NexusAnalyticsEvent[]
): NexusAnalyticsEvent[] => {
  const now = new Date();

  return events.filter((event) => {
    const date = new Date(event.timestamp);

    return (
      date.getFullYear() ===
        now.getFullYear() &&
      date.getMonth() === now.getMonth() &&
      date.getDate() === now.getDate()
    );
  });
};

const nexusAnalyticsThisWeek = (
  events: NexusAnalyticsEvent[]
): NexusAnalyticsEvent[] => {
  const now = new Date();
  const day = now.getDay();

  const difference =
    day === 0 ? 6 : day - 1;

  const start = new Date(now);

  start.setHours(0, 0, 0, 0);
  start.setDate(
    now.getDate() - difference
  );

  return events.filter(
    (event) =>
      event.timestamp >= start.getTime()
  );
};

const nexusAnalyticsMostUsedAction = (
  events: NexusAnalyticsEvent[]
): NexusAnalyticsAction | null => {
  if (events.length === 0) {
    return null;
  }

  const counts =
    new Map<
      NexusAnalyticsAction,
      number
    >();

  for (const event of events) {
    counts.set(
      event.action,
      (counts.get(event.action) ?? 0) + 1
    );
  }

  let result:
    | NexusAnalyticsAction
    | null = null;

  let highest = 0;

  for (const [action, count] of counts) {
    if (count > highest) {
      highest = count;
      result = action;
    }
  }

  return result;
};

const nexusAnalyticsSuccessRate = (
  events: NexusAnalyticsEvent[]
): number => {
  if (events.length === 0) {
    return 100;
  }

  const successful =
    events.filter(
      (event) => event.success
    ).length;

  return Math.round(
    (successful / events.length) * 100
  );
};

const nexusAnalyticsGenerateReport = (
  events: NexusAnalyticsEvent[]
) => {
  const summary =
    nexusAnalyticsSummary(events);

  return {
    summary,
    mostUsedAction:
      nexusAnalyticsMostUsedAction(events),
    successRate:
      nexusAnalyticsSuccessRate(events),
    today:
      nexusAnalyticsToday(events).length,
    thisWeek:
      nexusAnalyticsThisWeek(events).length,
    recent:
      nexusAnalyticsRecent(events, 10),
  };
};

