type NexusRole = "user" | "assistant";

type NexusSection =
  | "chat"
  | "memory"
  | "notes"
  | "tasks"
  | "calendar"
  | "clock"
  | "timers"
  | "files"
  | "settings";

type NexusMessage = {
  id: string;
  role: NexusRole;
  content: string;
  createdAt: string;
};

type NexusChat = {
  id: string;
  title: string;
  messages: NexusMessage[];
  createdAt: string;
  updatedAt: string;
};

type NexusMemoryCategory =
  | "fact"
  | "preference"
  | "goal"
  | "project"
  | "important";

type NexusMemoryItem = {
  id: string;
  text: string;
  category: NexusMemoryCategory;
  createdAt: string;
  updatedAt: string;
};

type NexusNote = {
  id: string;
  title: string;
  content: string;
  createdAt: string;
  updatedAt: string;
};

type NexusTask = {
  id: string;
  title: string;
  description: string;
  completed: boolean;
  dueDate: string;
  dueTime: string;
  createdAt: string;
  updatedAt: string;
};

type NexusCalendarEvent = {
  id: string;
  title: string;
  description: string;
  date: string;
  time: string;
  createdAt: string;
  updatedAt: string;
};

type NexusTimer = {
  id: string;
  name: string;
  duration: number;
  remaining: number;
  running: boolean;
  createdAt: string;
};

type NexusFile = {
  id: string;
  name: string;
  type: "file" | "folder";
  parentId: string | null;
  content: string;
  createdAt: string;
  updatedAt: string;
};

type NexusSettings = {
  language: string;
  notifications: boolean;
  darkMode: boolean;
  autoSave: boolean;
  memoryEnabled: boolean;
};

type NexusModule = {
  id: string;
  title: string;
  description: string;
  icon: string;
  section: NexusSection;
  order: number;
};

const NEXUS_VERSION = "1.0.0";

const NEXUS_STORAGE_KEY = "nexus_data_v1";

const NEXUS_MODULES: NexusModule[] = [];

function registerNexusModule(module: NexusModule) {
  const exists = NEXUS_MODULES.some((item) => item.id === module.id);

  if (!exists) {
    NEXUS_MODULES.push(module);
    NEXUS_MODULES.sort((a, b) => a.order - b.order);
  }
}

function nexusId(prefix = "nexus") {
  return `${prefix}_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 10)}`;
}

function nexusDate() {
  return new Date().toISOString();
}

function nexusDateKey(date = new Date()) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

function nexusTime(date = new Date()) {
  return date.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function nexusInitialChat(): NexusChat {
  const now = nexusDate();

  return {
    id: nexusId("chat"),
    title: "Новый чат",
    messages: [
      {
        id: nexusId("message"),
        role: "assistant",
        content:
          "Привет. Я NEXUS. Я готов работать с чатами, памятью, задачами, заметками, календарём и другими инструментами.",
        createdAt: now,
      },
    ],
    createdAt: now,
    updatedAt: now,
  };
}

function nexusInitialSettings(): NexusSettings {
  return {
    language: "ru",
    notifications: true,
    darkMode: false,
    autoSave: true,
    memoryEnabled: true,
  };
}

function NexusApp() {
  const [section, setSection] =
    useState<NexusSection>("chat");

  const [sidebarOpen, setSidebarOpen] =
    useState(true);

  const [chats, setChats] = useState<NexusChat[]>(() => [
    nexusInitialChat(),
  ]);

  const [activeChatId, setActiveChatId] =
    useState<string>(() => chats[0]?.id || "");

  const [input, setInput] = useState("");

  const [thinking, setThinking] =
    useState(false);

  const [error, setError] = useState("");

  const [memory, setMemory] =
    useState<NexusMemoryItem[]>([]);

  const [notes, setNotes] =
    useState<NexusNote[]>([]);

  const [tasks, setTasks] =
    useState<NexusTask[]>([]);

  const [events, setEvents] =
    useState<NexusCalendarEvent[]>([]);

  const [timers, setTimers] =
    useState<NexusTimer[]>([]);

  const [files, setFiles] =
    useState<NexusFile[]>([]);

  const [settings, setSettings] =
    useState<NexusSettings>(
      nexusInitialSettings()
    );

  const [now, setNow] =
    useState<Date>(() => new Date());

  const [search, setSearch] =
    useState("");

  const [searchOpen, setSearchOpen] =
    useState(false);

  const activeChat = useMemo(
    () =>
      chats.find(
        (chat) => chat.id === activeChatId
      ) || null,
    [chats, activeChatId]
  );

  useEffect(() => {
    const timer = window.setInterval(() => {
      setNow(new Date());
    }, 1000);

    return () => {
      window.clearInterval(timer);
    };
  }, []);

  useEffect(() => {
    if (!activeChatId && chats.length > 0) {
      setActiveChatId(chats[0].id);
    }
  }, [activeChatId, chats]);

  function createChat() {
    const chat = nexusInitialChat();

    setChats((current) => [
      chat,
      ...current,
    ]);

    setActiveChatId(chat.id);
    setSection("chat");
    setError("");
  }

  function selectChat(id: string) {
    setActiveChatId(id);
    setSection("chat");
    setError("");
  }

  function deleteChat(id: string) {
    setChats((current) => {
      const next = current.filter(
        (chat) => chat.id !== id
      );

      if (next.length === 0) {
        const fresh = nexusInitialChat();
        setActiveChatId(fresh.id);
        return [fresh];
      }

      if (id === activeChatId) {
        setActiveChatId(next[0].id);
      }

      return next;
    });
  }

  function addMessage(
    chatId: string,
    role: NexusRole,
    content: string
  ) {
    const message: NexusMessage = {
      id: nexusId("message"),
      role,
      content,
      createdAt: nexusDate(),
    };

    setChats((current) =>
      current.map((chat) => {
        if (chat.id !== chatId) {
          return chat;
        }

        return {
          ...chat,
          messages: [
            ...chat.messages,
            message,
          ],
          updatedAt: nexusDate(),
        };
      })
    );
  }

  function sendMessage() {
    const text = input.trim();

    if (!text || thinking) {
      return;
    }

    let chatId = activeChatId;

    if (!chatId) {
      const chat = nexusInitialChat();

      setChats((current) => [
        chat,
        ...current,
      ]);

      chatId = chat.id;
      setActiveChatId(chat.id);
    }

    addMessage(
      chatId,
      "user",
      text
    );

    setInput("");
    setThinking(true);
    setError("");

    window.setTimeout(() => {
      addMessage(
        chatId!,
        "assistant",
        "NEXUS готов. AI-движок и остальные системы будут подключаться следующими модулями."
      );

      setThinking(false);
    }, 500);
  }

  function handleKeyDown(
    event: React.KeyboardEvent<HTMLTextAreaElement>
  ) {
    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {
      event.preventDefault();
      sendMessage();
    }
  }

