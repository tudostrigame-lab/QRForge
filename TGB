    ),

    ...nexusSearchFileIndex(
      state.files
    )
  ];
};

/* -------------------------
   SEARCH
   ------------------------- */

const nexusSearch = (
  query: string,
  index: NexusSearchIndex[]
): NexusSearchResult[] => {
  if (!query.trim()) {
    return [];
  }

  const results =
    index
      .map((item) => {
        const score =
          nexusSearchScore(
            query,
            `${item.title} ${item.content}`
          );

        return {
          id: item.id,
          entity:
            item.entity,
          entityId:
            item.entityId,
          title:
            item.title,
          content:
            item.content,
          score,
          createdAt:
            item.createdAt,
          updatedAt:
            item.updatedAt
        };
      })
      .filter(
        (item) =>
          item.score > 0
      )
      .sort(
        (a, b) =>
          b.score -
          a.score
      );

  return results;
};

/* -------------------------
   FILTER
   ------------------------- */

const nexusSearchByEntity = (
  results: NexusSearchResult[],
  entity: NexusSearchEntity
): NexusSearchResult[] => {
  return results.filter(
    (result) =>
      result.entity ===
      entity
  );
};

/* -------------------------
   RECENT SEARCHES
   ------------------------- */

const NEXUS_RECENT_SEARCHES:
  string[] = [];

const nexusSearchAddRecent = (
  query: string
) => {
  if (!query.trim()) {
    return;
  }

  const normalized =
    query.trim();

  const filtered =
    NEXUS_RECENT_SEARCHES.filter(
      (item) =>
        item !== normalized
    );

  filtered.unshift(
    normalized
  );

  NEXUS_RECENT_SEARCHES.length = 0;

  NEXUS_RECENT_SEARCHES.push(
    ...filtered.slice(0, 30)
  );
};

const nexusSearchRecent =
  (): string[] => {
    return [
      ...NEXUS_RECENT_SEARCHES
    ];
  };

/* -------------------------
   AI SEARCH SUMMARY
   ------------------------- */

const nexusSearchAISummary = (
  query: string,
  results: NexusSearchResult[]
): string => {
  if (
    results.length === 0
  ) {
    return `По запросу "${query}" ничего не найдено.`;
  }

  return results
    .slice(0, 10)
    .map(
      (item) =>
        `[${item.entity}] ${item.title}`
    )
    .join("\n");
};

