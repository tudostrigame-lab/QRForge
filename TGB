  score: number;
  timestamp?: number;
  metadata?: Record<string, unknown>;
};

type NexusSearchOptions = {
  types?: NexusSearchEntityType[];
  limit?: number;
  minimumScore?: number;
};

type NexusSearchIndex = {
  chats: NexusChat[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  alarms?: NexusAlarm[];
  files: NexusFile[];
};

const NEXUS_SEARCH_MAX_RESULTS = 100;

/* -------------------------
   NORMALIZATION
   ------------------------- */

const nexusSearchNormalize = (
  value: string
): string => {
  return value
    .toLowerCase()
    .normalize("NFKC")
    .replace(/[^\p{L}\p{N}\s_-]/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
};

const nexusSearchTokens = (
  value: string
): string[] => {
  return [
    ...new Set(
      nexusSearchNormalize(value)
        .split(" ")
        .filter((token) => token.length > 0)
    )
  ];
};

/* -------------------------
   SCORING
   ------------------------- */

const nexusSearchScore = (
  query: string,
  text: string,
  title = ""
): number => {
  const normalizedQuery =
    nexusSearchNormalize(query);

  const normalizedText =
    nexusSearchNormalize(text);

  const normalizedTitle =
    nexusSearchNormalize(title);

  if (!normalizedQuery) {
    return 0;
  }

  if (
    normalizedTitle === normalizedQuery
  ) {
    return 1;
  }

  if (
    normalizedTitle.includes(
      normalizedQuery
    )
  ) {
    return 0.95;
  }

  if (
    normalizedText.includes(
      normalizedQuery
    )
  ) {
    return 0.85;
  }

  const queryTokens =
    nexusSearchTokens(query);

  const textTokens = new Set(
    nexusSearchTokens(
      `${title} ${text}`
    )
  );

  if (queryTokens.length === 0) {
    return 0;
  }

  let matched = 0;

  for (const token of queryTokens) {
    if (textTokens.has(token)) {
      matched++;
      continue;
    }

    for (const candidate of textTokens) {
      if (
        candidate.startsWith(token) ||
        token.startsWith(candidate)
      ) {
        matched += 0.5;
        break;
      }
    }
  }

  return Math.min(
    0.8,
    matched / queryTokens.length
  );
};

/* -------------------------
   RESULT CREATION
   ------------------------- */

const nexusSearchResult = (
  type: NexusSearchEntityType,
  id: string,
  title: string,
  text: string,
  query: string,
  timestamp?: number,
  metadata?: Record<string, unknown>
): NexusSearchResult | null => {
  const score = nexusSearchScore(
    query,
    text,
    title
  );

  if (score <= 0) {
    return null;
  }

  return {
    id,
    type,
    title,
    text,
    score,
    timestamp,
    metadata
  };
};

/* -------------------------
   CHATS
   ------------------------- */

const nexusSearchChats = (
  chats: NexusChat[],
  query: string
): NexusSearchResult[] => {
  const results: NexusSearchResult[] = [];

  for (const chat of chats) {
    const text = chat.messages
      .map((message) => message.content)
      .join(" ");

    const result = nexusSearchResult(
      "chat",
      chat.id,
      chat.title,
      text,
      query,
      chat.messages.at(-1)?.timestamp,
      {
        messageCount:
          chat.messages.length
      }
    );

    if (result) {
      results.push(result);
    }

    for (const message of chat.messages) {
      const messageResult =
        nexusSearchResult(
          "message",
          message.id,
          chat.title,
          message.content,
          query,
          message.timestamp,
          {
            chatId: chat.id,
            role: message.role
          }
        );

      if (messageResult) {
        results.push(messageResult);
      }
    }
  }

  return results;
};

