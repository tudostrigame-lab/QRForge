  | "app.started"
  | "app.ready"
  | "app.reset"
  | "chat.created"
  | "chat.deleted"
  | "chat.message"
  | "memory.added"
  | "memory.updated"
  | "memory.deleted"
  | "note.created"
  | "note.updated"
  | "note.deleted"
  | "task.created"
  | "task.updated"
  | "task.completed"
  | "task.deleted"
  | "calendar.created"
  | "calendar.updated"
  | "calendar.deleted"
  | "timer.created"
  | "timer.started"
  | "timer.paused"
  | "timer.completed"
  | "timer.deleted"
  | "file.created"
  | "file.updated"
  | "file.deleted"
  | "search.performed"
  | "settings.changed"
  | "notification.sent"
  | "ai.request"
  | "ai.response"
  | "ai.action"
  | "system.error";

type NexusEventPayload = Record<
  string,
  unknown
>;

type NexusEvent = {
  id: string;
  name: NexusEventName | string;
  timestamp: number;
  source: string;
  payload: NexusEventPayload;
};

type NexusEventListener = (
  event: NexusEvent
) => void;

type NexusEventSubscription = {
  id: string;
  eventName: string;
  unsubscribe: () => void;
};

type NexusEventBus = {
  emit: (
    name: NexusEventName | string,
    payload?: NexusEventPayload,
    source?: string
  ) => NexusEvent;

  on: (
    name: NexusEventName | string,
    listener: NexusEventListener
  ) => NexusEventSubscription;

  once: (
    name: NexusEventName | string,
    listener: NexusEventListener
  ) => NexusEventSubscription;

  off: (
    name: NexusEventName | string,
    listener: NexusEventListener
  ) => void;

  clear: (
    name?: NexusEventName | string
  ) => void;

  history: () => NexusEvent[];

  recent: (
    limit?: number
  ) => NexusEvent[];

  count: (
    name?: NexusEventName | string
  ) => number;
};

const nexusEventListeners =
  new Map<
    string,
    Set<NexusEventListener>
  >();

const nexusEventHistory: NexusEvent[] =
  [];

const nexusEventHistoryLimit = 500;

const nexusCreateEventId = (): string =>
  `evt_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 10)}`;

const nexusEmitEvent = (
  name: NexusEventName | string,
  payload: NexusEventPayload = {},
  source = "nexus"
): NexusEvent => {
  const event: NexusEvent = {
    id: nexusCreateEventId(),
    name,
    timestamp: Date.now(),
    source,
    payload
  };

  nexusEventHistory.push(event);

  if (
    nexusEventHistory.length >
    nexusEventHistoryLimit
  ) {
    nexusEventHistory.shift();
  }

  const listeners =
    nexusEventListeners.get(name);

  if (listeners) {
    [
      ...listeners
    ].forEach((listener) => {
      try {
        listener(event);
      } catch (error) {
        console.error(
          "NEXUS event listener error:",
          error
        );
      }
    });
  }

  const wildcardListeners =
    nexusEventListeners.get("*");

  if (wildcardListeners) {
    [
      ...wildcardListeners
    ].forEach((listener) => {
      try {
        listener(event);
      } catch (error) {
        console.error(
          "NEXUS wildcard listener error:",
          error
        );
      }
    });
  }

  return event;
};

const nexusSubscribeEvent = (
  name: NexusEventName | string,
  listener: NexusEventListener
): NexusEventSubscription => {
  if (
    !nexusEventListeners.has(name)
  ) {
    nexusEventListeners.set(
      name,
      new Set()
    );
  }

  nexusEventListeners
    .get(name)!
    .add(listener);

  let active = true;

  return {
    id: `sub_${Date.now()}_${Math.random()
      .toString(36)
      .slice(2, 8)}`,

    eventName: name,

    unsubscribe: () => {
      if (!active) {
        return;
      }

      active = false;

      nexusUnsubscribeEvent(
        name,
        listener
      );
    }
  };
};

const nexusSubscribeOnce = (
  name: NexusEventName | string,
  listener: NexusEventListener
): NexusEventSubscription => {
  let subscription:
    NexusEventSubscription;

  const wrapper: NexusEventListener =
    (event) => {
      listener(event);
      subscription.unsubscribe();
    };

  subscription =
    nexusSubscribeEvent(
      name,
      wrapper
    );

  return subscription;
};

const nexusUnsubscribeEvent = (
  name: NexusEventName | string,
  listener: NexusEventListener
) => {
  const listeners =
    nexusEventListeners.get(name);

  if (!listeners) {
    return;
  }

  listeners.delete(listener);

  if (listeners.size === 0) {
    nexusEventListeners.delete(name);
  }
};

const nexusClearEvents = (
  name?: NexusEventName | string
) => {
  if (name) {
    nexusEventListeners.delete(name);
    return;
  }

  nexusEventListeners.clear();
};

const nexusEventHistoryGet =
  (): NexusEvent[] =>
    [...nexusEventHistory];

const nexusRecentEvents = (
  limit = 20
): NexusEvent[] =>
  nexusEventHistory
    .slice(
      Math.max(
        0,
        nexusEventHistory.length -
          Math.max(1, limit)
      )
    )
    .reverse();

const nexusEventCount = (
  name?: NexusEventName | string
): number => {
  if (!name) {
    return nexusEventHistory.length;
  }

  return nexusEventHistory.filter(
    (event) =>
      event.name === name
  ).length;
};

/* -------------------------
   MODULE ORCHESTRATOR
   ------------------------- */

type NexusModuleStatus =
  | "registered"
  | "starting"
  | "ready"
  | "disabled"
  | "error";

type NexusRuntimeModule = {
  id: string;
  name: string;
  version: string;
  status: NexusModuleStatus;
  startedAt: number | null;
  error: string | null;
  dependencies: string[];
};

type NexusModuleStartFunction = () =>
  | void
  | Promise<void>;

const nexusRuntimeModules =
  new Map<
    string,
    NexusRuntimeModule
  >();

const nexusModuleStartHandlers =
  new Map<
    string,
    NexusModuleStartFunction
  >();

const nexusRegisterRuntimeModule = (
  module: NexusRuntimeModule,
  start?: NexusModuleStartFunction
) => {
  nexusRuntimeModules.set(
    module.id,
    {
      ...module
    }
  );

  if (start) {
    nexusModuleStartHandlers.set(
      module.id,
      start
    );
  }
};

const nexusGetRuntimeModules =
  (): NexusRuntimeModule[] =>
    Array.from(
      nexusRuntimeModules.values()
    );

const nexusGetRuntimeModule = (
  id: string
): NexusRuntimeModule | null =>
  nexusRuntimeModules.get(id) ??
  null;

const nexusSetModuleStatus = (
  id: string,
  status: NexusModuleStatus,
  error: string | null = null
) => {
  const module =
    nexusRuntimeModules.get(id);

  if (!module) {
    return;
  }

  module.status = status;
  module.error = error;

  if (status === "ready") {
    module.startedAt =
      module.startedAt ??
      Date.now();
  }
};

const nexusStartModule = async (
  id: string
): Promise<boolean> => {
  const module =
    nexusRuntimeModules.get(id);

  if (!module) {
    return false;
  }

  if (
    module.status === "ready"
  ) {
    return true;
  }

  for (
    const dependency of
    module.dependencies
  ) {
    const dependencyModule =
      nexusRuntimeModules.get(
        dependency
      );

    if (
      dependencyModule &&
      dependencyModule.status !==
        "ready"
    ) {
      const started =
        await nexusStartModule(
          dependency
        );

      if (!started) {
        nexusSetModuleStatus(
          id,
          "error",
          `Не удалось запустить зависимость: ${dependency}`
        );

        return false;
      }
    }
  }

  nexusSetModuleStatus(
    id,
    "starting"
  );

  try {
    const handler =
      nexusModuleStartHandlers.get(
        id
      );

    if (handler) {
      await handler();
    }

    nexusSetModuleStatus(
      id,
      "ready"
    );

    nexusEmitEvent(
      "app.ready",
      {
        moduleId: id
      },
      "module-orchestrator"
    );

    return true;
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : String(error);

    nexusSetModuleStatus(
      id,
      "error",
      message
    );

    nexusEmitEvent(
      "system.error",
      {
        moduleId: id,
        error: message
      },
      "module-orchestrator"
    );

    return false;
  }
};

const nexusStartAllModules =
  async (): Promise<{
    ready: string[];
    failed: string[];
  }> => {
    const ready: string[] = [];
    const failed: string[] = [];

    for (
      const module of
      nexusRuntimeModules.values()
    ) {
      const success =
        await nexusStartModule(
          module.id
        );

      if (success) {
        ready.push(module.id);
      } else {
        failed.push(module.id);
      }
    }

    nexusEmitEvent(
      "app.started",
      {
        ready,
        failed
      },
      "module-orchestrator"
    );

    return {
      ready,
      failed
    };
  };

const nexusDisableModule = (
  id: string
): boolean => {
  const module =
    nexusRuntimeModules.get(id);

  if (!module) {
    return false;
  }

  nexusSetModuleStatus(
    id,
    "disabled"
  );

  return true;
};

const nexusEnableModule = (
  id: string
): boolean => {
  const module =
    nexusRuntimeModules.get(id);

  if (!module) {
    return false;
  }

  if (
    module.status ===
    "disabled"
  ) {
    nexusSetModuleStatus(
      id,
      "registered"
    );
  }

  return true;
};

