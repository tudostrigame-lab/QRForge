/* -------------------------
   OFFLINE QUEUE
   ------------------------- */

type NexusQueuedRequest = {
  id: string;
  request: NexusAPIRequest;
  createdAt: number;
  attempts: number;
};

const nexusBackendQueue:
  NexusQueuedRequest[] =
  [];

const nexusQueueRequest = (
  request: NexusAPIRequest
): NexusQueuedRequest => {
  const queued: NexusQueuedRequest =
    {
      id:
        nexusCreateRequestId(),
      request:
        nexusClone(request),
      createdAt:
        Date.now(),
      attempts: 0
    };

  nexusBackendQueue.push(
    queued
  );

  return queued;
};

const nexusGetQueuedRequests =
  (): NexusQueuedRequest[] =>
    nexusClone(
      nexusBackendQueue
    );

const nexusRemoveQueuedRequest = (
  id: string
): boolean => {
  const index =
    nexusBackendQueue.findIndex(
      (item) =>
        item.id === id
    );

  if (index === -1) {
    return false;
  }

  nexusBackendQueue.splice(
    index,
    1
  );

  return true;
};

const nexusProcessBackendQueue =
  async (): Promise<{
    processed: number;
    failed: number;
  }> => {
    let processed = 0;
    let failed = 0;

    for (
      const item of [
        ...nexusBackendQueue
      ]
    ) {
      item.attempts++;

      const result =
        await nexusBackendRequest(
          item.request
        );

      if (result.success) {
        nexusRemoveQueuedRequest(
          item.id
        );

        processed++;
      } else {
        failed++;
      }
    }

    return {
      processed,
      failed
    };
  };

/* -------------------------
   RETRY WRAPPER
   ------------------------- */

const nexusBackendRequestWithRetry =
  async <
    T = unknown
  >(
    request: NexusAPIRequest,
    retries = 2
  ): Promise<
    NexusAPIResponse<T>
  > => {
    let lastResult:
      NexusAPIResponse<T> = {
      success: false,
      status: 0,
      data: null,
      error:
        "Request failed.",
      duration: 0
    };

    for (
      let attempt = 0;
      attempt <= retries;
      attempt++
    ) {
      lastResult =
        await nexusBackendRequest<T>(
          request
        );

      if (
        lastResult.success
      ) {
        return lastResult;
      }

      if (
        attempt < retries
      ) {
        await new Promise(
          (resolve) =>
            setTimeout(
              resolve,
              500 *
                (attempt + 1)
            )
        );
      }
    }

    return lastResult;
  };

