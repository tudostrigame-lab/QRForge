type NexusConversationMode =
  | "local"
  | "backend"
  | "hybrid";

type NexusConversationRequest = {
  message: string;
  chatId?: string;
  mode?: NexusConversationMode;
  useMemory?: boolean;
  useStyle?: boolean;
  useActions?: boolean;
};

type NexusConversationResult = {
  success: boolean;
  text: string;
  mode: NexusConversationMode;
  actionExecuted: boolean;
  actionResult: unknown | null;
  requestId: string;
  error: string | null;
};

type NexusConversationContext = {
  message: string;
  chat: NexusChat | null;
  memories: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  styleInstruction: string;
};

const nexusConversationHistory:
  NexusConversationResult[] = [];

const nexusConversationHistoryLimit =
  100;

/* -------------------------
   CONTEXT BUILDER
   ------------------------- */

const nexusBuildConversationContext =
  (
    request: NexusConversationRequest
  ): NexusConversationContext => {
    const state =
      nexusStateGet();

    let chat:
      NexusChat | null = null;

    if (request.chatId) {
      chat =
        state.chats.find(
          (item) =>
            item.id ===
            request.chatId
        ) ?? null;
    }

    let memories =
      state.memory;

    if (
      request.useMemory !== false
    ) {
      const normalized =
        request.message
          .toLowerCase()
          .trim();

      memories =
        state.memory.filter(
          (item) =>
            item.text
              .toLowerCase()
              .includes(
                normalized
              ) ||
            normalized
              .split(/\s+/)
              .some(
                (word) =>
                  word.length >
                    2 &&
                  item.text
                    .toLowerCase()
                    .includes(
                      word
                    )
              )
        );

      if (
        memories.length === 0
      ) {
        memories =
          state.memory.slice(
            -20
          );
      }
    } else {
      memories = [];
    }

    let styleInstruction =
      "";

    if (
      request.useStyle !==
      false
    ) {
      try {
        const style =
          nexusStyleGetProfile();

        if (style) {
          styleInstruction =
            nexusBuildStyleInstruction(
              style
            );
        }
      } catch {
        styleInstruction =
          "";
      }
    }

    return {
      message:
        request.message,

      chat,

      memories:
        memories.slice(
          -30
        ),

      notes:
        state.notes.slice(
          -20
        ),

      tasks:
        state.tasks.slice(
          -20
        ),

      events:
        state.events.slice(
          -20
        ),

      timers:
        state.timers.slice(
          -10
        ),

      styleInstruction
    };
  };

/* -------------------------
   CONTEXT TEXT
   ------------------------- */

const nexusContextToText =
  (
    context: NexusConversationContext
  ): string => {
    const sections: string[] =
      [];

    if (
      context.memories.length
    ) {
      sections.push(
        "ПАМЯТЬ:\n" +
          context.memories
            .map(
              (item) =>
                `- ${item.text}`
            )
            .join("\n")
      );
    }

    if (
      context.notes.length
    ) {
      sections.push(
        "ЗАМЕТКИ:\n" +
          context.notes
            .map(
              (note) =>
                `- ${note.title}: ${note.content}`
            )
            .join("\n")
      );
    }

    if (
      context.tasks.length
    ) {
      sections.push(
        "ЗАДАЧИ:\n" +
          context.tasks
            .map(
              (task) =>
                `- ${task.title} — ${
                  task.completed
                    ? "выполнено"
                    : "активна"
                }`
            )
            .join("\n")
      );
    }

    if (
      context.events.length
    ) {
      sections.push(
        "КАЛЕНДАРЬ:\n" +
          context.events
            .map(
              (event) =>
                `- ${event.date} ${event.time}: ${event.title}`
            )
            .join("\n")
      );
    }

    if (
      context.timers.length
    ) {
      sections.push(
        "ТАЙМЕРЫ:\n" +
          context.timers
            .map(
              (timer) =>
                `- ${timer.name}: ${timer.remaining} сек.`
            )
            .join("\n")
      );
    }

    if (
      context.styleInstruction
    ) {
      sections.push(
        "СТИЛЬ ПОЛЬЗОВАТЕЛЯ:\n" +
          context.styleInstruction
      );
    }

    return sections.join(
      "\n\n"
    );
  };

/* -------------------------
   MODE SELECTION
   ------------------------- */

const nexusSelectConversationMode =
  (
    request: NexusConversationRequest
  ): NexusConversationMode => {
    if (
      request.mode
    ) {
      return request.mode;
    }

    if (
      typeof window ===
      "undefined"
    ) {
      return "backend";
    }

    if (
      nexusBackendGetConfig()
        .enabled
    ) {
      return "hybrid";
    }

    return "local";
  };

/* -------------------------
   ACTION DETECTION
   ------------------------- */

const nexusDetectConversationAction =
  (
    message: string
  ): NexusAIActionRequest | null => {
    if (
      !message.trim()
    ) {
      return null;
    }

    return nexusParseAIActionCommand(
      message
    );
  };

/* -------------------------
   LOCAL RESPONSE
   ------------------------- */

const nexusGenerateConversationFallback =
  (
    message: string,
    context: NexusConversationContext
  ): string => {
    const lower =
      message
        .toLowerCase()
        .trim();

    if (
      /^(привет|здравствуй|здравствуйте|хай|hello|hi)\b/.test(
        lower
      )
    ) {
      return "Привет! Я NEXUS. Чем займёмся?";
    }

    if (
      lower.includes(
        "который час"
      ) ||
      lower.includes(
        "сколько времени"
      )
    ) {
      return `Сейчас ${new Date().toLocaleTimeString(
        "ru-RU",
        {
          hour: "2-digit",
          minute: "2-digit"
        }
      )}.`;
    }

    if (
      lower.includes(
        "какая сегодня дата"
      ) ||
      lower.includes(
        "какое сегодня число"
      )
    ) {
      return `Сегодня ${new Date().toLocaleDateString(
        "ru-RU"
      )}.`;
    }

    if (
      lower.includes(
        "что ты помнишь"
      )
    ) {
      if (
        context.memories.length ===
        0
      ) {
        return "Пока в памяти ничего подходящего нет.";
      }

      return (
        "Вот что я нашёл в памяти:\n" +
        context.memories
          .slice(-10)
          .map(
            (item) =>
              `• ${item.text}`
          )
          .join("\n")
      );
    }

    if (
      lower.includes(
        "мои задачи"
      )
    ) {
      const active =
        context.tasks.filter(
          (task) =>
            !task.completed
        );

      if (
        active.length === 0
      ) {
        return "Активных задач сейчас нет.";
      }

      return (
        "Активные задачи:\n" +
        active
          .slice(0, 10)
          .map(
            (task) =>
              `• ${task.title}`
          )
          .join("\n")
      );
    }

    if (
      lower.includes(
        "мои заметки"
      )
    ) {
      if (
        context.notes.length ===
        0
      ) {
        return "Заметок пока нет.";
      }

      return (
        "Последние заметки:\n" +
        context.notes
          .slice(-10)
          .map(
            (note) =>
              `• ${note.title}`
          )
          .join("\n")
      );
    }

    return (
      "Я понял сообщение. " +
      "Сейчас локальный режим может ответить не на все запросы, " +
      "а серверный AI подключается через backend."
    );
  };

/* -------------------------
   BACKEND RESPONSE
   ------------------------- */

const nexusTryBackendConversation =
  async (
    request: NexusConversationRequest,
    context: NexusConversationContext
  ): Promise<
    NexusAPIResponse<NexusAIBackendResponse>
  > => {
    if (
      !nexusBackendGetConfig()
        .enabled
    ) {
      return {
        success: false,
        status: 0,
        data: null,
        error:
          "Backend disabled.",
        duration: 0
      };
    }

    const conversation =
      context.chat?.messages ??
      [];

    const contextText =
      nexusContextToText(
        context
      );

    return nexusBackendAIRequest({
      message:
        request.message,

      conversation:
        conversation as NexusMessage[],

      context:
        contextText,

      instructions:
        [
          "Ты NEXUS — персональный AI-помощник.",
          "Отвечай естественно.",
          "Адаптируй стиль общения под пользователя.",
          "Не придумывай факты о пользователе.",
          context.styleInstruction
        ]
          .filter(Boolean)
          .join("\n")
    });
  };

/* -------------------------
   MAIN CONVERSATION ENGINE
   ------------------------- */

const nexusProcessConversation =
  async (
    request: NexusConversationRequest
  ): Promise<NexusConversationResult> => {
    const requestId =
      nexusCreateRequestId();

    const mode =
      nexusSelectConversationMode(
        request
      );

    const context =
      nexusBuildConversationContext(
        request
      );

    nexusEmitEvent(
      "ai.request",
      {
        requestId,
        message:
          request.message,
        mode
      },
      "conversation-orchestrator"
    );

    let actionExecuted =
      false;

    let actionResult:
      unknown | null = null;

    if (
      request.useActions !==
      false
    ) {
      const action =
        nexusDetectConversationAction(
          request.message
        );

      if (action) {
        const result =
          await nexusExecuteAIAction(
            action
          );

        actionExecuted =
          result.success;

        actionResult =
          result.execution;

        if (
          result.success
        ) {
          const text =
            `Готово. ${result.message}`;

          const finalResult:
            NexusConversationResult =
            {
              success: true,
              text,
              mode,
              actionExecuted:
                true,
              actionResult,
              requestId,
              error: null
            };

          nexusStoreConversationResult(
            finalResult
          );

          return finalResult;
        }
      }
    }

    if (
      mode === "backend" ||
      mode === "hybrid"
    ) {
      const backend =
        await nexusTryBackendConversation(
          request,
          context
        );

      if (
        backend.success &&
        backend.data
      ) {
        const result:
          NexusConversationResult =
          {
            success: true,
            text:
              backend.data.text,
            mode,
            actionExecuted,
            actionResult,
            requestId,
            error: null
          };

        nexusStoreConversationResult(
          result
        );

        nexusEmitEvent(
          "ai.response",
          {
            requestId,
            text:
              result.text
          },
          "conversation-orchestrator"
        );

        return result;
      }

      if (
        mode === "backend"
      ) {
        const result:
          NexusConversationResult =
          {
            success: false,
            text:
              nexusGenerateConversationFallback(
                request.message,
                context
              ),
            mode,
            actionExecuted,
            actionResult,
            requestId,
            error:
              backend.error ??
              "Backend request failed."
          };

        nexusStoreConversationResult(
          result
        );

        return result;
      }
    }

    const localText =
      nexusGenerateConversationFallback(
        request.message,
        context
      );

    const result:
      NexusConversationResult =
      {
        success: true,
        text: localText,
        mode: "local",
        actionExecuted,
        actionResult,
        requestId,
        error: null
      };

    nexusStoreConversationResult(
      result
    );

    nexusEmitEvent(
      "ai.response",
      {
        requestId,
        text:
          result.text
      },
      "conversation-orchestrator"
    );

    return result;
  };

/* -------------------------
