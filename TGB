const nexusProductivityBuildAISummary = (
  notes: NexusNote[],
  tasks: NexusTask[],
  events: NexusCalendarEvent[],
  currentDate = nexusDateKey(new Date())
): string => {
  const overview = nexusProductivityTodayOverview(
    notes,
    tasks,
    events,
    currentDate
  );

  const lines: string[] = [];

  lines.push(`Дата: ${overview.date}`);

  if (overview.tasks.length > 0) {
    lines.push("Задачи на сегодня:");

    overview.tasks.forEach((task) => {
      lines.push(
        `- ${task.title}${
          task.dueTime
            ? ` (${task.dueTime})`
            : ""
        }`
      );
    });
  } else {
    lines.push("Задач на сегодня нет.");
  }

  if (overview.overdueTasks.length > 0) {
    lines.push("Просроченные задачи:");

    overview.overdueTasks.forEach((task) => {
      lines.push(`- ${task.title}`);
    });
  }

  if (overview.events.length > 0) {
    lines.push("События сегодня:");

    overview.events.forEach((event) => {
      lines.push(
        `- ${event.title}${
          event.time
            ? ` (${event.time})`
            : ""
        }`
      );
    });
  } else {
    lines.push("Событий на сегодня нет.");
  }

  if (overview.notes.length > 0) {
    lines.push("Последние заметки:");

    overview.notes.forEach((note) => {
      lines.push(`- ${note.title}`);
    });
  }

  return lines.join("\n");
};

