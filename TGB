const nexusProfileImport = (
  value: string
): NexusUserProfile | null => {
  try {
    const parsed =
      JSON.parse(value);

    if (
      !parsed ||
      typeof parsed !== "object"
    ) {
      return null;
    }

    return {
      version:
        Number(
          parsed.version
        ) ||
        NEXUS_PROFILE_VERSION,
      fields:
        Array.isArray(
          parsed.fields
        )
          ? parsed.fields
          : [],
      learning:
        Array.isArray(
          parsed.learning
        )
          ? parsed.learning
          : [],
    };
  } catch {
    return null;
  }
};

