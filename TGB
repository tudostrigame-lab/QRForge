    },
  ];

  for (const check of checks) {
    if (
      check.words.some(
        (word) =>
          normalized.includes(word)
      )
    ) {
      return {
        type: check.type,
        confidence:
          check.confidence,
      };
    }
  }

  return {
    type: "chat",
    confidence: 0.4,
  };
};

const nexusParseCommand = (
  raw: string
): NexusParsedCommand => {
  const text =
    nexusCommandClean(raw);

  if (!text) {
    return nexusCommandEmpty(
      raw
    );
  }

  const detected =
    nexusCommandDetectType(
      text
    );

  const result =
    nexusCommandEmpty(
      raw
    );

  result.type =
    detected.type;

  result.confidence =
    detected.confidence;

  if (
    detected.type ===
    "remember"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^запомни\s+что\s+(.+)$/i,
          /^запомни\s+(.+)$/i,
          /^помни\s+(.+)$/i,
          /^remember\s+that\s+(.+)$/i,
          /^remember\s+(.+)$/i,
        ]
      );

    if (!result.value) {
      result.value =
        text;
    }
  }

  if (
    detected.type ===
    "forget"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^забудь\s+(.+)$/i,
          /^забыть\s+(.+)$/i,
          /^forget\s+(.+)$/i,
        ]
      );

    if (!result.value) {
      result.value =
        text;
    }
  }

  if (
    detected.type ===
    "note"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^заметка\s*:?\s*(.+)$/i,
          /^заметку\s*:?\s*(.+)$/i,
          /^создай заметку\s*:?\s*(.+)$/i,
          /^добавь заметку\s*:?\s*(.+)$/i,
          /^запиши\s*:?\s*(.+)$/i,
          /^note\s*:?\s*(.+)$/i,
          /^create a note\s*:?\s*(.+)$/i,
        ]
      );

    result.title =
      result.value ||
      "Новая заметка";
  }

  if (
    detected.type ===
    "task"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^задача\s*:?\s*(.+)$/i,
          /^задачу\s*:?\s*(.+)$/i,
          /^создай задачу\s*:?\s*(.+)$/i,
          /^добавь задачу\s*:?\s*(.+)$/i,
          /^поставь задачу\s*:?\s*(.+)$/i,
          /^task\s*:?\s*(.+)$/i,
          /^create a task\s*:?\s*(.+)$/i,
        ]
      );

    result.title =
      result.value ||
      "Новая задача";

    result.date =
      nexusCommandExtractDate(
        text
      );

    result.time =
      nexusCommandExtractTime(
        text
      );
  }

  if (
    detected.type ===
    "calendar"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^событие\s*:?\s*(.+)$/i,
          /^создай событие\s*:?\s*(.+)$/i,
          /^добавь событие\s*:?\s*(.+)$/i,
          /^запланируй\s*:?\s*(.+)$/i,
          /^встреча\s*:?\s*(.+)$/i,
          /^event\s*:?\s*(.+)$/i,
          /^create event\s*:?\s*(.+)$/i,
        ]
      );

    result.title =
      result.value ||
      "Новое событие";

    result.date =
      nexusCommandExtractDate(
        text
      );

    result.time =
      nexusCommandExtractTime(
        text
      );
  }

  if (
    detected.type ===
    "timer"
  ) {
    const duration =
      nexusCommandParseDuration(
        text
      );

    result.minutes =
      duration.minutes;

    result.seconds =
      duration.seconds;

    result.value =
      text
        .replace(
          /поставь таймер|запусти таймер|создай таймер|таймер/gi,
          ""
        )
        .trim();

    if (!result.value) {
      result.value =
        "Таймер";
    }
  }

  if (
    detected.type ===
    "file"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^найди файл\s*:?\s*(.+)$/i,
          /^найди документ\s*:?\s*(.+)$/i,
          /^покажи файл\s*:?\s*(.+)$/i,
          /^поиск файлов\s*:?\s*(.+)$/i,
          /^search files\s*:?\s*(.+)$/i,
        ]
      );
  }

  if (
    detected.type ===
    "memory"
  ) {
    result.value =
      nexusCommandExtractAfter(
        text,
        [
          /^найди в памяти\s*:?\s*(.+)$/i,
          /^память\s*:?\s*(.+)$/i,
          /^search memory\s*:?\s*(.+)$/i,
        ]
      );
  }

  return result;
};

const nexusCommandToIntent = (
  command: NexusParsedCommand
): NexusIntent => {
  const map:
    Record<
      NexusCommandType,
      NexusIntentType
    > = {
    remember: "remember",
    forget: "forget",
    note: "note_create",
    task: "task_create",
    calendar: "calendar_create",
    timer: "timer_create",
    file: "file_search",
    memory: "memory_search",
    help: "help",
    chat: "chat",
  };

  const parameters:
    Record<string, string> = {};

  if (command.value) {
    parameters.content =
      command.value;
    parameters.query =
      command.value;
  }

  if (command.title) {
    parameters.title =
      command.title;
  }

  if (command.date) {
    parameters.date =
      command.date;
  }

  if (command.time) {
    parameters.time =
      command.time;
  }

  if (command.minutes > 0) {
    parameters.minutes =
      String(command.minutes);
  }

  if (command.seconds > 0) {
    parameters.seconds =
      String(command.seconds);
  }

  return {
    type: map[command.type],
    confidence:
      command.confidence,
    text: command.raw,
    parameters,
  };
};

const nexusCommandIsAction = (
  command: NexusParsedCommand
): boolean => {
  return (
    command.type !== "chat" &&
    command.type !== "help" &&
    command.confidence >= 0.5
  );
};

