type NexusValidationSeverity =
  | "info"
  | "warning"
  | "error"
  | "critical";

type NexusValidationEntity =
  | "chat"
  | "message"
  | "memory"
  | "note"
  | "task"
  | "calendar"
  | "timer"
  | "file"
  | "settings"
  | "system";

type NexusValidationIssue = {
  id: string;
  entity: NexusValidationEntity;
  entityId?: string;
  severity: NexusValidationSeverity;
  code: string;
  message: string;
  field?: string;
  createdAt: number;
  repairable: boolean;
};

type NexusValidationReport = {
  valid: boolean;
  checkedAt: number;
  issues: NexusValidationIssue[];
  statistics: {
    chats: number;
    messages: number;
    memories: number;
    notes: number;
    tasks: number;
    events: number;
    timers: number;
    files: number;
    folders: number;
  };
};

const nexusValidationId = (
  entity: NexusValidationEntity,
  entityId: string | undefined,
  code: string
) =>
  `validation_${entity}_${entityId ?? "system"}_${code}_${Date.now()}_${Math.random()
    .toString(36)
    .slice(2, 8)}`;

const nexusValidationIssue = (
  entity: NexusValidationEntity,
  code: string,
  message: string,
  options?: {
    entityId?: string;
    severity?: NexusValidationSeverity;
    field?: string;
    repairable?: boolean;
  }
): NexusValidationIssue => ({
  id: nexusValidationId(entity, options?.entityId, code),
  entity,
  entityId: options?.entityId,
  severity: options?.severity ?? "error",
  code,
  message,
  field: options?.field,
  createdAt: Date.now(),
  repairable: options?.repairable ?? false,
});

const nexusIsNonEmptyString = (value: unknown): value is string =>
  typeof value === "string" && value.trim().length > 0;

const nexusIsPositiveNumber = (value: unknown): value is number =>
  typeof value === "number" && Number.isFinite(value) && value >= 0;

const nexusIsValidTimestamp = (value: unknown): value is number =>
  typeof value === "number" &&
  Number.isFinite(value) &&
  value > 0;

const nexusUniqueIds = <T extends { id: string }>(
  items: T[],
  entity: NexusValidationEntity
): NexusValidationIssue[] => {
  const issues: NexusValidationIssue[] = [];
  const seen = new Set<string>();

  for (const item of items) {
    if (!nexusIsNonEmptyString(item.id)) {
      issues.push(
        nexusValidationIssue(
          entity,
          "MISSING_ID",
          `${entity} has an invalid or missing ID.`,
          {
            severity: "critical",
            repairable: true,
          }
        )
      );
      continue;
    }

    if (seen.has(item.id)) {
      issues.push(
        nexusValidationIssue(
          entity,
          "DUPLICATE_ID",
          `${entity} contains a duplicate ID.`,
          {
            entityId: item.id,
            severity: "critical",
            repairable: true,
          }
        )
      );
    }

    seen.add(item.id);
  }

  return issues;
};

const nexusValidateMessages = (
  chats: NexusChat[]
): NexusValidationIssue[] => {
  const issues: NexusValidationIssue[] = [];

  for (const chat of chats) {
    if (!Array.isArray(chat.messages)) {
      issues.push(
        nexusValidationIssue(
          "chat",
          "INVALID_MESSAGES",
          "Chat messages must be an array.",
          {
            entityId: chat.id,
            severity: "critical",
            field: "messages",
            repairable: true,
          }
        )
      );
      continue;
    }

    for (const message of chat.messages) {
      if (!nexusIsNonEmptyString(message.id)) {
        issues.push(
          nexusValidationIssue(
            "message",
            "MISSING_ID",
            "Message has no valid ID.",
            {
              entityId: chat.id,
              severity: "error",
              field: "id",
              repairable: true,
            }
          )
        );
      }

      if (
        message.role !== "user" &&
        message.role !== "assistant" &&
        message.role !== "system"
      ) {
        issues.push(
          nexusValidationIssue(
            "message",
            "INVALID_ROLE",
            "Message contains an invalid role.",
            {
              entityId: message.id,
              severity: "error",
              field: "role",
              repairable: true,
            }
          )
        );
      }

      if (!nexusIsNonEmptyString(message.content)) {
        issues.push(
          nexusValidationIssue(
            "message",
            "EMPTY_CONTENT",
            "Message contains empty content.",
            {
              entityId: message.id,
              severity: "warning",
              field: "content",
              repairable: true,
            }
          )
        );
      }

      if (!nexusIsValidTimestamp(message.createdAt)) {
        issues.push(
          nexusValidationIssue(
            "message",
            "INVALID_TIMESTAMP",
            "Message has an invalid timestamp.",
            {
              entityId: message.id,
              severity: "warning",
              field: "createdAt",
              repairable: true,
            }
          )
        );
      }
    }
  }

  return issues;
};

const nexusValidateMemory = (
  memory: NexusMemoryItem[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(memory, "memory");

  for (const item of memory) {
    if (!nexusIsNonEmptyString(item.content)) {
      issues.push(
        nexusValidationIssue(
          "memory",
          "EMPTY_CONTENT",
          "Memory item contains no content.",
          {
            entityId: item.id,
            severity: "warning",
            field: "content",
            repairable: true,
          }
        )
      );
    }

    if (!nexusIsValidTimestamp(item.createdAt)) {
      issues.push(
        nexusValidationIssue(
          "memory",
          "INVALID_TIMESTAMP",
          "Memory item has an invalid creation time.",
          {
            entityId: item.id,
            severity: "warning",
            field: "createdAt",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateNotes = (
  notes: NexusNote[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(notes, "note");

  for (const note of notes) {
    if (!nexusIsNonEmptyString(note.title)) {
      issues.push(
        nexusValidationIssue(
