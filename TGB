const nexusStyleMergeProfiles = (
  oldProfile: NexusUserStyleProfile,
  newProfile: NexusUserStyleProfile
): NexusUserStyleProfile => {
  const oldCount =
    oldProfile.messageCount;

  const newCount =
    newProfile.messageCount;

  if (oldCount === 0) {
    return {
      ...newProfile
    };
  }

  if (newCount === 0) {
    return {
      ...oldProfile
    };
  }

  const total =
    oldCount + newCount;

  const weighted = (
    oldValue: number,
    newValue: number
  ) =>
    (
      oldValue * oldCount +
      newValue * newCount
    ) / total;

  const averageLength =
    weighted(
      oldProfile.averageMessageLength,
      newProfile.averageMessageLength
    );

  const averageWords =
    weighted(
      oldProfile.averageWordCount,
      newProfile.averageWordCount
    );

  const chooseLength =
    averageLength < 100
      ? "short"
      : averageLength > 300
      ? "long"
      : "medium";

  return {
    messageCount:
      total,

    averageMessageLength:
      Math.round(
        averageLength
      ),

    averageWordCount:
      Math.round(
        averageWords
      ),

    shortMessageRatio:
      weighted(
        oldProfile.shortMessageRatio,
        newProfile.shortMessageRatio
      ),

    longMessageRatio:
      weighted(
        oldProfile.longMessageRatio,
        newProfile.longMessageRatio
      ),

    questionRatio:
      weighted(
        oldProfile.questionRatio,
        newProfile.questionRatio
      ),

    commandRatio:
      weighted(
        oldProfile.commandRatio,
        newProfile.commandRatio
      ),

    emojiRatio:
      weighted(
        oldProfile.emojiRatio,
        newProfile.emojiRatio
      ),

    punctuationRatio:
      weighted(
        oldProfile.punctuationRatio,
        newProfile.punctuationRatio
      ),

    preferredResponseLength:
      chooseLength,

    preferredTone:
