const nexusLanguageAliases: Record<string, NexusLanguageCode> = {
  en: "en",
  eng: "en",
  english: "en",

  es: "es",
  spa: "es",
  spanish: "es",
  español: "es",
  espanol: "es",

  fr: "fr",
  fra: "fr",
  french: "fr",
  français: "fr",
  francais: "fr",

  ja: "ja",
  jap: "ja",
  japanese: "ja",
  日本語: "ja",
};

function nexusNormalizeLanguage(
  value?: string | null
): NexusLanguageCode {
  if (!value) {
    return "en";
  }

  const normalized = value
    .trim()
    .toLowerCase()
    .replace("_", "-");

  const shortCode = normalized.split("-")[0];

  return (
    nexusLanguageAliases[normalized] ??
    nexusLanguageAliases[shortCode] ??
    "en"
  );
}

function nexusGetLanguagePack(
  language?: string | null
): NexusLanguagePack {
  const code = nexusNormalizeLanguage(language);
  return nexusLanguagePacks[code];
}

function nexusTranslate(
  key: string,
  language?: string | null,
  fallback?: string
): string {
  const pack = nexusGetLanguagePack(language);

  return (
    pack.translations[key] ??
    fallback ??
    nexusLanguagePacks.en.translations[key] ??
    key
  );
}

function nexusCreateTranslator(
  language?: string | null
): (key: string, fallback?: string) => string {
  return (
    key: string,
    fallback?: string
  ) => nexusTranslate(key, language, fallback);
}

function nexusListLanguages(): NexusLanguagePack[] {
  return Object.values(nexusLanguagePacks);
}

function nexusIsSupportedLanguage(
  language?: string | null
): boolean {
  if (!language) {
    return false;
  }

  const normalized = language
    .trim()
    .toLowerCase();

  return Boolean(
    nexusLanguageAliases[normalized] ||
      nexusLanguageAliases[normalized.split("-")[0]]
  );
}

function nexusDetectLanguageFromText(
  text: string
): NexusLanguageCode {
  const value = text.trim();

  if (!value) {
    return "en";
  }

  const japanesePattern =
    /[\u3040-\u30ff\u3400-\u9fff]/;

  if (japanesePattern.test(value)) {
    return "ja";
  }

  const spanishPattern =
    /[¿¡]|(?:\b(?:hola|gracias|cómo|como|quiero|puedo|para|que|qué|dónde|donde|mañana|hoy)\b)/i;

  if (spanishPattern.test(value)) {
    return "es";
  }

  const frenchPattern =
    /(?:\b(?:bonjour|merci|comment|avec|pour|dans|je|vous|être|être|aujourd'hui)\b)|[àâçéèêëîïôûùüÿœæ]/i;

  if (frenchPattern.test(value)) {
    return "fr";
  }

  return "en";
}

function nexusGetLocalizedDate(
  date: Date,
  language?: string | null,
  options?: Intl.DateTimeFormatOptions
): string {
  const localeMap: Record<NexusLanguageCode, string> = {
    en: "en-US",
    es: "es-ES",
    fr: "fr-FR",
    ja: "ja-JP",
  };

  const code = nexusNormalizeLanguage(language);

  return new Intl.DateTimeFormat(
    localeMap[code],
    options ?? {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  ).format(date);
}

function nexusGetLocalizedTime(
  date: Date,
  language?: string | null
): string {
  const localeMap: Record<NexusLanguageCode, string> = {
    en: "en-US",
    es: "es-ES",
    fr: "fr-FR",
    ja: "ja-JP",
  };

  const code = nexusNormalizeLanguage(language);

  return new Intl.DateTimeFormat(
    localeMap[code],
    {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    }
  ).format(date);
}

function nexusLocalizeNavigation(
  language?: string | null
): Record<string, string> {
  const keys = [
    "chat",
    "memory",
    "notes",
    "tasks",
    "calendar",
    "clock",
    "files",
    "settings",
    "search",
  ];

  return keys.reduce(
    (
      result: Record<string, string>,
      key: string
    ) => {
      result[key] = nexusTranslate(key, language);
      return result;
    },
    {}
  );
}

function nexusBuildLanguageContext(
  language?: string | null
): string {
  const pack = nexusGetLanguagePack(language);

  return [
    `NEXUS interface language: ${pack.name}`,
    `Native language name: ${pack.nativeName}`,
    `Language code: ${pack.code}`,
    "Respond naturally in the user's selected language when appropriate.",
    "Do not translate proper names unnecessarily.",
  ].join("\n");
}

function nexusResolveResponseLanguage(
  userMessage: string,
  selectedLanguage?: string | null
): NexusLanguageCode {
  const detected = nexusDetectLanguageFromText(userMessage);

  if (
    detected !== "en" ||
    !selectedLanguage
  ) {
    return detected;
  }

  return nexusNormalizeLanguage(selectedLanguage);
}

function nexusGetLanguageLabel(
  language: string
): string {
  return nexusGetLanguagePack(language).nativeName;
}

function nexusTranslateMany(
  keys: string[],
  language?: string | null
): Record<string, string> {
  return keys.reduce(
    (
      result: Record<string, string>,
      key: string
    ) => {
      result[key] = nexusTranslate(key, language);
      return result;
    },
    {}
  );
}
