/* -------------------------
   GENERIC API REQUEST
   ------------------------- */

const nexusBackendRequest = async <
  T = unknown
>(
  request: NexusAPIRequest
): Promise<
  NexusAPIResponse<T>
> => {
  const startedAt =
    Date.now();

  if (
    !nexusBackendConfig.enabled
  ) {
    return {
      success: false,
      status: 0,
      data: null,
      error:
        "Backend отключён.",
      duration:
        Date.now() -
        startedAt
    };
  }

  const controller =
    typeof AbortController !==
    "undefined"
      ? new AbortController()
      : null;

  let timeoutId:
    ReturnType<
      typeof setTimeout
    > | null = null;

  if (
    controller &&
    nexusBackendConfig.timeout >
      0
  ) {
    timeoutId =
      setTimeout(
        () =>
          controller.abort(),
        nexusBackendConfig.timeout
      );
  }

  const headers: Record<
    string,
    string
  > = {
    "Content-Type":
      "application/json",
    "X-NEXUS-Client":
      "web"
  };

  Object.assign(
    headers,
    request.headers ?? {}
  );

  try {
    const endpoint =
      request.endpoint.startsWith(
        "http"
      )
        ? request.endpoint
        : `${nexusBackendConfig.baseUrl}${request.endpoint.startsWith("/") ? "" : "/"}${request.endpoint}`;

    const response =
      await fetch(
        endpoint,
        {
          method:
            request.method,
          headers,
          body:
            request.method ===
              "GET" ||
            request.method ===
              "DELETE"
              ? undefined
              : JSON.stringify(
                  request.body ??
                    {}
                ),
          signal:
            controller?.signal
        }
      );

    let data:
      T | null = null;

    try {
      data =
        (await response.json()) as T;
    } catch {
      data = null;
    }

    if (!response.ok) {
      return {
        success: false,
        status:
          response.status,
        data,
        error:
          `HTTP ${response.status}`,
        duration:
          Date.now() -
          startedAt
      };
    }

    return {
      success: true,
      status:
        response.status,
      data,
      error: null,
      duration:
        Date.now() -
        startedAt
    };
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : String(error);

    return {
      success: false,
      status: 0,
      data: null,
      error: message,
      duration:
        Date.now() -
        startedAt
    };
  } finally {
    if (timeoutId) {
      clearTimeout(
        timeoutId
      );
    }
  }
};

