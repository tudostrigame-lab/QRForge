  repeat: "once" | "daily" | "weekdays" | "weekends";
  createdAt: number;
  lastTriggeredAt?: number;
};

type NexusClockState = {
  timestamp: number;
  date: string;
  time: string;
  seconds: number;
  timezone: string;
  format: NexusClockFormat;
};

type NexusClockEvent = {
  id: string;
  type:
    | "timer-created"
    | "timer-started"
    | "timer-paused"
    | "timer-finished"
    | "timer-deleted"
    | "alarm-created"
    | "alarm-triggered"
    | "alarm-disabled";
  entityId: string;
  timestamp: number;
};

const NEXUS_CLOCK_EVENTS: NexusClockEvent[] = [];

const nexusClockRecord = (
  type: NexusClockEvent["type"],
  entityId: string
) => {
  const event: NexusClockEvent = {
    id: nexusId(),
    type,
    entityId,
    timestamp: Date.now()
  };

  NEXUS_CLOCK_EVENTS.push(event);

  if (NEXUS_CLOCK_EVENTS.length > 500) {
    NEXUS_CLOCK_EVENTS.shift();
  }

  return event;
};

/* -------------------------
   CLOCK
   ------------------------- */

const nexusClockGetState = (
  timestamp = Date.now(),
  format: NexusClockFormat = "24h"
): NexusClockState => {
  const date = new Date(timestamp);

  return {
    timestamp,
    date: nexusDateKey(date),
    time: nexusTime(date),
    seconds: date.getSeconds(),
    timezone:
      Intl.DateTimeFormat().resolvedOptions().timeZone,
    format
  };
};

const nexusClockFormatTime = (
  timestamp: number,
  format: NexusClockFormat = "24h"
): string => {
  const date = new Date(timestamp);

  return new Intl.DateTimeFormat(undefined, {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: format === "12h"
  }).format(date);
};

const nexusClockFormatDate = (
  timestamp: number
): string => {
  return new Intl.DateTimeFormat(undefined, {
    day: "2-digit",
    month: "long",
    year: "numeric"
  }).format(new Date(timestamp));
};

const nexusClockIsSameDay = (
  firstTimestamp: number,
  secondTimestamp: number
): boolean => {
  return (
    nexusDateKey(new Date(firstTimestamp)) ===
    nexusDateKey(new Date(secondTimestamp))
  );
};

/* -------------------------
   TIMERS
   ------------------------- */

const nexusClockCreateTimer = (
  name: string,
  minutes = 0,
  seconds = 0
): NexusTimer => {
  const totalSeconds = Math.max(
    1,
    Math.floor(minutes * 60 + seconds)
  );

  const timer: NexusTimer = {
    id: nexusId(),
    name: name.trim() || "Таймер",
    duration: totalSeconds,
    remaining: totalSeconds,
    running: false,
    createdAt: Date.now()
  };

  nexusClockRecord(
    "timer-created",
    timer.id
  );

  return timer;
};

const nexusClockStartTimer = (
  timer: NexusTimer
): NexusTimer => {
  if (timer.remaining <= 0) {
    return {
      ...timer,
      remaining: timer.duration,
      running: true
    };
  }

  const updated = {
    ...timer,
    running: true
  };

  nexusClockRecord(
    "timer-started",
    timer.id
  );

  return updated;
};

const nexusClockPauseTimer = (
  timer: NexusTimer
): NexusTimer => {
  const updated = {
    ...timer,
    running: false
  };

  nexusClockRecord(
    "timer-paused",
    timer.id
  );

  return updated;
};

const nexusClockResetTimer = (
  timer: NexusTimer
): NexusTimer => {
  return {
    ...timer,
    remaining: timer.duration,
    running: false
  };
};

const nexusClockTickTimer = (
  timer: NexusTimer
): NexusTimer => {
  if (!timer.running) {
    return timer;
  }

  const remaining = Math.max(
    0,
    timer.remaining - 1
  );

  if (remaining === 0) {
    nexusClockRecord(
      "timer-finished",
      timer.id
    );

    return {
      ...timer,
      remaining: 0,
      running: false
    };
  }

  return {
    ...timer,
    remaining
  };
};

const nexusClockDeleteTimer = (
  timers: NexusTimer[],
  timerId: string
): NexusTimer[] => {
  if (timers.some((timer) => timer.id === timerId)) {
    nexusClockRecord(
      "timer-deleted",
      timerId
    );
  }

  return timers.filter(
    (timer) => timer.id !== timerId
  );
};

const nexusClockRunningTimers = (
  timers: NexusTimer[]
): NexusTimer[] => {
  return timers.filter(
    (timer) =>
      timer.running &&
      timer.remaining > 0
  );
};

const nexusClockFinishedTimers = (
  timers: NexusTimer[]
): NexusTimer[] => {
  return timers.filter(
    (timer) =>
      !timer.running &&
      timer.remaining === 0
  );
};

const nexusClockFormatDuration = (
  totalSeconds: number
): string => {
  const safe = Math.max(
    0,
    Math.floor(totalSeconds)
  );

  const hours = Math.floor(safe / 3600);
  const minutes = Math.floor(
    (safe % 3600) / 60
  );
  const seconds = safe % 60;

  if (hours > 0) {
    return [
      String(hours).padStart(2, "0"),
      String(minutes).padStart(2, "0"),
      String(seconds).padStart(2, "0")
    ].join(":");
  }

  return [
    String(minutes).padStart(2, "0"),
    String(seconds).padStart(2, "0")
  ].join(":");
};

/* -------------------------
   ALARMS
   ------------------------- */

const nexusClockCreateAlarm = (
  title: string,
  time: string,
  repeat: NexusAlarm["repeat"] = "once"
): NexusAlarm => {
  const alarm: NexusAlarm = {
    id: nexusId(),
    title: title.trim() || "Будильник",
    time,
    enabled: true,
    repeat,
    createdAt: Date.now()
  };

  nexusClockRecord(
    "alarm-created",
    alarm.id
  );

  return alarm;
};

const nexusClockSetAlarmEnabled = (
  alarm: NexusAlarm,
  enabled: boolean
): NexusAlarm => {
  const updated = {
    ...alarm,
    enabled
  };

  if (!enabled) {
    nexusClockRecord(
      "alarm-disabled",
      alarm.id
    );
  }

  return updated;
};

const nexusClockDeleteAlarm = (
  alarms: NexusAlarm[],
  alarmId: string
): NexusAlarm[] => {
  return alarms.filter(
    (alarm) => alarm.id !== alarmId
  );
};

const nexusClockTimeToMinutes = (
  time: string
): number | null => {
  const match = time.match(
    /^(\d{1,2}):(\d{2})$/
  );

  if (!match) {
    return null;
  }

  const hours = Number(match[1]);
  const minutes = Number(match[2]);

  if (
    hours < 0 ||
    hours > 23 ||
    minutes < 0 ||
    minutes > 59
  ) {
    return null;
  }

  return hours * 60 + minutes;
};

const nexusClockShouldAlarmRepeat = (
  repeat: NexusAlarm["repeat"],
  day: number
): boolean => {
  if (repeat === "daily") {
    return true;
  }

  if (repeat === "weekdays") {
    return day >= 1 && day <= 5;
  }

  if (repeat === "weekends") {
    return day === 0 || day === 6;
  }

  return false;
};

const nexusClockFindTriggeredAlarms = (
  alarms: NexusAlarm[],
  timestamp = Date.now()
): NexusAlarm[] => {
  const date = new Date(timestamp);

  const currentHours = date.getHours();
  const currentMinutes = date.getMinutes();

  const currentTotalMinutes =
    currentHours * 60 + currentMinutes;

  return alarms.filter((alarm) => {
    if (!alarm.enabled) {
      return false;
    }

    const alarmMinutes =
      nexusClockTimeToMinutes(alarm.time);

    if (alarmMinutes === null) {
      return false;
    }

    if (alarmMinutes !== currentTotalMinutes) {
      return false;
    }

    if (
      alarm.repeat === "once" &&
      alarm.lastTriggeredAt &&
      nexusClockIsSameDay(
        alarm.lastTriggeredAt,
        timestamp
      )
    ) {
      return false;
    }

    if (
      alarm.repeat !== "once" &&
      !nexusClockShouldAlarmRepeat(
        alarm.repeat,
        date.getDay()
      )
    ) {
      return false;
    }

    return true;
  });
};

const nexusClockTriggerAlarm = (
  alarm: NexusAlarm,
  timestamp = Date.now()
): NexusAlarm => {
  nexusClockRecord(
    "alarm-triggered",
    alarm.id
  );

  if (alarm.repeat === "once") {
    return {
      ...alarm,
      enabled: false,
      lastTriggeredAt: timestamp
    };
  }

  return {
    ...alarm,
    lastTriggeredAt: timestamp
  };
};

/* -------------------------
   TIMER / ALARM SEARCH
   ------------------------- */

const nexusClockSearchTimers = (
  timers: NexusTimer[],
  query: string
): NexusTimer[] => {
  const normalized = query
    .trim()
    .toLowerCase();

  if (!normalized) {
    return [...timers];
  }

  return timers.filter((timer) =>
    timer.name
      .toLowerCase()
      .includes(normalized)
  );
};

const nexusClockSearchAlarms = (
  alarms: NexusAlarm[],
  query: string
): NexusAlarm[] => {
  const normalized = query
    .trim()
    .toLowerCase();

  if (!normalized) {
    return [...alarms];
  }

  return alarms.filter((alarm) =>
    `${alarm.title} ${alarm.time} ${alarm.repeat}`
      .toLowerCase()
      .includes(normalized)
  );
};

/* -------------------------
   AI CLOCK SUMMARY
   ------------------------- */

const nexusClockBuildAISummary = (
  timers: NexusTimer[],
  alarms: NexusAlarm[],
  timestamp = Date.now()
): string => {
  const state = nexusClockGetState(
    timestamp
  );

  const lines = [
    `Текущее время: ${state.time}`,
    `Дата: ${state.date}`,
    `Часовой пояс: ${state.timezone}`
  ];

  const running =
    nexusClockRunningTimers(timers);

  if (running.length > 0) {
    lines.push("Запущенные таймеры:");

    running.forEach((timer) => {
      lines.push(
        `- ${timer.name}: ${nexusClockFormatDuration(
          timer.remaining
        )}`
      );
    });
  } else {
    lines.push("Запущенных таймеров нет.");
  }

  const activeAlarms =
    alarms.filter(
      (alarm) => alarm.enabled
    );

  if (activeAlarms.length > 0) {
    lines.push("Активные будильники:");

    activeAlarms.forEach((alarm) => {
      lines.push(
        `- ${alarm.title}: ${alarm.time}`
      );
    });
  } else {
    lines.push(
      "Активных будильников нет."
    );
  }

  return lines.join("\n");
};

