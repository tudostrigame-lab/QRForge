/* -------------------------
   MAIN RECOMMENDATION ENGINE
   ------------------------- */

const nexusGenerateRecommendations = (
  context: NexusRecommendationContext
): NexusRecommendation[] => {
  const now =
    context.now ??
    Date.now();

  const recommendations = [
    ...nexusRecommendTasks(
      context.tasks,
      now
    ),

    ...nexusRecommendCalendar(
      context.events,
      now
    ),

    ...nexusRecommendMemory(
      context.memory
    ),

    ...nexusRecommendNotes(
      context.notes
    ),

    ...nexusRecommendTimers(
      context.timers
    ),

    ...nexusRecommendChats(
      context.chats
    ),

    ...nexusRecommendSystem(
      context
    ),
  ];

  return recommendations
    .filter(
      (item) =>
        !item.expiresAt ||
        item.expiresAt > now
    )
    .sort((a, b) => {
      const priority = {
        high: 3,
        normal: 2,
        low: 1,
      };

      return (
        priority[b.priority] -
        priority[a.priority]
      );
    })
    .slice(0, 20);
};

/* -------------------------
   DEDUPLICATION
   ------------------------- */

const nexusDeduplicateRecommendations = (
  recommendations: NexusRecommendation[]
): NexusRecommendation[] => {
  const seen =
    new Set<string>();

  return recommendations.filter(
    (item) => {
      const key =
        `${item.type}:${item.title}:${item.entityId ?? ""}`;

      if (seen.has(key)) {
        return false;
      }

      seen.add(key);

      return true;
    }
  );
};

