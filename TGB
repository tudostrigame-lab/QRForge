type NexusDataSnapshot = {
  version: number;
  savedAt: string;
  chats: NexusChat[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  files: NexusFile[];
  settings: NexusSettings;
};

type NexusDataAction =
  | "create"
  | "update"
  | "delete"
  | "complete"
  | "restore"
  | "clear";

type NexusDataEvent = {
  id: string;
  action: NexusDataAction;
  entity: string;
  entityId: string | null;
  timestamp: string;
};

const NEXUS_DATA_VERSION = 1;

const NEXUS_DATA_LIMITS = {
  chats: 100,
  messagesPerChat: 500,
  memory: 500,
  notes: 500,
  tasks: 1000,
  events: 1000,
  timers: 100,
  files: 2000,
};

function nexusClone<T>(value: T): T {
  return JSON.parse(
    JSON.stringify(value)
  ) as T;
}

function nexusCreateEmptySnapshot(): NexusDataSnapshot {
  return {
    version: NEXUS_DATA_VERSION,
    savedAt: nexusDate(),
    chats: [],
    memory: [],
    notes: [],
    tasks: [],
    events: [],
    timers: [],
    files: [],
    settings:
      nexusInitialSettings(),
  };
}

function nexusNormalizeSnapshot(
  data: Partial<NexusDataSnapshot>
): NexusDataSnapshot {
  const empty =
    nexusCreateEmptySnapshot();

  return {
    version:
      typeof data.version ===
      "number"
        ? data.version
        : empty.version,

    savedAt:
      typeof data.savedAt ===
      "string"
        ? data.savedAt
        : empty.savedAt,

    chats: Array.isArray(
      data.chats
    )
      ? data.chats
      : [],

    memory: Array.isArray(
      data.memory
    )
      ? data.memory
      : [],

    notes: Array.isArray(
      data.notes
    )
      ? data.notes
      : [],

    tasks: Array.isArray(
      data.tasks
    )
      ? data.tasks
      : [],

    events: Array.isArray(
      data.events
    )
      ? data.events
      : [],

    timers: Array.isArray(
      data.timers
    )
      ? data.timers
      : [],

    files: Array.isArray(
      data.files
    )
      ? data.files
      : [],

    settings: {
      ...empty.settings,
      ...(data.settings || {}),
    },
  };
}

function nexusLimitArray<T>(
  items: T[],
  limit: number
): T[] {
  if (items.length <= limit) {
    return items;
  }

  return items.slice(
    items.length - limit
  );
}

function nexusBuildSnapshot(
  data: Partial<NexusDataSnapshot>
): NexusDataSnapshot {
  const normalized =
    nexusNormalizeSnapshot(
      data
    );

  normalized.chats =
    nexusLimitArray(
      normalized.chats,
      NEXUS_DATA_LIMITS.chats
    );

  normalized.chats =
    normalized.chats.map(
      (chat) => ({
        ...chat,
        messages:
          nexusLimitArray(
            chat.messages || [],
            NEXUS_DATA_LIMITS
              .messagesPerChat
          ),
      })
    );

  normalized.memory =
    nexusLimitArray(
      normalized.memory,
      NEXUS_DATA_LIMITS.memory
    );

  normalized.notes =
    nexusLimitArray(
      normalized.notes,
      NEXUS_DATA_LIMITS.notes
    );

  normalized.tasks =
    nexusLimitArray(
      normalized.tasks,
      NEXUS_DATA_LIMITS.tasks
    );

  normalized.events =
    nexusLimitArray(
      normalized.events,
      NEXUS_DATA_LIMITS.events
    );

  normalized.timers =
    nexusLimitArray(
      normalized.timers,
      NEXUS_DATA_LIMITS.timers
    );

  normalized.files =
    nexusLimitArray(
      normalized.files,
      NEXUS_DATA_LIMITS.files
    );

  normalized.savedAt =
    nexusDate();

  return normalized;
}

function nexusSerializeSnapshot(
  snapshot: NexusDataSnapshot
): string {
  return JSON.stringify(
    snapshot
  );
}

function nexusDeserializeSnapshot(
  raw: string
): NexusDataSnapshot | null {
  try {
    const parsed =
      JSON.parse(raw);

    if (
      !parsed ||
      typeof parsed !==
        "object"
    ) {
      return null;
    }

    return nexusBuildSnapshot(
      parsed
    );
  } catch {
    return null;
  }
}

function nexusSaveSnapshot(
  snapshot: NexusDataSnapshot
): boolean {
  try {
    if (
      typeof window ===
      "undefined"
    ) {
      return false;
    }

    const prepared =
      nexusBuildSnapshot(
        snapshot
      );

    window.localStorage.setItem(
      NEXUS_STORAGE_KEY,
      nexusSerializeSnapshot(
        prepared
      )
    );

    return true;
  } catch (error) {
    console.error(
      "NEXUS storage save error:",
      error
    );

    return false;
  }
}

function nexusLoadSnapshot():
  | NexusDataSnapshot
  | null {
  try {
    if (
      typeof window ===
      "undefined"
    ) {
      return null;
    }

    const raw =
      window.localStorage.getItem(
        NEXUS_STORAGE_KEY
      );

    if (!raw) {
      return null;
    }

    return nexusDeserializeSnapshot(
      raw
    );
  } catch (error) {
    console.error(
      "NEXUS storage load error:",
      error
    );

    return null;
  }
}

function nexusDeleteSnapshot(): boolean {
  try {
    if (
      typeof window ===
      "undefined"
    ) {
      return false;
    }

    window.localStorage.removeItem(
      NEXUS_STORAGE_KEY
    );

    return true;
  } catch {
    return false;
  }
}

