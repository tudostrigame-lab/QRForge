  return {
    chats:
      state.chats.length,

    messages:
      state.chats.reduce(
        (sum, chat) =>
          sum +
          chat.messages.length,
        0
      ),

    memory:
      state.memory.length,

    notes:
      state.notes.length,

    tasks:
      state.tasks.length,

    events:
      state.events.length,

    timers:
      state.timers.length,

    files:
      state.files.length,

    analytics:
      state.analytics?.length ?? 0,

    undoAvailable:
      nexusUndoStack.length,

    redoAvailable:
