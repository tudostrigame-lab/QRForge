const nexusTelegramSendMessage =
  async (
    chatId: string,
    text: string
  ): Promise<boolean> => {
    if (
      !chatId ||
      !text.trim()
    ) {
      return false;
    }

    /*
     * Real Telegram API calls will be connected
     * through the backend/bot layer later.
