   FILTER BY PRIORITY
   ------------------------- */

const nexusRecommendationsByPriority = (
  recommendations: NexusRecommendation[],
  priority: NexusRecommendationPriority
): NexusRecommendation[] =>
  recommendations.filter(
    (item) =>
      item.priority ===
      priority
  );

/* -------------------------
   FILTER BY TYPE
   ------------------------- */

const nexusRecommendationsByType = (
  recommendations: NexusRecommendation[],
  type: NexusRecommendationType
): NexusRecommendation[] =>
  recommendations.filter(
    (item) =>
      item.type === type
  );

/* -------------------------
   AI SUMMARY
   ------------------------- */

const nexusRecommendationsSummary = (
  recommendations: NexusRecommendation[]
): string => {
  if (
    recommendations.length === 0
  ) {
    return "Сейчас нет активных рекомендаций.";
  }

  const important =
    recommendations.filter(
      (item) =>
        item.priority === "high"
    );

  if (
    important.length > 0
  ) {
    return important
      .slice(0, 3)
      .map(
        (item) =>
          `${item.title}: ${item.description}`
      )
      .join("\n");
  }

  return recommendations
    .slice(0, 5)
    .map(
      (item) =>
        `${item.title}: ${item.description}`
    )
    .join("\n");
};

