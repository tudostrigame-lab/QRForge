          {
            entityId: note.id,
            severity: "warning",
            field: "createdAt",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateTasks = (
  tasks: NexusTask[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(tasks, "task");

  for (const task of tasks) {
    if (!nexusIsNonEmptyString(task.title)) {
      issues.push(
        nexusValidationIssue(
          "task",
          "EMPTY_TITLE",
          "Task has an empty title.",
          {
            entityId: task.id,
            severity: "warning",
            field: "title",
            repairable: true,
          }
        )
      );

      continue;
    }

    if (!nexusIsValidTimestamp(task.createdAt)) {
      issues.push(
        nexusValidationIssue(
          "task",
          "INVALID_TIMESTAMP",
          "Task has an invalid creation time.",
          {
            entityId: task.id,
            severity: "warning",
            field: "createdAt",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateEvents = (
  events: NexusCalendarEvent[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(events, "calendar");

  for (const event of events) {
    if (!nexusIsNonEmptyString(event.title)) {
      issues.push(
        nexusValidationIssue(
          "calendar",
          "EMPTY_TITLE",
          "Calendar event has an empty title.",
          {
            entityId: event.id,
            severity: "warning",
            field: "title",
            repairable: true,
          }
        )
      );
    }

    if (!nexusIsNonEmptyString(event.date)) {
      issues.push(
        nexusValidationIssue(
          "calendar",
          "INVALID_DATE",
          "Calendar event has an invalid date.",
          {
            entityId: event.id,
            severity: "error",
            field: "date",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateTimers = (
  timers: NexusTimer[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(timers, "timer");

  for (const timer of timers) {
    if (!nexusIsPositiveNumber(timer.duration)) {
      issues.push(
        nexusValidationIssue(
          "timer",
          "INVALID_DURATION",
          "Timer has an invalid duration.",
          {
            entityId: timer.id,
            severity: "error",
            field: "duration",
            repairable: true,
          }
        )
      );
    }

    if (!nexusIsPositiveNumber(timer.remaining)) {
      issues.push(
        nexusValidationIssue(
          "timer",
          "INVALID_REMAINING",
          "Timer has an invalid remaining value.",
          {
            entityId: timer.id,
            severity: "warning",
            field: "remaining",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateFiles = (
  files: NexusFile[]
): NexusValidationIssue[] => {
  const issues = nexusUniqueIds(files, "file");
  const ids = new Set(files.map((file) => file.id));

  for (const file of files) {
    if (!nexusIsNonEmptyString(file.name)) {
      issues.push(
        nexusValidationIssue(
          "file",
          "EMPTY_NAME",
          "File has an empty name.",
          {
            entityId: file.id,
            severity: "error",
            field: "name",
            repairable: true,
          }
        )
      );
    }

    if (
      file.parentId !== null &&
      file.parentId !== undefined &&
      !ids.has(file.parentId)
    ) {
      issues.push(
        nexusValidationIssue(
          "file",
          "MISSING_PARENT",
          "File points to a folder that does not exist.",
          {
            entityId: file.id,
            severity: "warning",
            field: "parentId",
            repairable: true,
          }
        )
      );
    }
  }

  return issues;
};

const nexusValidateSettings = (
  settings: Partial<NexusUserSettings>
): NexusValidationIssue[] => {
  const issues: NexusValidationIssue[] = [];

  const languages = ["ru", "en", "es", "fr", "ja"];

  if (
    settings.language !== undefined &&
    !languages.includes(settings.language)
  ) {
    issues.push(
      nexusValidationIssue(
        "settings",
        "INVALID_LANGUAGE",
        "NEXUS contains an unsupported language setting.",
        {
          severity: "warning",
          field: "language",
          repairable: true,
        }
      )
    );
  }

  return issues;
};

const nexusValidateCompleteState = (state: {
  chats: NexusChat[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  files: NexusFile[];
  settings?: Partial<NexusUserSettings>;
}): NexusValidationReport => {
  const issues: NexusValidationIssue[] = [];

  issues.push(...nexusUniqueIds(state.chats, "chat"));
  issues.push(...nexusValidateMessages(state.chats));
  issues.push(...nexusValidateMemory(state.memory));
  issues.push(...nexusValidateNotes(state.notes));
  issues.push(...nexusValidateTasks(state.tasks));
  issues.push(...nexusValidateEvents(state.events));
  issues.push(...nexusValidateTimers(state.timers));
  issues.push(...nexusValidateFiles(state.files));

  if (state.settings) {
    issues.push(...nexusValidateSettings(state.settings));
  }

  const folders = state.files.filter(
    (file) => file.type === "folder"
  ).length;

  const messages = state.chats.reduce(
    (total, chat) => total + chat.messages.length,
    0
  );

  const critical = issues.some(
    (issue) => issue.severity === "critical"
  );

  const errors = issues.some(
    (issue) => issue.severity === "error"
  );

  return {
    valid: !critical && !errors,
    checkedAt: Date.now(),
    issues,
    statistics: {
      chats: state.chats.length,
      messages,
      memories: state.memory.length,
      notes: state.notes.length,
      tasks: state.tasks.length,
      events: state.events.length,
      timers: state.timers.length,
      files: state.files.length,
      folders,
    },
  };
};

const nexusRepairText = (
  value: unknown,
  fallback: string
): string =>
  typeof value === "string" && value.trim()
    ? value.trim()
    : fallback;

const nexusRepairState = (state: {
  chats: NexusChat[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  files: NexusFile[];
}) => {
  const now = Date.now();

  const repairIds = <T extends { id: string }>(
    items: T[]
  ): T[] => {
    const used = new Set<string>();

    return items.map((item) => {
      let id = item.id;

      if (!nexusIsNonEmptyString(id) || used.has(id)) {
        id = createId();
      }

      used.add(id);

      return {
        ...item,
        id,
      };
    });
  };

  const chats = repairIds(
    state.chats.map((chat) => ({
      ...chat,
      title: nexusRepairText(chat.title, "Новый чат"),
      messages: Array.isArray(chat.messages)
        ? repairIds(
            chat.messages.map((message) => ({
              ...message,
              content: nexusRepairText(
                message.content,
                "Пустое сообщение"
              ),
              createdAt: nexusIsValidTimestamp(message.createdAt)
                ? message.createdAt
                : now,
            }))
          )
        : [],
    }))
  );

  const memory = repairIds(
    state.memory.map((item) => ({
      ...item,
      content: nexusRepairText(
        item.content,
        "Новая запись памяти"
      ),
      createdAt: nexusIsValidTimestamp(item.createdAt)
        ? item.createdAt
        : now,
    }))
  );

  const notes = repairIds(
    state.notes.map((note) => ({
      ...note,
      title: nexusRepairText(note.title, "Новая заметка"),
      content:
        typeof note.content === "string" ? note.content : "",
      createdAt: nexusIsValidTimestamp(note.createdAt)
        ? note.createdAt
        : now,
      updatedAt: nexusIsValidTimestamp(note.updatedAt)
        ? note.updatedAt
        : now,
    }))
  );

  const tasks = repairIds(
    state.tasks.map((task) => ({
      ...task,
      title: nexusRepairText(task.title, "Новая задача"),
      createdAt: nexusIsValidTimestamp(task.createdAt)
        ? task.createdAt
        : now,
    }))
  );

  const events = repairIds(
    state.events.map((event) => ({
      ...event,
      title: nexusRepairText(
        event.title,
        "Новое событие"
      ),
    }))
  );

  const timers = repairIds(
    state.timers.map((timer) => ({
      ...timer,
      name: nexusRepairText(timer.name, "Таймер"),
      duration: nexusIsPositiveNumber(timer.duration)
        ? timer.duration
        : 60,
      remaining: nexusIsPositiveNumber(timer.remaining)
        ? Math.min(timer.remaining, timer.duration)
        : 0,
    }))
  );

  const files = repairIds(
    state.files.map((file) => ({
      ...file,
      name: nexusRepairText(file.name, "Новый файл"),
    }))
  );

  return {
    chats,
    memory,
    notes,
    tasks,
    events,
    timers,
    files,
    repairedAt: now,
  };
};

const nexusValidationSummary = (
  report: NexusValidationReport
): string => {
  if (report.valid && report.issues.length === 0) {
    return "Состояние NEXUS полностью исправно. Ошибок не найдено.";
  }

  if (report.valid) {
    return `Проверка завершена. Найдено предупреждений: ${report.issues.length}.`;
  }

  const critical = report.issues.filter(
    (issue) => issue.severity === "critical"
  ).length;

  const errors = report.issues.filter(
    (issue) => issue.severity === "error"
  ).length;

  return `Проверка завершена. Критических ошибок: ${critical}, обычных ошибок: ${errors}.`;
};

const nexusValidationEngine = {
  validate: nexusValidateCompleteState,
  repair: nexusRepairState,
  summary: nexusValidationSummary,
  isValid: (
    report: NexusValidationReport
  ) => report.valid,
  countBySeverity: (
    report: NexusValidationReport,
    severity: NexusValidationSeverity
  ) =>
    report.issues.filter(
      (issue) => issue.severity === severity
    ).length,
  getRepairableIssues: (
    report: NexusValidationReport
  ) =>
    report.issues.filter(
      (issue) => issue.repairable
    ),
};

