  if (!normalized) {
    return nexusProfileGetTopLearning(
      profile
    );
  }

  return profile.learning.filter(
    (item) =>
      item.text
        .toLowerCase()
        .includes(normalized)
  );
};

const nexusProfileFormatForAI = (
  profile: NexusUserProfile
): string => {
  const fields =
    profile.fields
      .map(
        (item) =>
          `${item.field}: ${item.value}`
      )
      .join("\n");

  const learning =
    nexusProfileGetTopLearning(
      profile,
      15
    )
      .map(
        (item) =>
          `- ${item.text}`
      )
      .join("\n");

  return [
    "ПРОФИЛЬ ПОЛЬЗОВАТЕЛЯ:",
    fields ||
      "Профиль пока пуст.",
    "",
    "ИЗУЧЕННЫЕ ПРЕДПОЧТЕНИЯ:",
    learning ||
      "Пока недостаточно данных.",
  ].join("\n");
};

const nexusProfileToMemory = (
  profile: NexusUserProfile
): NexusMemoryItem[] => {
  const result:
    NexusMemoryItem[] = [];

  for (const field of profile.fields) {
    result.push({
      id:
        `profile-memory-${field.id}`,
      category:
        field.field === "goals"
          ? "goal"
          : field.field === "projects"
          ? "project"
          : "fact",
      content:
        `${field.field}: ${field.value}`,
      importance:
        Math.round(
          field.confidence * 100
        ),
      createdAt:
        field.createdAt,
      updatedAt:
        field.updatedAt,
    });
  }

  for (const item of profile.learning) {
    result.push({
      id:
        `learning-memory-${item.id}`,
      category:
        item.signal === "goal"
          ? "goal"
          : item.signal === "project"
          ? "project"
          : item.signal === "preference"
          ? "preference"
          : item.signal === "communication"
          ? "preference"
          : "fact",
      content:
        item.text,
      importance:
        Math.round(
          item.confidence * 100
        ),
      createdAt:
        item.createdAt,
      updatedAt:
        item.updatedAt,
    });
  }

  return result;
};

