const nexusStoreConversationResult =
  (
    result: NexusConversationResult
  ) => {
    nexusConversationHistory.push(
      nexusClone(result)
    );

    if (
      nexusConversationHistory.length >
      nexusConversationHistoryLimit
    ) {
      nexusConversationHistory.shift();
    }
  };

