/* -------------------------
   TASK RECOMMENDATIONS
   ------------------------- */

const nexusRecommendTasks = (
  tasks: NexusTask[],
  now: number
): NexusRecommendation[] => {
  const recommendations: NexusRecommendation[] = [];

  const pending = tasks.filter(
    (task) =>
      !task.completed
  );

  for (const task of pending) {
    const dueDate =
      (task as NexusTask & {
        dueDate?: string;
      }).dueDate;

    if (!dueDate) {
      continue;
    }

    const due =
      new Date(dueDate).getTime();

    if (!Number.isFinite(due)) {
      continue;
    }

    const hours =
      (due - now) /
      (1000 * 60 * 60);

    if (
      hours >= 0 &&
      hours <= 24
    ) {
      recommendations.push(
        nexusRecommendation(
          "task",
          "high",
          "Приближается задача",
          `Задача «${task.title}» запланирована на ближайшие 24 часа.`,
          {
            entityId: task.id,
            action: "open-task",
          }
        )
      );
    }
  }

  return recommendations;
};

/* -------------------------
   CALENDAR RECOMMENDATIONS
   ------------------------- */

const nexusRecommendCalendar = (
  events: NexusCalendarEvent[],
  now: number
): NexusRecommendation[] => {
  const recommendations: NexusRecommendation[] = [];

  for (const event of events) {
    const date =
      new Date(
        `${event.date}T${
          event.time || "00:00"
        }`
      ).getTime();

    if (!Number.isFinite(date)) {
      continue;
    }

    const hours =
      (date - now) /
      (1000 * 60 * 60);

    if (
      hours >= 0 &&
      hours <= 24
    ) {
      recommendations.push(
        nexusRecommendation(
          "calendar",
          "high",
          "Событие скоро начнётся",
          `«${event.title}» запланировано в ближайшие 24 часа.`,
          {
            entityId: event.id,
            action: "open-calendar",
          }
        )
      );
    }
  }

  return recommendations;
};

/* -------------------------
   MEMORY RECOMMENDATIONS
   ------------------------- */

const nexusRecommendMemory = (
  memory: NexusMemoryItem[]
): NexusRecommendation[] => {
  if (memory.length === 0) {
    return [
      nexusRecommendation(
        "memory",
        "low",
        "Память пока пустая",
        "NEXUS может постепенно запоминать полезные факты, предпочтения и цели.",
        {
          action: "open-memory",
        }
      ),
    ];
  }

  const recent =
    [...memory]
      .sort(
        (a, b) =>
          b.createdAt -
          a.createdAt
      )
      .slice(0, 3);

  return recent.map(
    (item) =>
      nexusRecommendation(
        "memory",
        "low",
        "Недавняя запись памяти",
        item.content,
        {
          entityId: item.id,
          action: "open-memory",
        }
      )
  );
};

/* -------------------------
   NOTE RECOMMENDATIONS
   ------------------------- */

const nexusRecommendNotes = (
  notes: NexusNote[]
): NexusRecommendation[] => {
  const recommendations: NexusRecommendation[] = [];

  const emptyNotes =
    notes.filter(
      (note) =>
        !note.content?.trim()
    );

  if (
    emptyNotes.length > 0
  ) {
    recommendations.push(
      nexusRecommendation(
        "note",
        "low",
        "Есть незаполненные заметки",
        "Некоторые заметки имеют название, но пока не содержат текста.",
        {
          entityId:
            emptyNotes[0].id,
          action: "open-note",
        }
      )
    );
  }

  return recommendations;
};

/* -------------------------
   TIMER RECOMMENDATIONS
