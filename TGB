/* -------------------------
   MERGE HELPERS
   ------------------------- */

const nexusMergeById = <
  T extends {
    id: string;
  }
>(
  local: T[],
  incoming: T[]
): {
  data: T[];
  added: number;
  updated: number;
} => {
  const map =
    new Map<string, T>();

  local.forEach(
    (item) =>
      map.set(
        item.id,
        nexusClone(item)
      )
  );

  let added = 0;
  let updated = 0;

  incoming.forEach(
    (item) => {
      if (
        map.has(item.id)
      ) {
        updated++;
      } else {
        added++;
      }

      map.set(
        item.id,
        nexusClone(item)
      );
    }
  );

  return {
    data:
      Array.from(
        map.values()
      ),
    added,
    updated
  };
};

/* -------------------------
   IMPORT / SYNC
   ------------------------- */

const nexusTelegramImportPayload =
  (
    payload: NexusTelegramSyncPayload
  ): NexusTelegramSyncResult => {
    const result: NexusTelegramSyncResult =
      {
        success: false,
        synced: 0,
        skipped: 0,
        errors: [],
        timestamp:
          Date.now()
      };

    if (
      !payload ||
      payload.version !== 1 ||
      !payload.state
    ) {
      result.errors.push(
        "Некорректный Telegram payload."
      );

      return result;
    }

    nexusTelegramStatus =
      "syncing";

    try {
      const local =
        nexusStateGet();

      const incoming =
        payload.state;

      if (
        nexusTelegramConfig
          .syncChats
      ) {
        const merged =
          nexusMergeById(
            local.chats,
            incoming.chats
          );

        local.chats =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      if (
        nexusTelegramConfig
          .syncMemory
      ) {
        const merged =
          nexusMergeById(
            local.memory,
            incoming.memory
          );

        local.memory =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      if (
        nexusTelegramConfig
          .syncNotes
      ) {
        const merged =
          nexusMergeById(
            local.notes,
            incoming.notes
          );

        local.notes =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      if (
        nexusTelegramConfig
          .syncTasks
      ) {
        const merged =
          nexusMergeById(
            local.tasks,
            incoming.tasks
          );

        local.tasks =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      if (
        nexusTelegramConfig
          .syncCalendar
      ) {
        const merged =
          nexusMergeById(
            local.events,
            incoming.events
          );

        local.events =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      if (
        nexusTelegramConfig
          .syncFiles
      ) {
        const merged =
          nexusMergeById(
            local.files,
            incoming.files
          );

        local.files =
          merged.data;

        result.synced +=
          merged.added +
          merged.updated;
      }

      nexusStateSet(local);
      nexusStateSave();

      nexusTelegramStatus =
        "connected";

      result.success =
        true;

      nexusEmitEvent(
        "app.ready",
        {
          integration:
            "telegram",
          synced:
            result.synced
        },
        "telegram-adapter"
      );

      return result;
    } catch (error) {
      nexusTelegramStatus =
        "error";

      result.errors.push(
        error instanceof Error
          ? error.message
          : String(error)
      );

      return result;
    }
  };

/* -------------------------
   TELEGRAM COMMAND BRIDGE
   ------------------------- */

type NexusTelegramCommandResult = {
  handled: boolean;
  command: string | null;
  args: string[];
  response: string | null;
};

const nexusParseTelegramCommand =
  (
    text: string
  ): {
    command: string | null;
    args: string[];
  } => {
    const clean =
      text.trim();

    if (
      !clean.startsWith("/")
    ) {
      return {
        command: null,
        args: []
      };
    }

    const parts =
      clean
        .slice(1)
        .split(/\s+/)
        .filter(Boolean);

    if (
      parts.length === 0
    ) {
      return {
        command: null,
        args: []
      };
    }

    return {
      command:
        parts[0]
          .toLowerCase(),
      args:
        parts.slice(1)
    };
  };

const nexusHandleTelegramCommand =
  async (
    text: string
  ): Promise<NexusTelegramCommandResult> => {
    const parsed =
      nexusParseTelegramCommand(
        text
      );

    if (!parsed.command) {
      return {
        handled: false,
        command: null,
        args: [],
        response: null
      };
    }

    switch (
      parsed.command
    ) {
      case "start":
        return {
          handled: true,
          command:
            parsed.command,
          args:
            parsed.args,
          response:
            "NEXUS подключён. Готов к работе."
        };

      case "help":
        return {
          handled: true,
          command:
            parsed.command,
          args:
            parsed.args,
          response:
            nexusDescribeAIActions()
        };

      case "status": {
        const stats =
          nexusStateStatistics();

        return {
          handled: true,
          command:
            parsed.command,
          args:
            parsed.args,
          response:
            `NEXUS: ${stats.chats} чатов, ${stats.messages} сообщений, ${stats.tasks} задач, ${stats.notes} заметок.`
        };
      }

      case "sync": {
        const payload =
          nexusTelegramExportPayload();

        return {
          handled: true,
          command:
            parsed.command,
          args:
            parsed.args,
          response:
            `Состояние подготовлено для синхронизации. Версия: ${payload.version}.`
        };
      }

      default:
        return {
          handled: false,
          command:
            parsed.command,
          args:
            parsed.args,
          response: null
        };
    }
  };

