   ========================================================= */

type NexusNotificationType =
  | "timer"
  | "alarm"
  | "task"
  | "calendar"
  | "system";

type NexusNotificationPriority =
  | "low"
  | "normal"
  | "high"
  | "critical";

type NexusNotification = {
  id: string;
  type: NexusNotificationType;
  title: string;
  message: string;
  priority: NexusNotificationPriority;
  createdAt: number;
  read: boolean;
  entityId?: string;
  expiresAt?: number;
};

type NexusNotificationEvent = {
  id: string;
  type:
    | "created"
    | "read"
    | "read-all"
    | "deleted"
    | "cleared"
    | "browser-request";
  notificationId?: string;
  timestamp: number;
};

const NEXUS_NOTIFICATION_EVENTS: NexusNotificationEvent[] = [];

const nexusNotificationRecord = (
  type: NexusNotificationEvent["type"],
  notificationId?: string
) => {
  const event: NexusNotificationEvent = {
    id: nexusId(),
    type,
    notificationId,
    timestamp: Date.now()
  };

  NEXUS_NOTIFICATION_EVENTS.push(event);

  if (
    NEXUS_NOTIFICATION_EVENTS.length > 500
  ) {
    NEXUS_NOTIFICATION_EVENTS.shift();
  }

  return event;
};

/* -------------------------
   CREATE
   ------------------------- */

const nexusNotificationCreate = (
  type: NexusNotificationType,
  title: string,
  message: string,
  priority: NexusNotificationPriority = "normal",
  entityId?: string
): NexusNotification => {
  const notification: NexusNotification = {
    id: nexusId(),
    type,
    title: title.trim() || "NEXUS",
    message,
    priority,
    createdAt: Date.now(),
    read: false,
    entityId
  };

  nexusNotificationRecord(
    "created",
    notification.id
  );

  return notification;
};

/* -------------------------
   READ STATE
   ------------------------- */

const nexusNotificationMarkRead = (
  notification: NexusNotification
): NexusNotification => {
  if (notification.read) {
    return notification;
  }

  nexusNotificationRecord(
    "read",
    notification.id
  );

  return {
    ...notification,
    read: true
  };
};

const nexusNotificationMarkAllRead = (
  notifications: NexusNotification[]
): NexusNotification[] => {
  nexusNotificationRecord("read-all");

  return notifications.map(
    (notification) => ({
      ...notification,
      read: true
    })
  );
};

/* -------------------------
   DELETE
   ------------------------- */

const nexusNotificationDelete = (
  notifications: NexusNotification[],
  notificationId: string
): NexusNotification[] => {
  if (
    notifications.some(
      (notification) =>
        notification.id === notificationId
    )
  ) {
    nexusNotificationRecord(
      "deleted",
      notificationId
    );
  }

  return notifications.filter(
    (notification) =>
      notification.id !== notificationId
  );
};

const nexusNotificationClear = (): void => {
  nexusNotificationRecord("cleared");
};

/* -------------------------
   FILTERS
   ------------------------- */

const nexusNotificationUnread = (
  notifications: NexusNotification[]
): NexusNotification[] => {
  return notifications.filter(
    (notification) =>
      !notification.read
  );
};

const nexusNotificationByType = (
  notifications: NexusNotification[],
  type: NexusNotificationType
): NexusNotification[] => {
  return notifications.filter(
    (notification) =>
      notification.type === type
  );
};

const nexusNotificationByPriority = (
  notifications: NexusNotification[],
  priority: NexusNotificationPriority
): NexusNotification[] => {
  return notifications.filter(
    (notification) =>
      notification.priority === priority
  );
};

/* -------------------------
   SORTING
   ------------------------- */

const nexusNotificationPriorityValue = (
  priority: NexusNotificationPriority
): number => {
  const values: Record<
    NexusNotificationPriority,
    number
  > = {
    low: 1,
    normal: 2,
    high: 3,
    critical: 4
  };

  return values[priority];
};

const nexusNotificationSort = (
  notifications: NexusNotification[]
): NexusNotification[] => {
  return [...notifications].sort(
    (a, b) => {
      const priorityDifference =
        nexusNotificationPriorityValue(
          b.priority
        ) -
        nexusNotificationPriorityValue(
          a.priority
        );

      if (priorityDifference !== 0) {
        return priorityDifference;
      }

      return (
        b.createdAt -
        a.createdAt
      );
    }
  );
};

/* -------------------------
   COUNTS
   ------------------------- */

const nexusNotificationUnreadCount = (
  notifications: NexusNotification[]
): number => {
  return nexusNotificationUnread(
    notifications
  ).length;
};

const nexusNotificationCountByType = (
  notifications: NexusNotification[]
): Record<
  NexusNotificationType,
  number
> => {
  return {
    timer:
      nexusNotificationByType(
        notifications,
        "timer"
      ).length,

    alarm:
      nexusNotificationByType(
        notifications,
        "alarm"
      ).length,

    task:
      nexusNotificationByType(
        notifications,
        "task"
      ).length,

    calendar:
      nexusNotificationByType(
        notifications,
        "calendar"
      ).length,

    system:
      nexusNotificationByType(
        notifications,
        "system"
      ).length
  };
};

/* -------------------------
   EXPIRATION
   ------------------------- */

const nexusNotificationRemoveExpired = (
  notifications: NexusNotification[],
  timestamp = Date.now()
): NexusNotification[] => {
  return notifications.filter(
    (notification) =>
      !notification.expiresAt ||
      notification.expiresAt > timestamp
  );
};

/* -------------------------
   BROWSER NOTIFICATIONS
   ------------------------- */

const nexusNotificationBrowserSupported =
  (): boolean => {
    return (
      typeof window !== "undefined" &&
      "Notification" in window
    );
  };

const nexusNotificationBrowserPermission =
  (): NotificationPermission | "unsupported" => {
    if (
      !nexusNotificationBrowserSupported()
    ) {
      return "unsupported";
    }

    return Notification.permission;
  };

const nexusNotificationRequestPermission =
  async (): Promise<
    NotificationPermission | "unsupported"
  > => {
    if (
      !nexusNotificationBrowserSupported()
    ) {
      return "unsupported";
    }

    nexusNotificationRecord(
      "browser-request"
    );

    return Notification.requestPermission();
  };

const nexusNotificationShowBrowser = (
  notification: NexusNotification
): boolean => {
  if (
    !nexusNotificationBrowserSupported()
  ) {
    return false;
  }

  if (
    Notification.permission !==
    "granted"
  ) {
    return false;
  }

  new Notification(
    notification.title,
    {
      body: notification.message,
      tag: notification.id
    }
  );

  return true;
};

