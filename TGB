/* -------------------------
   CHAT RECOMMENDATIONS
   ------------------------- */

const nexusRecommendChats = (
  chats: NexusChat[]
): NexusRecommendation[] => {
  const recommendations: NexusRecommendation[] = [];

  if (
    chats.length === 0
  ) {
    recommendations.push(
      nexusRecommendation(
        "chat",
        "normal",
        "Создай первый чат",
        "Здесь можно общаться с NEXUS.",
        {
