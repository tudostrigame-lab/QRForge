const nexusResponseLocal = (
  text: string,
  context: NexusConversationContext
): NexusResponseResult => {
  const profile =
    nexusResponseProfile(
      text,
      context.settings
    );

  const intent =
    nexusDetectIntent(text);

  const clarification =
    nexusResponseNeedsClarification(
      intent
    );

  if (clarification) {
    return {
      text:
        nexusResponseClarification(
          intent,
          profile.language
        ),
      mode: "clarification",
      intent,
    };
  }

  const intentResponse =
    nexusResponseForIntent(
      intent,
      profile.language
    );

  if (intentResponse) {
    return {
      text: intentResponse,
      mode: "contextual",
      intent,
    };
  }

  const normalized =
    text.toLowerCase();

  if (
    normalized === "привет" ||
    normalized === "здравствуйте" ||
    normalized === "hello" ||
    normalized === "hi" ||
    normalized === "hola" ||
    normalized === "bonjour"
  ) {
    return {
      text:
        nexusResponseGreeting(
          profile.language
        ),
      mode: "direct",
      intent,
    };
  }

  const local =
    nexusAILocalResponse(
      text,
      nexusConversationContext(
        context
      )
    );

  return {
    text: local,
    mode: "fallback",
    intent,
  };
};

const nexusResponseGenerate = async (
  text: string,
  context: NexusConversationContext,
  config?: Partial<NexusAIConfig>
): Promise<NexusResponseResult> => {
  const intent =
    nexusDetectIntent(text);

  const profile =
    nexusResponseProfile(
      text,
      context.settings
    );

  if (
    nexusResponseNeedsClarification(
      intent
    )
  ) {
    return {
      text:
        nexusResponseClarification(
          intent,
          profile.language
        ),
      mode: "clarification",
      intent,
    };
  }

  const direct =
    nexusResponseForIntent(
      intent,
      profile.language
    );

  if (direct) {
    return {
      text: direct,
      mode: "contextual",
      intent,
    };
  }

  const aiContext =
    nexusConversationContext(
      context
    );

  const ai =
    await nexusAIRequest(
      text,
      aiContext,
      config
    );

  if (ai.ok && ai.text) {
    return {
      text: ai.text,
      mode: "contextual",
      intent,
    };
  }

  return nexusResponseLocal(
    text,
    context
  );
};

const nexusResponseBuildPrompt = (
