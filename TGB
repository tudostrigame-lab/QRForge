const nexusSettingsClone = (
  settings: NexusUserSettings
): NexusUserSettings => {
  return JSON.parse(
    JSON.stringify(settings)
  ) as NexusUserSettings;
};

/* -------------------------
   EVENT
   ------------------------- */

const nexusSettingsRecord = (
  key: string,
  oldValue: unknown,
  newValue: unknown
) => {
  const event: NexusSettingsEvent = {
    id: nexusId(),
    key,
    oldValue,
    newValue,
    timestamp: Date.now()
  };

  NEXUS_SETTINGS_EVENTS.push(event);

  if (NEXUS_SETTINGS_EVENTS.length > 500) {
    NEXUS_SETTINGS_EVENTS.shift();
  }

  return event;
};

/* -------------------------
   VALIDATION
   ------------------------- */

const nexusSettingsIsLanguage = (
  value: unknown
): value is NexusLanguage => {
  return (
    value === "ru" ||
    value === "en" ||
    value === "es" ||
    value === "fr" ||
    value === "ja"
  );
};

const nexusSettingsIsTheme = (
  value: unknown
): value is NexusTheme => {
  return (
    value === "light" ||
    value === "dark" ||
    value === "system"
  );
};

const nexusSettingsIsClockFormat = (
  value: unknown
): value is NexusClockFormat => {
  return (
    value === "12h" ||
    value === "24h"
  );
};

/* -------------------------
   MERGE
   ------------------------- */

const nexusSettingsMerge = (
  current: NexusUserSettings,
  partial: Partial<NexusUserSettings>
): NexusUserSettings => {
  return {
    interface: {
      ...current.interface,
      ...(partial.interface || {})
    },

    notifications: {
      ...current.notifications,
      ...(partial.notifications || {})
    },

    privacy: {
      ...current.privacy,
      ...(partial.privacy || {})
    }
  };
};

/* -------------------------
   LANGUAGE
   ------------------------- */

const nexusSettingsSetLanguage = (
  settings: NexusUserSettings,
  language: NexusLanguage
): NexusUserSettings => {
  if (!nexusSettingsIsLanguage(language)) {
    return settings;
  }

  nexusSettingsRecord(
    "interface.language",
    settings.interface.language,
    language
  );

  return nexusSettingsMerge(
    settings,
    {
      interface: {
        language
      }
    }
  );
};

