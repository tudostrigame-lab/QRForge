/* -------------------------
   VALIDATION
   ------------------------- */

const nexusFileNormalizeName = (
  name: string
): string => {
  return name
    .trim()
    .replace(/[<>:"/\\|?*\x00-\x1F]/g, "")
    .slice(0, 160);
};

const nexusFileIsValidName = (
  name: string
): boolean => {
  const normalized =
    nexusFileNormalizeName(name);

  return (
    normalized.length > 0 &&
    normalized !== "." &&
    normalized !== ".."
  );
};

const nexusFileNameExists = (
  files: NexusFile[],
  name: string,
  parentId: string | null,
  exceptId?: string
): boolean => {
  const normalized = name
    .trim()
    .toLowerCase();

  return files.some(
    (file) =>
      file.id !== exceptId &&
      file.parentId === parentId &&
      file.name.trim().toLowerCase() ===
        normalized
  );
};

/* -------------------------
   RENAME
   ------------------------- */

const nexusFileRename = (
  file: NexusFile,
  newName: string
): NexusFile => {
  const normalized =
    nexusFileNormalizeName(newName);

  const updated: NexusFile = {
    ...file,
    name:
      normalized ||
      file.name
  };

  nexusFileRecord(
    "rename",
    file.id
  );

  return updated;
};

/* -------------------------
   MOVE
   ------------------------- */

const nexusFileMove = (
  file: NexusFile,
  parentId: string | null
): NexusFile => {
  const updated: NexusFile = {
    ...file,
    parentId
  };

  nexusFileRecord(
    "move",
    file.id
  );

  return updated;
};

/* -------------------------
   DELETE
   ------------------------- */

const nexusFileDelete = (
  files: NexusFile[],
  fileId: string,
  recursive = true
): NexusFile[] => {
  const target = files.find(
    (file) => file.id === fileId
  );

  if (!target) {
    return files;
  }

  nexusFileRecord(
    "delete",
    fileId
  );

  if (!recursive) {
    return files.filter(
      (file) => file.id !== fileId
    );
  }

  const idsToDelete = new Set<string>([
    fileId
  ]);

  let changed = true;

  while (changed) {
    changed = false;

    for (const file of files) {
      if (
        file.parentId &&
        idsToDelete.has(file.parentId) &&
        !idsToDelete.has(file.id)
      ) {
        idsToDelete.add(file.id);
        changed = true;
      }
    }
  }

  return files.filter(
    (file) => !idsToDelete.has(file.id)
  );
};

/* -------------------------
   DUPLICATE
   ------------------------- */

const nexusFileDuplicate = (
  file: NexusFile
): NexusFile => {
  const copy: NexusFile = {
    ...file,
    id: nexusId(),
    name: `${file.name} (копия)`,
    createdAt: Date.now()
  };

  nexusFileRecord(
    "duplicate",
    copy.id
  );

  return copy;
};

/* -------------------------
   QUERY
   ------------------------- */

const nexusFileChildren = (
  files: NexusFile[],
  parentId: string | null
): NexusFile[] => {
  return files
    .filter(
      (file) =>
        file.parentId === parentId
    )
    .sort((a, b) => {
      if (
        a.type === "folder" &&
        b.type !== "folder"
      ) {
        return -1;
      }

      if (
        a.type !== "folder" &&
        b.type === "folder"
      ) {
        return 1;
      }

      return a.name.localeCompare(
        b.name,
        undefined,
        { sensitivity: "base" }
      );
    });
};

const nexusFileFindById = (
  files: NexusFile[],
  id: string
): NexusFile | undefined => {
  return files.find(
    (file) => file.id === id
  );
};

const nexusFileFindRoot = (
  files: NexusFile[]
): NexusFile[] => {
  return nexusFileChildren(
    files,
    null
  );
};

const nexusFileSearch = (
  files: NexusFile[],
  query: string
): NexusFile[] => {
  const normalized = query
    .trim()
    .toLowerCase();

  if (!normalized) {
    return [];
  }

  return files.filter((file) =>
    `${file.name} ${
      file.content || ""
    }`
      .toLowerCase()
      .includes(normalized)
  );
};

/* -------------------------
   PATH
   ------------------------- */

const nexusFileBuildPath = (
  files: NexusFile[],
  fileId: string
): string[] => {
  const result: string[] = [];
  const visited = new Set<string>();

  let current =
    nexusFileFindById(files, fileId);

  while (
    current &&
    !visited.has(current.id)
  ) {
    visited.add(current.id);
    result.unshift(current.name);

    if (!current.parentId) {
      break;
    }

    current = nexusFileFindById(
      files,
      current.parentId
    );
  }

  return result;
};

const nexusFilePathString = (
  files: NexusFile[],
  fileId: string
): string => {
  return nexusFileBuildPath(
    files,
    fileId
  ).join(" / ");
};

/* -------------------------
   TREE
   ------------------------- */

const nexusFileBuildTree = (
  files: NexusFile[],
  parentId: string | null = null
): NexusFileTreeNode[] => {
  return nexusFileChildren(
    files,
    parentId
  ).map((file) => ({
    id: file.id,
    name: file.name,
    kind: file.type,
    parentId: file.parentId,
    children:
      file.type === "folder"
        ? nexusFileBuildTree(
            files,
            file.id
          )
        : []
  }));
};

/* -------------------------
   FOLDERS
   ------------------------- */

const nexusFileFolders = (
  files: NexusFile[]
): NexusFile[] => {
  return files.filter(
    (file) => file.type === "folder"
  );
};

const nexusFileDocuments = (
  files: NexusFile[]
): NexusFile[] => {
  return files.filter(
    (file) => file.type === "file"
  );
};

const nexusFileCountChildren = (
  files: NexusFile[],
  folderId: string
): number => {
  return files.filter(
    (file) =>
      file.parentId === folderId
  ).length;
};

/* -------------------------
   SAFE MOVE
   ------------------------- */

const nexusFileIsDescendant = (
  files: NexusFile[],
  possibleChildId: string,
  possibleParentId: string
): boolean => {
  let current =
    nexusFileFindById(
      files,
      possibleChildId
    );

  const visited = new Set<string>();

  while (
    current &&
    current.parentId &&
    !visited.has(current.id)
  ) {
    if (
      current.parentId ===
      possibleParentId
    ) {
      return true;
    }

    visited.add(current.id);

    current =
      nexusFileFindById(
        files,
        current.parentId
      );
  }

  return false;
};

const nexusFileCanMove = (
  files: NexusFile[],
  fileId: string,
  targetParentId: string | null
): boolean => {
  const file =
    nexusFileFindById(files, fileId);

  if (!file) {
    return false;
  }

  if (targetParentId === file.id) {
    return false;
  }

  if (
    targetParentId &&
    nexusFileIsDescendant(
      files,
      targetParentId,
      fileId
    )
  ) {
    return false;
  }

  return true;
};

/* -------------------------
   FILE SUMMARY FOR AI
   ------------------------- */

const nexusFileBuildAISummary = (
  files: NexusFile[]
): string => {
  const folders =
    nexusFileFolders(files);

  const documents =
    nexusFileDocuments(files);

  const lines = [
    `Всего объектов: ${files.length}`,
    `Папок: ${folders.length}`,
    `Файлов: ${documents.length}`
  ];

  if (files.length > 0) {
    lines.push("Структура:");

    nexusFileBuildTree(files)
      .slice(0, 30)
      .forEach((node) => {
        lines.push(
          `- ${
            node.kind === "folder"
              ? "Папка"
              : "Файл"
          }: ${node.name}`
        );
      });
  }

  return lines.join("\n");
};

