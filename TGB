const nexusSearchChatIndex = (
  chats: NexusChat[]
): NexusSearchIndex[] => {
  const result: NexusSearchIndex[] = [];

  for (const chat of chats) {
    result.push({
      id: nexusId(),
      entity: "chat",
      entityId: chat.id,
      title: chat.title,
      content:
        chat.messages
          .map(
            (message) =>
              message.content
          )
          .join(" "),
      keywords:
        nexusSearchKeywords(
          chat.title
        ),
      createdAt:
        chat.createdAt
    });

    for (const message of chat.messages) {
      result.push({
        id: nexusId(),
        entity: "message",
        entityId: message.id,
        title:
          message.role,
        content:
          message.content,
        keywords:
          nexusSearchKeywords(
            message.content
          ),
        createdAt:
          message.createdAt
      });
    }
  }

  return result;
};

