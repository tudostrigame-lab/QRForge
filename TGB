type NexusBackupVersion = "1.0";

type NexusBackupData = {
  chats: NexusChat[];
  memory: NexusMemoryItem[];
  notes: NexusNote[];
  tasks: NexusTask[];
  events: NexusCalendarEvent[];
  timers: NexusTimer[];
  files: NexusFile[];
  settings?: Partial<NexusUserSettings>;
};

type NexusBackup = {
  version: NexusBackupVersion;
  app: "NEXUS";
  createdAt: number;
  data: NexusBackupData;
};

type NexusBackupResult = {
  success: boolean;
  message: string;
  backup?: NexusBackup;
};

const NEXUS_BACKUP_VERSION: NexusBackupVersion = "1.0";

const nexusCreateBackup = (
  data: NexusBackupData
): NexusBackup => ({
  version: NEXUS_BACKUP_VERSION,
  app: "NEXUS",
  createdAt: Date.now(),
  data: {
    chats: Array.isArray(data.chats)
      ? [...data.chats]
      : [],
    memory: Array.isArray(data.memory)
      ? [...data.memory]
      : [],
    notes: Array.isArray(data.notes)
      ? [...data.notes]
      : [],
    tasks: Array.isArray(data.tasks)
      ? [...data.tasks]
      : [],
    events: Array.isArray(data.events)
      ? [...data.events]
      : [],
    timers: Array.isArray(data.timers)
      ? [...data.timers]
      : [],
    files: Array.isArray(data.files)
      ? [...data.files]
      : [],
    settings: data.settings
      ? { ...data.settings }
      : undefined,
  },
});

const nexusSerializeBackup = (
  backup: NexusBackup
): string =>
  JSON.stringify(backup, null, 2);

const nexusValidateBackupStructure = (
  value: unknown
): value is NexusBackup => {
  if (!value || typeof value !== "object") {
    return false;
  }

  const backup = value as Partial<NexusBackup>;

  if (backup.app !== "NEXUS") {
    return false;
  }

  if (backup.version !== NEXUS_BACKUP_VERSION) {
    return false;
  }

  if (
    !backup.data ||
    typeof backup.data !== "object"
  ) {
    return false;
  }

  const data = backup.data as Partial<NexusBackupData>;

  return (
    Array.isArray(data.chats) &&
    Array.isArray(data.memory) &&
    Array.isArray(data.notes) &&
    Array.isArray(data.tasks) &&
    Array.isArray(data.events) &&
    Array.isArray(data.timers) &&
    Array.isArray(data.files)
  );
};

const nexusParseBackup = (
  raw: string
): NexusBackupResult => {
  try {
    const parsed: unknown = JSON.parse(raw);

    if (!nexusValidateBackupStructure(parsed)) {
      return {
        success: false,
        message:
          "Файл резервной копии NEXUS имеет неверную структуру.",
      };
    }

    return {
      success: true,
      message:
        "Резервная копия NEXUS успешно прочитана.",
      backup: parsed,
    };
  } catch {
    return {
      success: false,
      message:
        "Не удалось прочитать резервную копию. Проверьте JSON-файл.",
    };
  }
};

const nexusPrepareImportedData = (
  backup: NexusBackup
): NexusBackupData => {
  const repaired = nexusRepairState({
    chats: backup.data.chats,
    memory: backup.data.memory,
    notes: backup.data.notes,
    tasks: backup.data.tasks,
    events: backup.data.events,
    timers: backup.data.timers,
    files: backup.data.files,
  });

  return {
    chats: repaired.chats,
    memory: repaired.memory,
    notes: repaired.notes,
    tasks: repaired.tasks,
    events: repaired.events,
    timers: repaired.timers,
    files: repaired.files,
    settings: backup.data.settings
      ? { ...backup.data.settings }
      : undefined,
  };
};

const nexusDownloadBackup = (
  backup: NexusBackup,
  fileName = "nexus-backup.json"
): boolean => {
  if (typeof window === "undefined") {
    return false;
  }

  try {
    const json = nexusSerializeBackup(backup);
    const blob = new Blob([json], {
      type: "application/json",
    });

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    anchor.href = url;
    anchor.download = fileName;
    anchor.style.display = "none";

    document.body.appendChild(anchor);
    anchor.click();
    document.body.removeChild(anchor);

    setTimeout(() => {
      URL.revokeObjectURL(url);
    }, 1000);

    return true;
  } catch {
    return false;
  }
};

const nexusCreateBackupFileName = () => {
  const date = new Date();

  const year = date.getFullYear();
  const month = String(
    date.getMonth() + 1
  ).padStart(2, "0");
  const day = String(
    date.getDate()
  ).padStart(2, "0");

  const hours = String(
    date.getHours()
  ).padStart(2, "0");
  const minutes = String(
    date.getMinutes()
  ).padStart(2, "0");

  return `nexus-backup-${year}-${month}-${day}-${hours}-${minutes}.json`;
};

const nexusExportData = (
  data: NexusBackupData
): NexusBackupResult => {
  try {
    const backup = nexusCreateBackup(data);

    const downloaded = nexusDownloadBackup(
      backup,
      nexusCreateBackupFileName()
    );

    if (!downloaded) {
      return {
        success: false,
        message:
          "Не удалось создать файл резервной копии.",
      };
    }

    return {
      success: true,
      message:
        "Резервная копия NEXUS сохранена.",
      backup,
    };
  } catch {
    return {
      success: false,
      message:
        "Произошла ошибка при создании резервной копии.",
    };
  }
};

const nexusImportFromFile = (
  file: File
): Promise<NexusBackupResult> =>
  new Promise((resolve) => {
    const reader = new FileReader();

    reader.onload = () => {
      const raw = String(
        reader.result ?? ""
      );

      resolve(nexusParseBackup(raw));
    };

    reader.onerror = () => {
      resolve({
        success: false,
        message:
          "Не удалось прочитать выбранный файл.",
      });
    };

    reader.readAsText(file);
  });

const nexusImportData = (
  raw: string
): NexusBackupResult => {
  const parsed = nexusParseBackup(raw);

  if (!parsed.success || !parsed.backup) {
    return parsed;
  }

  const prepared =
    nexusPrepareImportedData(
      parsed.backup
    );

  const validation =
    nexusValidateCompleteState({
      chats: prepared.chats,
      memory: prepared.memory,
      notes: prepared.notes,
      tasks: prepared.tasks,
      events: prepared.events,
      timers: prepared.timers,
      files: prepared.files,
      settings: prepared.settings,
    });

  if (!validation.valid) {
    return {
      success: false,
      message:
        "Импорт остановлен: данные резервной копии содержат критические ошибки.",
    };
  }

  return {
    success: true,
    message:
      "Данные NEXUS готовы к импорту.",
    backup: {
      ...parsed.backup,
      data: prepared,
    },
  };
};

const nexusMergeBackups = (
  current: NexusBackupData,
  imported: NexusBackupData
): NexusBackupData => {
  const mergeById = <T extends { id: string }>(
    first: T[],
    second: T[]
  ): T[] => {
    const result = new Map<string, T>();

    for (const item of first) {
      result.set(item.id, item);
    }

    for (const item of second) {
      if (!result.has(item.id)) {
        result.set(item.id, item);
      }
    }

    return Array.from(result.values());
  };

  return {
    chats: mergeById(
      current.chats,
      imported.chats
    ),
    memory: mergeById(
      current.memory,
      imported.memory
    ),
    notes: mergeById(
      current.notes,
      imported.notes
    ),
    tasks: mergeById(
      current.tasks,
      imported.tasks
    ),
    events: mergeById(
      current.events,
      imported.events
    ),
    timers: mergeById(
      current.timers,
      imported.timers
    ),
    files: mergeById(
      current.files,
      imported.files
    ),
    settings: {
      ...(current.settings ?? {}),
      ...(imported.settings ?? {}),
    },
  };
};

const nexusGetBackupStatistics = (
  backup: NexusBackup
) => {
  const data = backup.data;

  return {
    chats: data.chats.length,
    messages: data.chats.reduce(
      (sum, chat) =>
        sum +
        (Array.isArray(chat.messages)
          ? chat.messages.length
          : 0),
      0
    ),
    memories: data.memory.length,
    notes: data.notes.length,
    tasks: data.tasks.length,
    events: data.events.length,
    timers: data.timers.length,
    files: data.files.length,
    createdAt: backup.createdAt,
  };
};

const nexusAutoBackupKey =
  "nexus_auto_backup_v1";

const nexusStoreAutoBackup = (
  data: NexusBackupData
): boolean => {
  if (typeof window === "undefined") {
    return false;
  }

  try {
    const backup =
      nexusCreateBackup(data);

    localStorage.setItem(
      nexusAutoBackupKey,
      nexusSerializeBackup(backup)
    );

    return true;
  } catch {
    return false;
  }
};

const nexusLoadAutoBackup = ():
  NexusBackup | null => {
  if (typeof window === "undefined") {
    return null;
  }

  try {
    const raw = localStorage.getItem(
      nexusAutoBackupKey
    );

    if (!raw) {
      return null;
    }

    const result =
      nexusParseBackup(raw);

    return result.success
      ? result.backup ?? null
      : null;
  } catch {
    return null;
  }
};

const nexusDeleteAutoBackup = (): boolean => {
  if (typeof window === "undefined") {
    return false;
  }

  try {
    localStorage.removeItem(
      nexusAutoBackupKey
    );

    return true;
  } catch {
    return false;
  }
};

const nexusBackupEngine = {
  create: nexusCreateBackup,
  serialize: nexusSerializeBackup,
  parse: nexusParseBackup,
  prepareImport:
    nexusPrepareImportedData,
  importFile:
    nexusImportFromFile,
  importData:
    nexusImportData,
  exportData:
