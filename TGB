};

const nexusStyleWords = (
  text: string
): string[] => {
  return text
    .trim()
    .split(/\s+/)
    .filter(Boolean);
};

const nexusStyleAverage = (
  values: number[]
): number => {
  if (values.length === 0) {
    return 0;
  }

  return (
    values.reduce(
      (sum, value) =>
        sum + value,
      0
    ) / values.length
  );
};

const nexusStyleRatio = (
  conditionValues: boolean[]
): number => {
  if (
    conditionValues.length === 0
  ) {
    return 0;
  }

  return (
    conditionValues.filter(
      Boolean
    ).length /
    conditionValues.length
  );
};

const nexusAnalyzeUserMessages = (
  messages: NexusMessage[]
): NexusUserStyleProfile => {
  const userMessages =
    messages.filter(
      (message) =>
        message.role === "user"
    );

  if (
    userMessages.length === 0
  ) {
    return {
      messageCount: 0,
      averageMessageLength: 0,
      averageWordCount: 0,
      shortMessageRatio: 0,
      longMessageRatio: 0,
      questionRatio: 0,
      commandRatio: 0,
      emojiRatio: 0,
      punctuationRatio: 0,
      preferredResponseLength:
        "medium",
      preferredTone:
        "casual",
      language:
        "unknown",
      updatedAt: Date.now()
    };
  }

  const lengths =
    userMessages.map(
      (message) =>
        message.content.length
    );

  const wordCounts =
    userMessages.map(
      (message) =>
        nexusStyleWords(
          message.content
        ).length
    );

  const shortMessages =
    userMessages.map(
      (message) =>
        message.content.length <= 60
    );

  const longMessages =
    userMessages.map(
      (message) =>
        message.content.length >= 250
    );

  const questions =
    userMessages.map(
      (message) =>
        message.content.includes("?") ||
        message.content.includes("？")
    );

  const commands =
    userMessages.map(
      (message) => {
        const text =
          message.content
            .trim()
            .toLowerCase();

        return (
          text.startsWith(
            "дай"
          ) ||
          text.startsWith(
            "сделай"
          ) ||
          text.startsWith(
            "напиши"
          ) ||
          text.startsWith(
            "покажи"
          ) ||
          text.startsWith(
            "давай"
          ) ||
          text.startsWith(
            "send"
          ) ||
          text.startsWith(
            "give"
          ) ||
          text.startsWith(
            "show"
          )
        );
      }
    );

  const emojis =
    userMessages.map(
      (message) =>
        /[\u{1F300}-\u{1FAFF}]/u.test(
          message.content
        )
    );

  const punctuation =
    userMessages.map(
      (message) =>
        /[!?.,:;]/.test(
          message.content
        )
    );

  const averageLength =
    nexusStyleAverage(
      lengths
    );

  const averageWords =
    nexusStyleAverage(
      wordCounts
    );

  let preferredResponseLength:
    | "short"
    | "medium"
    | "long" =
    "medium";

  if (
    averageLength < 100
  ) {
    preferredResponseLength =
      "short";
  } else if (
    averageLength > 300
  ) {
    preferredResponseLength =
      "long";
  }

  const detectedLanguage =
    nexusDetectStyleLanguage(
      userMessages.map(
        (message) =>
          message.content
      )
    );

  return {
    messageCount:
      userMessages.length,

    averageMessageLength:
      Math.round(
        averageLength
      ),

    averageWordCount:
      Math.round(
        averageWords
      ),

    shortMessageRatio:
      nexusStyleRatio(
        shortMessages
      ),

    longMessageRatio:
      nexusStyleRatio(
        longMessages
      ),

    questionRatio:
      nexusStyleRatio(
        questions
      ),

    commandRatio:
      nexusStyleRatio(
        commands
      ),

    emojiRatio:
      nexusStyleRatio(
        emojis
      ),

    punctuationRatio:
      nexusStyleRatio(
        punctuation
      ),

    preferredResponseLength,

    preferredTone:
      "casual",

    language:
      detectedLanguage,

    updatedAt:
      Date.now()
  };
};

const nexusDetectStyleLanguage = (
  messages: string[]
):
  | "ru"
  | "en"
  | "es"
  | "fr"
  | "ja"
  | "unknown" => {
  const text =
    messages
      .join(" ")
      .toLowerCase();

  const russian =
    (text.match(
      /[а-яё]/g
    ) ?? []).length;

  const latin =
    (text.match(
      /[a-z]/g
    ) ?? []).length;

  const japanese =
    (text.match(
      /[\u3040-\u30ff\u4e00-\u9faf]/g
    ) ?? []).length;

  if (
    japanese >
    Math.max(
      russian,
      latin
    )
  ) {
    return "ja";
  }

  const spanish =
    (
      text.match(
        /\b(el|la|los|las|que|como|para|una|uno|hola)\b/g
      ) ?? []
    ).length;

  const french =
    (
      text.match(
        /\b(le|la|les|des|une|que|pour|bonjour)\b/g
      ) ?? []
    ).length;

  if (
    spanish > 2 &&
    spanish > french
  ) {
    return "es";
  }

  if (
    french > 2 &&
    french > spanish
  ) {
    return "fr";
  }

  if (
    russian > latin
  ) {
    return "ru";
  }

  if (
    latin > 0
  ) {
    return "en";
  }

  return "unknown";
};

