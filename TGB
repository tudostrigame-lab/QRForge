    2
  );
};

const nexusSettingsImport = (
  raw: string
): NexusUserSettings | null => {
  try {
    const parsed = JSON.parse(raw);

    if (
      !parsed ||
      typeof parsed !== "object" ||
      !parsed.settings
    ) {
      return null;
    }

    return nexusSettingsMerge(
      NEXUS_DEFAULT_USER_SETTINGS,
      parsed.settings
    );
  } catch {
    return null;
  }
};

