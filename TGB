    },
    {
      id: "tasks" as NexusSection,
      title: "Задачи",
      icon: "✓",
    },
    {
      id: "calendar" as NexusSection,
      title: "Календарь",
      icon: "📅",
    },
    {
      id: "clock" as NexusSection,
      title: "Часы",
      icon: "🕐",
    },
    {
