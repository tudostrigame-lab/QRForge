function nexusCalculateMemoryScore(
  item: NexusMemoryItem,
  queryWords: string[]
): number {
  const text =
    nexusMemoryKey(
      item.text
    );

  if (!text) {
    return 0;
  }

  let score = 0;

  for (const word of queryWords) {
    if (!word) {
      continue;
    }

    if (text === word) {
      score += 10;
      continue;
    }

    if (
      text.includes(word)
    ) {
      score += 3;
    }
  }

  if (
    queryWords.length > 0 &&
    queryWords.every(
      (word) =>
        text.includes(word)
    )
  ) {
    score += 5;
  }

  return score;
}

function nexusSearchMemorySmart(
  memory: NexusMemoryItem[],
  query: string
): NexusMemorySearchResult[] {
  const normalized =
    nexusMemoryKey(query);

  if (!normalized) {
    return [];
  }

  const words =
    normalized
      .split(" ")
      .filter(
        (word) =>
          word.length >= 2
      );

  return memory
    .map((item) => ({
      item,
      score:
        nexusCalculateMemoryScore(
          item,
          words
        ),
    }))
    .filter(
      (result) =>
        result.score > 0
    )
    .sort(
      (a, b) =>
        b.score - a.score
    );
}

