/* -------------------------
   GLOBAL SEARCH
   ------------------------- */

const nexusGlobalSearch = (
  index: NexusSearchIndex,
  query: string,
  options: NexusSearchOptions = {}
): NexusSearchResult[] => {
  const normalized =
    nexusSearchNormalize(query);

  if (!normalized) {
    return [];
  }

  const allowedTypes =
    options.types ||
    [
      "chat",
      "message",
      "memory",
      "note",
      "task",
      "event",
      "timer",
      "alarm",
      "file"
    ];

  const limit = Math.min(
    options.limit ||
      NEXUS_SEARCH_MAX_RESULTS,
    NEXUS_SEARCH_MAX_RESULTS
  );

  const minimumScore =
    options.minimumScore ?? 0.2;

  const results: NexusSearchResult[] = [];

  if (allowedTypes.includes("chat")) {
    results.push(
      ...nexusSearchChats(
        index.chats,
        normalized
      )
    );
  }

  if (allowedTypes.includes("memory")) {
    results.push(
      ...nexusSearchMemory(
        index.memory,
        normalized
      )
    );
  }

  if (allowedTypes.includes("note")) {
    results.push(
      ...nexusSearchNotes(
        index.notes,
        normalized
      )
    );
  }

  if (allowedTypes.includes("task")) {
    results.push(
      ...nexusSearchTasks(
        index.tasks,
        normalized
      )
    );
  }

  if (allowedTypes.includes("event")) {
    results.push(
      ...nexusSearchEvents(
        index.events,
        normalized
      )
    );
  }

  if (allowedTypes.includes("timer")) {
    results.push(
      ...nexusSearchTimers(
        index.timers,
        normalized
      )
    );
  }

  if (
    allowedTypes.includes("alarm") &&
    index.alarms
  ) {
    results.push(
      ...nexusSearchAlarms(
        index.alarms,
        normalized
      )
    );
  }

  if (allowedTypes.includes("file")) {
    results.push(
      ...nexusSearchFiles(
        index.files,
        normalized
      )
    );
  }

  return results
    .filter(
      (result) =>
        result.score >= minimumScore
    )
    .sort((a, b) => {
      if (b.score !== a.score) {
        return b.score - a.score;
      }

      return (
        (b.timestamp || 0) -
        (a.timestamp || 0)
      );
    })
    .slice(0, limit);
};

/* -------------------------
   GROUPING
   ------------------------- */

const nexusSearchGroupResults = (
  results: NexusSearchResult[]
): Record<
  NexusSearchEntityType,
  NexusSearchResult[]
> => {
  const groups =
    {} as Record<
      NexusSearchEntityType,
      NexusSearchResult[]
    >;

  for (const result of results) {
    if (!groups[result.type]) {
      groups[result.type] = [];
    }

    groups[result.type].push(result);
  }

  return groups;
};

const nexusSearchBestResult = (
  results: NexusSearchResult[]
): NexusSearchResult | null => {
  return results.length > 0
    ? results[0]
    : null;
};

/* -------------------------
   SEARCH SUMMARY FOR AI
   ------------------------- */

const nexusSearchBuildAISummary = (
  results: NexusSearchResult[]
): string => {
  if (results.length === 0) {
    return "Поиск не дал результатов.";
  }

  return results
    .slice(0, 15)
    .map(
      (result, index) =>
        `${index + 1}. [${result.type}] ${
          result.title
        }: ${result.text.slice(0, 240)}`
    )
    .join("\n");
};

