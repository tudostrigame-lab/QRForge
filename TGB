const NEXUS_PRODUCTIVITY_EVENTS: NexusProductivityEvent[] = [];

const nexusProductivityRecord = (
  operation: NexusProductivityOperation,
  entityId: string,
  data?: Record<string, unknown>
) => {
  const event: NexusProductivityEvent = {
    id: nexusId(),
    operation,
    entityId,
    timestamp: Date.now(),
    data
  };

  NEXUS_PRODUCTIVITY_EVENTS.push(event);

  if (NEXUS_PRODUCTIVITY_EVENTS.length > 500) {
    NEXUS_PRODUCTIVITY_EVENTS.shift();
  }

  return event;
};

