type NexusSearchEntity =
  | "chat"
  | "message"
  | "memory"
  | "note"
  | "task"
  | "calendar"
  | "timer"
  | "file";

type NexusSearchResult = {
  id: string;
  entity: NexusSearchEntity;
  entityId: string;
  title: string;
  content: string;
  score: number;
  createdAt?: number;
  updatedAt?: number;
};

type NexusSearchIndex = {
  id: string;
  entity: NexusSearchEntity;
  entityId: string;
  title: string;
  content: string;
  keywords: string[];
  createdAt?: number;
  updatedAt?: number;
};

const nexusSearchNormalize = (
  text: string
): string => {
  return text
    .toLowerCase()
    .replace(/[.,!?;:()[\]{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
};

const nexusSearchWords = (
  text: string
): string[] => {
  return nexusSearchNormalize(text)
    .split(" ")
    .filter(Boolean);
};

const nexusSearchKeywords = (
  text: string
): string[] => {
  return Array.from(
    new Set(
      nexusSearchWords(text)
    )
  );
};

const nexusSearchScore = (
  query: string,
  text: string
): number => {
  const queryWords =
    nexusSearchWords(query);

  const textWords =
    nexusSearchWords(text);

  let score = 0;

  for (const word of queryWords) {
    if (text.includes(word)) {
      score += 10;
    }

    const count =
      textWords.filter(
        (item) => item === word
      ).length;

    score += count * 2;
  }

  return score;
};

