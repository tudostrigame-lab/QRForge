};

const nexusAnalyticsLoad =
  (): NexusAnalyticsEvent[] => {
    if (
      typeof window === "undefined"
    ) {
      return [];
    }

    try {
      const raw =
        localStorage.getItem(
          nexusAnalyticsStorageKey
        );

      if (!raw) {
        return [];
      }

      const parsed: unknown =
        JSON.parse(raw);

      if (!Array.isArray(parsed)) {
        return [];
      }

      return parsed.filter(
        (item): item is NexusAnalyticsEvent =>
          Boolean(
            item &&
              typeof item === "object" &&
              typeof item.id === "string" &&
              typeof item.action === "string" &&
              typeof item.timestamp === "number"
          )
      );
    } catch {
      return [];
    }
  };

const nexusAnalyticsClear = (): boolean => {
  if (
    typeof window === "undefined"
  ) {
    return false;
  }

  try {
    localStorage.removeItem(
      nexusAnalyticsStorageKey
    );

    return true;
  } catch {
    return false;
  }
};

