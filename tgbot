    const duplicate =
      memory.some(
        item =>
          item.text
            .trim()
            .toLowerCase() ===
          clean
            .toLowerCase()
      );

    if (
      duplicate
    ) {
      return;
    }

    const item: MemoryItem = {
      id: createId(),
      text: clean,
      category,
      createdAt:
        Date.now(),
    };

    setMemory(
      current => [
        item,
        ...current,
      ]
    );
  };


