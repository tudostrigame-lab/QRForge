    try {

      await navigator.clipboard.writeText(
        text
      );

    } catch {

      /*
        Fallback для браузеров,
        где Clipboard API недоступен.
      */

      try {

        const textarea =
          document.createElement(
            "textarea"
          );

        textarea.value =
          text;

        textarea.style.position =
          "fixed";

        textarea.style.opacity =
          "0";

        document.body.appendChild(
          textarea
        );

        textarea.select();

        document.execCommand(
          "copy"
        );

        textarea.remove();

      } catch {
        // Copy unavailable
      }
    }
  };


