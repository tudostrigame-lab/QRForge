                className="nexus-input-area"
              >

                <div
                  className="nexus-input-wrapper"
                >

                  <textarea
                    ref={
                      inputRef
                    }
                    className="nexus-input"
                    value={
                      input
                    }
                    onChange={
                      event =>
                        setInput(
                          event.target.value
                        )
                    }
                    onKeyDown={
                      handleInputKeyDown
                    }
                    placeholder="Напиши сообщение NEXUS..."
                    rows={1}
                    disabled={
                      thinking
                    }
                  />


                  <button
                    type="button"
                    className="nexus-send"
                    disabled={
                      !input.trim() ||
                      thinking
                    }
                    onClick={() =>
                      void sendMessageWithCommands()
                    }
                    aria-label="Отправить"
                  >
                    ↑
                  </button>

                </div>


                <div
                  className="nexus-input-hint"
                >
                  Enter — отправить ·
                  Shift + Enter — новая строка
                </div>

              </div>

            </div>

          )}


          {section !==
            "chat" && (

            <div
              className="nexus-section"
            >

              <div
                className="nexus-section-inner"
              >

                <div
                  className="nexus-section-heading"
                >

                  <h1>
                    {
                      sectionTitle
                    }
                  </h1>

                  <p>
                    {
                      sectionDescription
                    }
                  </p>

                </div>


                <div
                  style={{
                    border:
                      "1px dashed " +
                      (
                        darkMode
                          ? "#303238"
                          : "#d9dce1"
                      ),
                    borderRadius:
                      "16px",
                    minHeight:
                      "300px",
                    display:
                      "flex",
                    alignItems:
                      "center",
                    justifyContent:
                      "center",
                    textAlign:
                      "center",
                    color:
                      "#8b9098",
                    padding:
                      "30px",
                  }}
                >

                  Интерфейс раздела
                  <br />
                  будет добавлен
                  следующими частями NEXUS.

                </div>

              </div>

            </div>

          )}

        </div>

      </section>

    </main>
  );
}
