  const processSpecialCommand = (
    message: string
  ): boolean => {

    const clean =
      message.trim();

    const lower =
      clean.toLowerCase();


    /* -----------------------------------------
       "Запомни ..."
       ----------------------------------------- */

    if (
      lower.startsWith(
        "запомни "
      )
    ) {

      const value =
        clean
          .slice(
            "запомни ".length
          )
          .trim();

      if (
        value
      ) {

        remember(
          value,
          "important"
        );

        return true;
      }
    }


    /* -----------------------------------------
       "Забудь ..."
       ----------------------------------------- */

    if (
      lower.startsWith(
        "забудь "
      )
    ) {

      const value =
        clean
          .slice(
            "забудь ".length
          )
          .trim()
          .toLowerCase();

      const found =
        memory.find(
          item =>
            item.text
              .toLowerCase()
              .includes(
                value
              )
        );

      if (
        found
      ) {

        forgetMemory(
          found.id
        );
      }

      return true;
    }


    return false;
  };


